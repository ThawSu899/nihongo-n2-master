# Server port configuration (Optional, default is 3000)
PORT=3000

# APP_URL: The optional base URL where this app is hosted (e.g., local development or production)
APP_URL="http://localhost:3000"

# ==============================================================================
# Google Identity Services (GIS) OAuth 2.0 Client Configuration
# ==============================================================================
# Used for Google Drive cloud backup, Google Sheets curriculum sync, and Calendar study blocks.
#
# SETUP INSTRUCTIONS:
# 1. Open Google Cloud Console: https://console.cloud.google.com/apis/credentials
# 2. Create or select a project (e.g. "Nihongo-N2-Master").
# 3. Create an OAuth 2.0 Client ID with Application type "Web application".
# 4. Add Authorized JavaScript origins:
#    - http://localhost:3000
#    - http://localhost:5173
#    - https://nihongo-n2-master-rewv.vercel.app
# 5. Enable the following Google APIs in API Library:
#    - Google Drive API (scope: https://www.googleapis.com/auth/drive.file)
#    - Google Sheets API (scope: https://www.googleapis.com/auth/spreadsheets)
#    - Google Calendar API (scope: https://www.googleapis.com/auth/calendar.events)
# 6. Paste your Web Client ID below (Public client ID; NO client secret needed for browser GIS):
VITE_GOOGLE_CLIENT_ID="125414361236-lfa86bkpp0smnf3827r87c2a0pm3lsvb.apps.googleusercontent.com"
