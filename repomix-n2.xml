  "grammars": [
    {
      "id": "n2.l07.g001",
      "lessonId": "n2.l07",
      "pattern": "〜てたまらない",
      "meaning": "Extremely / Dying to / Can't bear it (overwhelming sensation or emotion)",
      "formation": "動詞（て形） / い形容詞（〜くて） / な形容詞（〜で） ＋ たまらない",
      "explanation": {
        "en": "Expresses an uncontrollable physical sensation, personal desire, or emotion that is nearly unbearable ('extremely', 'dying to'). Used for primal bodily states or intense personal wishes.",
        "my": "ရုပ်ပိုင်းဆိုင်ရာ ခံစားချက် သို့မဟုတ် စိတ်ခံစားမှု ပြင်းထန်လွန်း၍ မခံမရပ်နိုင်အောင် ဖြစ်ရခြင်းကို ဖော်ပြသည်။ (ဥပမာ - ရေဆာလွန်း၍ မခံနိုင်၊ နာလွန်း၍ မခံနိုင်၊ တွေ့ချင်လွန်း၍ မနေနိုင်)။"
      },
      "examples": [
        {
          "sentenceId": "n2.l07.s007",
          "note": "Overwhelming physical impulse or acute sensation"
        },
        {
          "sentenceId": "n2.l07.s012",
          "note": "Irresistible intense personal craving or thirst"
        }
      ],
      "similarGrammarIds": [
        "n2.l07.g002",
        "n2.l07.g003"
      ],
      "commonMistakes": [
        "Do not use with abstract intellectual judgments; 〜てたまらない is strongly linked to bodily sensations or visceral emotions."
      ],
      "difficulty": 4,
      "level": "N2",
      "prov": {
        "source": "Nihongo N2 Master Editorial Team",
        "license": "CC-BY-4.0",
        "status": "native_verified",
        "updatedAt": "2026-10-19T18:00:00Z",
