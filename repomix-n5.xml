  "grammars": [
    {
      "id": "n5.l28.g001",
      "lessonId": "n5.l28",
      "pattern": "[V-ta] ほうがいいです / [V-nai] ほうがいいです",
      "meaning": "It is better to [V] / You should [V] (Giving advice)",
      "formation": "Verb (た-form) + ほうがいいです / Verb (ない-form) + ほうがいいです",
      "explanation": {
        "en": "Used when giving specific advice or recommendations to someone. Affirmative advice uses the past plain form (た-form): 病院へ行ったほうがいいです (You had better go to the hospital). Negative advice uses the negative plain form (ない-form): お酒を飲まないほうがいいです (You had better not drink alcohol).",
        "my": "တစ်ဖက်သားအား အကြံဉာဏ်ပေးရာတွင် 「ကြိယာ た-form + ほうがいいです」 (...လုပ်တာ ပိုကောင်းပါတယ်) နှင့် 「ကြိယာ ない-form + ほうがいいです」 (...မလုပ်တာ ပိုကောင်းပါတယ်) ဟု သုံးသည်။"
      },
      "examples": [
        {
          "sentenceId": "n5.l28.s005",
          "note": "Affirmative advice"
        },
        {
          "sentenceId": "n5.l28.s006",
          "note": "Negative advice"
        }
      ],
      "similarGrammarIds": [],
      "commonMistakes": [
        "For affirmative advice, use た-form (行ったほうがいい), NOT dictionary form (*行くほうがいい is less natural for specific personal advice). For negative advice, use ない-form (行かないほうがいい), NOT *行かなかったほうがいい."
      ],
      "difficulty": 1,
      "level": "N5",
      "prov": {
        "source": "Nihongo N2 Master Editorial Team (Native Review)",
        "license": "CC-BY-4.0",
        "status": "reviewed",
        "updatedAt": "2026-10-01T00:00:00Z",
