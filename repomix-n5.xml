  "grammars": [
    {
      "id": "n5.l21.g001",
      "lessonId": "n5.l21",
      "pattern": "い-adj (〜く) / な-adj・Noun (〜に) + なります",
      "meaning": "To become [adjective / noun]",
      "formation": "い-adj (-い → -く) + なります / な-adj + に + なります / Noun + に + なります",
      "explanation": {
        "en": "Indicates a change in state: 寒くなります (becomes cold), 元気になります (becomes healthy), 先生になります (becomes a teacher).",
        "my": "အခြေအနေပြောင်းလဲမှုကို ဖော်ပြရာတွင် い-နာမဝိသေသနနောက်တွင် 「〜くなります」、な-နာမဝိသေသနနှင့် နာမ်နောက်တွင် 「〜になります」 (...ဖြစ်လာသည်/ဖြစ်သွားသည်) ဟု သုံးသည်။"
      },
      "examples": [
        {
          "sentenceId": "n5.l21.s001",
          "note": "With い-adjective"
        },
        {
          "sentenceId": "n5.l21.s003",
          "note": "With な-adjective"
        }
      ],
      "similarGrammarIds": [],
      "commonMistakes": [
        "Do not say *寒いになります (drop the -い and add -く before なります). For な-adjectives do not forget に (*元気なります is wrong)."
      ],
      "difficulty": 1,
      "level": "N5",
      "prov": {
        "source": "Nihongo N2 Master Editorial Team (Native Review)",
        "license": "CC-BY-4.0",
        "status": "reviewed",
        "updatedAt": "2026-10-01T00:00:00Z",
        "rev": 2
      },
      "explanationMy": "အခြေအနေပြောင်းလဲမှုကို ဖော်ပြရာတွင် い-နာမဝိသေသနနောက်တွင် 「〜くなります」、な-နာမဝိသေသနနှင့် နာမ်နောက်တွင် 「〜になります」 (...ဖြစ်လာသည်/ဖြစ်သွားသည်) ဟု သုံးသည်။",
