  "grammars": [
    {
      "id": "n5.l01.g001",
      "lessonId": "n5.l01",
      "pattern": "X は Y です",
      "meaning": "X is Y (Identification / Affirmative sentence)",
      "formation": "[Noun X] は [Noun Y] です",
      "explanation": {
        "en": "The particle は (pronounced \"wa\") marks the topic of the sentence. です acts as the polite copula (\"is / am / are\").",
        "my": "စကားလုံး は (ဝ ဟုအသံထွက်သည်) သည် ဝါကျ၏အဓိကအကြောင်းအရာကိုပြသည်။ です သည် ယဉ်ကျေးသောကြိယာဖြစ်ပြီး \"ဖြစ်သည်\" ဟုအဓိပ္ပာယ်ရသည်။"
      },
      "examples": [
        {
          "sentenceId": "n5.l01.s001",
          "note": "わたしの自己紹介 (Self introduction)"
        },
        {
          "sentenceId": "n5.l01.s002",
          "note": "他者の紹介 (Introducing another person)"
        }
      ],
      "similarGrammarIds": [],
      "commonMistakes": [
        "Writing は as わ (even though pronounced \"wa\", write particle は).",
        "Forgetting です at the end of polite statements."
      ],
      "difficulty": 1,
      "level": "N5",
      "prov": {
        "source": "Nihongo N2 Master Editorial Team",
        "license": "CC-BY-4.0",
        "status": "reviewed",
        "updatedAt": "2026-09-30T10:00:00Z",
        "rev": 1
      },
