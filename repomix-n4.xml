  "grammars": [
    {
      "id": "n4.l15.g001",
      "lessonId": "n4.l15",
      "pattern": "[Humble Verb: 参る・申す・いたす・拝見する・いただく・存じている]",
      "meaning": "Dedicated Humble Verbs (謙譲語: humbling one's own actions or in-group members)",
      "formation": "行く/来る -> 参る (まいる)\n言う -> 申す (もうす) / 申し上げる\nする -> いたす\n見る -> 拝見する (はいけんする)\n食べる/飲む/もらう -> いただく\n知っている -> 存じております / 存じません\n会う -> お目にかかる",
      "explanation": {
        "en": "Humble verbs (謙譲語) lower the speaker's own actions (or the actions of one's company colleagues/family) in order to elevate the status of the person being addressed or the person benefiting from the action.",
