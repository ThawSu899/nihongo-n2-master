  "grammars": [
    {
      "id": "n4.l11.g001",
      "lessonId": "n4.l11",
      "pattern": "[Person A] は [Person B] に [Verb 受身形 (〜られる)]",
      "meaning": "Direct passive (Person A is affected by Person B doing an action)",
      "formation": "Group 1: u -> a + れる (書く -> 書かれる, 褒める -> 褒められる)\nGroup 2: ru -> られる (食べる -> 食べられる, 褒める -> 褒められる)\nGroup 3: 来る -> こられる, する -> される",
      "explanation": {
        "en": "Used when the subject receives an action from someone else. The agent performing the action is marked with に. Often used when the recipient feels pleased, surprised, or troubled by the action.",
        "my": "ပြုလုပ်ခံရသော Passive Form ဖြစ်သည်။ ပြုလုပ်သူကို「に」ဖြင့် ပြပြီး ခံရသူကို「は/が」ဖြင့် ပြသည်။"
      },
      "examples": [
        {
          "sentenceId": "n4.l11.s001",
          "note": "I was praised by the teacher."
        },
        {
          "sentenceId": "n4.l11.s002",
          "note": "Tanaka was scolded by his mother."
        }
      ],
      "similarGrammarIds": [],
      "commonMistakes": [
        "Confusing the agent and receiver markers: the person doing the action takes に, not を.",
        "Group 1 conjugation mistake: 書かれる (correct) vs 書かされる (this is causative-passive, not direct passive)."
      ],
      "level": "N4",
      "difficulty": 2,
      "prov": {
        "source": "Nihongo N2 Master Editorial Team (Native Review)",
        "license": "CC-BY-4.0",
        "status": "reviewed",
        "updatedAt": "2026-10-01T00:00:00Z",
        "rev": 2
      },
