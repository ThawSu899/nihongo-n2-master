  "grammars": [
    {
      "id": "n4.l22.g001",
      "lessonId": "n4.l22",
      "pattern": "[Plain form / Nounの / Na-adjな] + ようだ (推量・状況判断)",
      "meaning": "Sensory / visual deduction (\"It appears / seems based on observation or direct evidence\")",
      "formation": "Verb (Plain form) + ようだ (出かけたようだ, 雨が降っているようだ)\ni-adj (Plain form) + ようだ (忙しいようだ)\nna-adj + な + ようだ (静かなようだ)\nNoun + の + ようだ (留守のようだ, 風邪のようだ)",
      "explanation": {
        "en": "Used when the speaker makes a subjective deduction or judgment based on what they directly see, hear, smell, or feel. Unlike 〜そうだ (stem: おいしそう, instantaneous visual glance), 〜ようだ involves thoughtful reasoning based on clues (e.g. seeing lights off and concluded: 出かけたようだ).",
        "my": "မိမိကိုယ်တိုင် မြင်တွေ့ကြားသိရသော သက်သေအထောက်အထား သို့မဟုတ် အာရုံခံစားမှုပေါ် အခြေခံ၍ \"ဖြစ်ပုံရသည်/ဖြစ်နေပုံပေါ်သည်\" ဟု သုံးသပ်ဆုံးဖြတ်ရာတွင် သုံးသည်။ နာမ်တွင်「の」၊ na-adjective တွင်「な」ထည့်ရသည်။"
      },
      "examples": [
        {
          "sentenceId": "n4.l22.s001",
          "note": "Judging from the quiet house, it seems nobody is home."
        },
        {
          "sentenceId": "n4.l22.s004",
          "note": "Judging by the smell from the kitchen, it seems dinner is ready."
        }
      ],
      "similarGrammarIds": [],
      "commonMistakes": [
        "Nouns must take の (留守のようだ, NOT *留守ようだ).",
        "Na-adjectives must take な (静かなようだ, NOT *静かようだ).",
        "Do not confuse with 〜そうだ (stem: 降りそうだ = about to rain) versus 〜ようだ (降っているようだ = it looks like it is currently raining outside)."
      ],
      "level": "N4",
      "difficulty": 2,
