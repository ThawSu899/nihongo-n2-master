  "grammars": [
    {
      "id": "n4.l27.g001",
      "lessonId": "n4.l27",
      "pattern": "[Verb て-form] + もいい / もかまわない",
      "meaning": "May / Can / It is okay to (Giving and asking permission)",
      "formation": "Verb (て形) + もいいです / もかまいません\nQuestion: 〜てもいいですか / 〜てもかまいませんか",
      "explanation": {
        "en": "Used to ask for or give permission to do something (\"You may do X / Is it alright if I do X?\"). 〜てもかまいません is slightly more formal and means \"I have no objection / it causes no problem.\" In casual conversation, friends drop です: ここに座ってもいい？",
        "my": "ခွင့်ပြုချက်တောင်းခံခြင်း သို့မဟုတ် ခွင့်ပြုပေးခြင်း ပြုလုပ်ရာတွင် သုံးသည်။ ကြိယာ て形 နောက်တွင် 「もいいです / もかまいません」ကို ဆက်သည်။ စကားပြောတွင် 「〜てもいい？」ဟု အလွတ်သဘော သုံးနိုင်သည်။"
      },
      "examples": [
        {
          "sentenceId": "n4.l27.s001",
          "note": "May I take photos in this museum?"
        },
        {
          "sentenceId": "n4.l27.s004",
          "note": "If you have finished your work, you may go home early."
        }
      ],
      "similarGrammarIds": [],
      "commonMistakes": [
        "Do not confuse permission (〜てもいい) with obligation (〜なければならない) or prohibition (〜てはいけない).",
        "When replying affirmatively to permission questions, saying 「どうぞ」 or 「いいですよ」 is more natural than repeating the whole verb phrase."
      ],
