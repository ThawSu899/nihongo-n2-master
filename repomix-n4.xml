  "grammars": [
    {
      "id": "n4.l12.g001",
      "lessonId": "n4.l12",
      "pattern": "[Causer] は [Causee] に [Object] を [Verb 使役形 (〜せる/〜させる)]",
      "meaning": "Transitive Causative (making or letting someone do an action on an object)",
      "formation": "Group 1: u -> a + せる (読む -> 読ませる, 書く -> 書かせる)\nGroup 2: ru -> させる (食べる -> 食べさせる, 調べる -> 調べさせる)\nGroup 3: 来る -> こさせる, する -> させる",
      "explanation": {
        "en": "With transitive verbs (verbs taking を), the person instructed/permitted to do the action (the causee) is marked with に, and the direct object takes を. This avoids two を particles in one clause.",
        "my": "ကံပုဒ် (Object) ပါရှိသော ကံလိုကြိယာများတွင် ပြုလုပ်ခိုင်းခံရသူကို「に」ဖြင့် ပြပြီး ကံပုဒ်ကို「を」ဖြင့် ပြသည်။"
      },
      "examples": [
        {
          "sentenceId": "n4.l12.s001",
          "note": "The teacher made the students write an essay."
        },
        {
          "sentenceId": "n4.l12.s003",
          "note": "The supervisor had Tanaka carry the heavy luggage."
        }
      ],
      "similarGrammarIds": [],
      "commonMistakes": [
        "Do not use double を (*先生は学生を作文を書かせた is incorrect; use 学生に).",
        "Remember that Group 1 verbs change to a-row: 読ませる, NOT 読まさせる."
      ],
      "level": "N4",
      "difficulty": 2,
      "prov": {
        "source": "Nihongo N2 Master Editorial Team (Native Review)",
        "license": "CC-BY-4.0",
        "status": "reviewed",
        "updatedAt": "2026-10-01T00:00:00Z",
        "rev": 2
      },
      "explanationMy": "ကံပုဒ် (Object) ပါရှိသော ကံလိုကြိယာများတွင် ပြုလုပ်ခိုင်းခံရသူကို「に」ဖြင့် ပြပြီး ကံပုဒ်ကို「を」ဖြင့် ပြသည်။",
      "meaningMyanmar": "ကံပုဒ် (Object) ပါရှိသော ကံလိုကြိယာများတွင် ပြုလုပ်ခိုင်းခံရသူကို「に」ဖြင့် ပြပြီး ကံပုဒ်ကို「を」ဖြင့် ပြသည်။",
      "meaningMy": "ကံပုဒ် (Object) ပါရှိသော ကံလိုကြိယာများတွင် ပြုလုပ်ခိုင်းခံရသူကို「に」ဖြင့် ပြပြီး ကံပုဒ်ကို「を」ဖြင့် ပြသည်။",
      "nuanceExplanationMy": "[Causer] は [Causee] に [Object] を [Verb 使役形 (〜せる/〜させる)] ၏ သဒ္ဒါအသုံးအနှုန်းနှင့် သတိပြုရမည့် အချက်များ။"
