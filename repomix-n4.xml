  "grammars": [
    {
      "id": "n4.l19.g001",
      "lessonId": "n4.l19",
      "pattern": "[Verb Dictionary form (Potential / Intransitive)] + ようになる",
      "meaning": "Come to be able to / Reach a state where one does (gradual change over time)",
      "formation": "Verb (Potential form) + ようになる (話せるようになる, 泳げるようになる)\nVerb (Dictionary form) + ようになる (食べるようになる, 気をつけるようになる)",
      "explanation": {
        "en": "Indicates a change in state or ability over a period of time, transitioning from a state where something was not possible/done to a state where it is now possible or habitual.",
        "my": "ယခင်က မလုပ်နိုင်ခဲ့သောအရာ သို့မဟုတ် မလုပ်ဖြစ်ခဲ့သောအရာကို အချိန်ကြာလာသည်နှင့်အမျှ \"လုပ်နိုင်လာသည်/လုပ်ဖြစ်လာသည်\" ဟူသော အခြေအနေပြောင်းလဲမှုကို ဖော်ပြသည်။"
      },
      "examples": [
        {
          "sentenceId": "n4.l19.s001",
          "note": "I have become able to speak Japanese naturally."
        },
        {
          "sentenceId": "n4.l19.s006",
          "note": "Living in Japan, I have come to enjoy eating natto."
        }
      ],
      "similarGrammarIds": [],
      "commonMistakes": [
        "Do not use with instantaneous single actions. It represents a sustained change of condition/habit.",
