  "grammars": [
    {
      "id": "n4.l17.g001",
      "lessonId": "n4.l17",
      "pattern": "[Verb Dictionary form / ない form] + ことにする / ことにしている",
      "meaning": "Personal Decision / Personal Habit or Rule",
      "formation": "Verb (Dictionary form) + ことにする (食べることにする)\nVerb (ない form) + ことにする (飲まないことにする)\nHabit/Rule: 〜ことにしている (毎日ジョギングすることにしている)",
      "explanation": {
        "en": "〜ことにする indicates a personal, conscious decision made by the speaker. 〜ことにしている expresses a personal habit, routine, or code of conduct that the speaker has consciously decided to maintain.",
        "my": "မိမိကိုယ်တိုင်၏ သန္နိဋ္ဌာန်ဖြင့် ဆုံးဖြတ်ခြင်း (〜ことにする) နှင့် မိမိကိုယ်တိုင် ပြုလုပ်ရန် စည်းမျဉ်းထားရှိသော အလေ့အကျင့် (〜ことにしている) ကို ဖော်ပြသည်။"
      },
      "examples": [
        {
          "sentenceId": "n4.l17.s001",
          "note": "I decided to run every morning for my health."
        },
        {
          "sentenceId": "n4.l17.s004",
          "note": "I make it a rule to read for thirty minutes before sleeping."
        }
      ],
      "similarGrammarIds": [],
      "commonMistakes": [
        "Do not confuse with ことになる; ことにする expresses YOUR own will, while ことになる expresses an external or institutional decision."
      ],
      "level": "N4",
      "difficulty": 2,
      "prov": {
        "source": "Nihongo N2 Master Editorial Team (Native Review)",
        "license": "CC-BY-4.0",
        "status": "reviewed",
        "updatedAt": "2026-10-01T00:00:00Z",
        "rev": 2
      },
