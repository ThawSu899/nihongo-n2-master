  "grammars": [
    {
      "id": "n5.l05.g001",
      "lessonId": "n5.l05",
      "pattern": "[Place] へ 行きます / 来ます / 帰ります",
      "meaning": "Go / Come / Return to [Place]",
      "formation": "Place + へ (pronounced \"e\") + 行きます/来ます/帰ります",
      "explanation": {
        "en": "The particle へ marks the directional destination of motion verbs. Pronounced \"e\", not \"he\".",
        "my": "သွားရာ၊ လာရာ၊ ပြန်ရာ ဦးတည်ချက်နေရာကို 「へ」 (အသံထွက် \"အဲ\") ဖြင့် ပြသည်။"
      },
      "examples": [
        {
          "sentenceId": "n5.l05.s001",
          "note": "Basic usage"
        },
        {
          "sentenceId": "n5.l05.s002",
          "note": "Conversational context"
        }
      ],
      "similarGrammarIds": [],
      "commonMistakes": [
        "Writing particle へ as え is a common beginner error. Always write the hiragana letter へ."
      ],
      "difficulty": 1,
      "level": "N5",
      "prov": {
        "source": "Nihongo N2 Master Editorial Team (Native Review)",
        "license": "CC-BY-4.0",
        "status": "reviewed",
        "updatedAt": "2026-10-01T00:00:00Z",
        "rev": 2
      }
    },
    {
      "id": "n5.l05.g002",
      "lessonId": "n5.l05",
      "pattern": "[Transport] で 行きます",
      "meaning": "Go by [Means of Transportation]",
      "formation": "Vehicle + で + Motion Verb",
      "explanation": {
        "en": "The particle で specifies the method or vehicle used for travel. Exception: 歩いて (on foot) does not take で.",
        "my": "စီးနင်းသွားလာသော ယာဉ်နောက်တွင် 「で」 (ဖြင့်) လိုက်သည်။ 「歩いて」 (လမ်းလျှောက်) နောက်တွင် 「で」 မလိုက်ပါ။"
      },
      "examples": [
        {
          "sentenceId": "n5.l05.s001",
          "note": "Basic usage"
        },
        {
          "sentenceId": "n5.l05.s005",
          "note": "Conversational context"
        }
      ],
      "similarGrammarIds": [],
      "commonMistakes": [
        "Do NOT say *歩いてで行きます. Simply say 歩いて行きます."
      ],
      "difficulty": 1,
      "level": "N5",
      "prov": {
        "source": "Nihongo N2 Master Editorial Team (Native Review)",
        "license": "CC-BY-4.0",
        "status": "reviewed",
        "updatedAt": "2026-10-01T00:00:00Z",
        "rev": 2
      }
    }
  ],
