  "grammars": [
    {
      "id": "n5.l19.g001",
      "lessonId": "n5.l19",
      "pattern": "[Verb dict] ことが できます",
      "meaning": "Can [Verb] / Able to [Verb]",
      "formation": "Verb (Dictionary form) + ことが + できます / できません",
      "explanation": {
        "en": "Nominalizes the verb with こと to express potential capability or circumstantial possibility: 漢字を五百字読むことができます (I can read 500 kanji).",
        "my": "ပြုလုပ်နိုင်စွမ်း သို့မဟုတ် အခြေအနေအရ ပြုလုပ်ခွင့်ရှိခြင်းကို 「ကြိယာ Dictionary-form + ことができます」 (... နိုင်သည်) ဖြင့် ဖော်ပြသည်။"
      },
      "examples": [
        {
          "sentenceId": "n5.l19.s001",
          "note": "Basic usage"
        },
        {
          "sentenceId": "n5.l19.s003",
          "note": "Conversational context"
        }
      ],
      "similarGrammarIds": [],
      "commonMistakes": [
        "Do NOT attach ことができます to the ます-form (*話しますことができます is ungrammatical; must be 話すことができます)."
      ],
      "difficulty": 1,
      "level": "N5",
      "prov": {
        "source": "Nihongo N2 Master Editorial Team (Native Review)",
        "license": "CC-BY-4.0",
        "status": "reviewed",
        "updatedAt": "2026-10-01T00:00:00Z",
        "rev": 2
      }
    },
    {
      "id": "n5.l19.g002",
      "lessonId": "n5.l19",
      "pattern": "私の趣味は [Verb dict] ことです",
      "meaning": "My hobby is [Verbing]",
      "formation": "趣味は + Verb (Dictionary form) + こと + です",
      "explanation": {
        "en": "Nominalizes the action so that a verb phrase can serve as the predicate complement describing one's hobby: 私の趣味は写真を撮ることです (My hobby is taking photos).",
        "my": "မိမိ၏ ဝါသနာကို ဖော်ပြရာတွင် 「〜趣味は [ကြိယာ Dictionary-form] ことです」 (...ခြင်း ဖြစ်သည်) ဟု သုံးသည်။"
      },
      "examples": [
        {
          "sentenceId": "n5.l19.s002",
          "note": "Basic usage"
        }
      ],
      "similarGrammarIds": [],
      "commonMistakes": [
        "Do NOT end with just the verb (*趣味は写真を撮ります is wrong). It must be nominalized with ことです."
      ],
      "difficulty": 1,
      "level": "N5",
      "prov": {
        "source": "Nihongo N2 Master Editorial Team (Native Review)",
        "license": "CC-BY-4.0",
        "status": "reviewed",
        "updatedAt": "2026-10-01T00:00:00Z",
        "rev": 2
      }
    }
  ],
