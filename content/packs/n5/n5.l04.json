  "grammars": [
    {
      "id": "n5.l04.g001",
      "lessonId": "n5.l04",
      "pattern": "今 [Time] です",
      "meaning": "It is [Time] right now",
      "formation": "今 + Hour (時) + Minute (分) + です",
      "explanation": {
        "en": "Tells the current time. Pay attention to phonetic changes: 4時 (よじ, NOT しじ), 9時 (くじ, NOT きゅうじ), and minutes (1分 いっぷん, 3分 さんぷん, 6分 ろっぷん).",
        "my": "လတ်တလောအချိန်ကို ဖော်ပြသည်။ ၄ နာရီကို 「よじ」၊ ၉ နာရီကို 「くじ」 ဟု အသံပြောင်းလဲထွက်ရသည်။"
      },
      "examples": [
        {
          "sentenceId": "n5.l04.s001",
          "note": "Basic usage"
        },
        {
          "sentenceId": "n5.l04.s004",
          "note": "Conversational context"
        }
      ],
      "similarGrammarIds": [],
      "commonMistakes": [
        "Do NOT say *しじ for 4:00 or *きゅうじ for 9:00. Always say よじ and くじ."
      ],
      "difficulty": 1,
      "level": "N5",
      "prov": {
        "source": "Nihongo N2 Master Editorial Team (Native Review)",
        "license": "CC-BY-4.0",
        "status": "reviewed",
        "updatedAt": "2026-10-01T00:00:00Z",
        "rev": 2
      }
    },
    {
      "id": "n5.l04.g002",
      "lessonId": "n5.l04",
      "pattern": "[Time/Day] から [Time/Day] まで",
      "meaning": "From [Time/Day] to [Time/Day]",
      "formation": "Start Time/Day + から + End Time/Day + まで",
      "explanation": {
        "en": "Expresses starting and ending boundaries of a schedule, office hours, or study block.",
        "my": "အချိန် သို့မဟုတ် နေ့ရက်၏ စတင်ချိန်နှင့် ပြီးဆုံးချိန်ကို 「〜から〜まで」 (မှ... အထိ) ဟု သုံးသည်။"
      },
      "examples": [
        {
          "sentenceId": "n5.l04.s002",
          "note": "Basic usage"
        },
        {
          "sentenceId": "n5.l04.s003",
          "note": "Conversational context"
        }
      ],
      "similarGrammarIds": [],
      "commonMistakes": [
        "から and まで can be used independently (e.g. 9時から働きます = I work from 9:00)."
      ],
      "difficulty": 1,
      "level": "N5",
      "prov": {
        "source": "Nihongo N2 Master Editorial Team (Native Review)",
        "license": "CC-BY-4.0",
        "status": "reviewed",
        "updatedAt": "2026-10-01T00:00:00Z",
        "rev": 2
      }
    }
  ],
