  "reading": {
    "id": "n5.l04.r01",
    "lessonId": "n5.l04",
    "title": "Time, Dates, and Schedules (何時・何日) - 読解",
    "level": "N5",
    "text": "私は毎日六時に起きます。朝ご飯は七時です。学校は午前九時から始まります。授業は午後三時までです。月曜日から金曜日まで毎日勉強します。土曜日と日曜日は学校の休みです。毎晩八時から十時まで日本語を復習します。",
    "kanaText": "わたしはまいにちろくじにおきます。あさごはんはしちじです。がっこうはごぜんくじからはじまります。じゅぎょうはごごさんじまでです。げつようびからきんようびまでまいにちべんきょうします。どようびとにちようびはがっこうのやすみです。まいばんはちじからじゅうじまでにほんごをふくしゅうします。",
    "translation": "I wake up at 6:00 every day. Breakfast is at 7:00. School starts at 9:00 AM. Classes run until 3:00 PM. I study every day from Monday through Friday. Saturday and Sunday are school days off. Every night, I review Japanese from 8:00 to 10:00.",
    "questionIds": [
      "n5.l04.q021",
      "n5.l04.q022",
      "n5.l04.q023",
      "n5.l04.q024",
      "n5.l04.q025"
    ],
    "difficulty": 1,
    "glossary": [],
    "prov": {
      "source": "Nihongo N2 Master Editorial Team (Native Review)",
      "license": "CC-BY-4.0",
      "status": "reviewed",
      "updatedAt": "2026-10-01T00:00:00Z",
      "rev": 2
    }
  },
  "listening": {
    "id": "n5.l04.l01",
    "lessonId": "n5.l04",
    "title": "Time, Dates, and Schedules (何時・何日) - 聴解",
    "level": "N5",
    "audio": {
      "kind": "tts",
      "lang": "ja-JP"
    },
    "speakers": [
      "利用者",
      "職員"
    ],
    "transcript": "利用者：すみません、こちらの図書館は何時から何時までですか。\n職員：平日は午前九時から午後八時までです。\n利用者：土曜日はどうですか。\n職員：土曜日は午前九時から午後五時までです。日曜日は休みです。",
    "translation": "A learner asks a librarian about the library's opening hours and weekend schedule.",
    "turns": [
      {
        "speaker": "利用者",
        "ja": "すみません、こちらの図書館は何時から何時までですか。",
        "kana": "すみません、こちらのとしょかんはなんじからなんじまでですか。",
        "en": "Excuse me, what are the library's hours from opening to closing?"
      },
      {
        "speaker": "職員",
        "ja": "平日は午前九時から午後八時までです。",
        "kana": "へいじつはごぜんくじからごごはちじまでです。",
        "en": "On weekdays, it is open from 9:00 AM to 8:00 PM."
      },
      {
        "speaker": "利用者",
        "ja": "土曜日はどうですか。",
        "kana": "どようびはどうですか。",
        "en": "How about Saturdays?"
      },
      {
        "speaker": "職員",
        "ja": "土曜日は午前九時から午後五時までです。日曜日は休みです。",
        "kana": "どようびはごぜんくじからごごごじまでです。にちようびはやすみです。",
        "en": "On Saturdays, it is open from 9:00 AM to 5:00 PM. We are closed on Sundays."
      }
    ],
