  "grammars": [
    {
      "id": "n5.l16.g001",
      "lessonId": "n5.l16",
      "pattern": "[Verb-te] も いいですか",
      "meaning": "May I [Verb]? (Permission)",
      "formation": "Verb (て-form) + も + いいですか",
      "explanation": {
        "en": "Used to ask for permission: 写真を撮ってもいいですか (May I take a photo?). Affirmative answer: ええ、いいですよ (Yes, you may).",
        "my": "ခွင့်ပြုချက်တောင်းခံရာတွင် 「ကြိယာ て-form + もいいですか」 (ပြုလုပ်ခွင့်ရှိပါသလား) ဟု သုံးသည်။"
      },
      "examples": [
        {
          "sentenceId": "n5.l16.s001",
          "note": "Basic usage"
        },
        {
          "sentenceId": "n5.l16.s003",
          "note": "Conversational context"
        }
      ],
      "similarGrammarIds": [],
      "commonMistakes": [
        "Do NOT say *撮るもいいですか. The verb must be in its て-form."
      ],
      "difficulty": 1,
      "level": "N5",
      "prov": {
        "source": "Nihongo N2 Master Editorial Team (Native Review)",
        "license": "CC-BY-4.0",
        "status": "reviewed",
        "updatedAt": "2026-10-01T00:00:00Z",
        "rev": 2
      }
    },
    {
      "id": "n5.l16.g002",
      "lessonId": "n5.l16",
      "pattern": "[Verb-te] は いけません",
      "meaning": "Must not [Verb] (Prohibition)",
      "formation": "Verb (て-form) + は (pronounced \"wa\") + いけません",
      "explanation": {
        "en": "Expresses strong rules or prohibitions: ここに車を止めてはいけません (You must not park your car here).",
        "my": "စည်းကမ်းတားမြစ်ချက်ကို ဖော်ပြရာတွင် 「ကြိယာ て-form + はいけません」 (မပြုလုပ်ရ) ဟု သုံးသည်။"
      },
      "examples": [
        {
          "sentenceId": "n5.l16.s002",
          "note": "Basic usage"
        },
        {
          "sentenceId": "n5.l16.s006",
          "note": "Conversational context"
        }
      ],
      "similarGrammarIds": [],
      "commonMistakes": [
        "Writing particle は as わ is an error. Always write hiragana は."
      ],
      "difficulty": 1,
      "level": "N5",
      "prov": {
        "source": "Nihongo N2 Master Editorial Team (Native Review)",
        "license": "CC-BY-4.0",
        "status": "reviewed",
        "updatedAt": "2026-10-01T00:00:00Z",
        "rev": 2
      }
    }
  ],
