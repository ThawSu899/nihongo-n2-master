  "reading": {
    "id": "n5.l09.r01",
    "lessonId": "n5.l09",
    "title": "Preferences and Abilities (好き・上手) - 読解",
    "level": "N5",
    "text": "私の趣味は料理と日本の映画を見ることです。休みの日はよく自分で日本の料理を作ります。寿司や天ぷらが大好きですから、本を見ながら作ります。歌を歌うことも好きですが、あまり上手ではありませんから、一人で部屋で歌います。日本語のアニメも好きですから、毎日セリフを聞いて勉強します。",
    "kanaText": "わたしのしゅみはりょうりとにほんのえいがをみることです。やすみのひはよくじぶんでにほんのりょうりをつくります。すしやてんぷらがだいすきですから、ほんをみながらつくります。うたをうたうこともすきですが、あまりじょうずではありませんから、ひとりでへやでうたいます。にほんのあにめもすきですから、まいにちせりふをきいてべんきょうします。",
    "translation": "My hobbies are cooking and watching Japanese films. On days off, I often cook Japanese dishes myself. Because I love sushi and tempura, I make them while looking at recipe books. I also like singing, but because I am not very good at it, I sing alone in my room. I also love Japanese anime, so I listen to the dialogue every day to study.",
    "questionIds": [
      "n5.l09.q021",
      "n5.l09.q022",
      "n5.l09.q023",
      "n5.l09.q024",
      "n5.l09.q025"
    ],
    "difficulty": 1,
    "glossary": [],
    "prov": {
      "source": "Nihongo N2 Master Editorial Team (Native Review)",
      "license": "CC-BY-4.0",
      "status": "reviewed",
      "updatedAt": "2026-10-01T00:00:00Z",
      "rev": 2
    }
  },
  "listening": {
    "id": "n5.l09.l01",
    "lessonId": "n5.l09",
    "title": "Preferences and Abilities (好き・上手) - 聴解",
    "level": "N5",
    "audio": {
      "kind": "tts",
      "lang": "ja-JP"
    },
    "speakers": [
      "タナカ",
      "ワン"
    ],
    "transcript": "タナカ：ワンさん、今日の放課後、カラオケへ行きませんか。\nワン：カラオケですか。うーん、私は歌があまり上手じゃありませんから...。\nタナカ：大丈夫ですよ！私も下手ですから。ただ音楽を聴いて楽しみましょう。\nワン：そうですか。日本の歌を聴くのは大好きですから、行きます！",
    "translation": "Two classmates discuss singing and music preferences after school.",
    "turns": [
      {
        "speaker": "タナカ",
        "ja": "ワンさん、今日の放課後、カラオケへ行きませんか。",
        "kana": "わんさん、きょうのほうかご、からおけへいきませんか。",
        "en": "Wang-san, won't you go to karaoke after school today?"
      },
      {
        "speaker": "ワン",
        "ja": "カラオケですか。うーん、私は歌があまり上手じゃありませんから...。",
        "kana": "からおけですか。うーん、わたしはうたがあまりじょうずじゃありませんから...。",
        "en": "Karaoke? Well, because I am not very good at singing..."
      },
      {
        "speaker": "タナカ",
        "ja": "大丈夫ですよ！私も下手ですから。ただ音楽を聴いて楽しみましょう。",
        "kana": "だいじょうぶですよ！わたしもへたですから。ただおんがくをきいてたのしみましょう。",
        "en": "Don't worry! I'm poor at it too. Let's just enjoy listening to music."
      },
      {
        "speaker": "ワン",
        "ja": "そうですか。日本の歌を聴くのは大好きですから、行きます！",
        "kana": "そうですか。にほんのうたをきくのはだいすきですから、いきます！",
        "en": "Really? I love listening to Japanese songs, so I will come along!"
      }
    ],
