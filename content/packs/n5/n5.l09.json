  "grammars": [
    {
      "id": "n5.l09.g001",
      "lessonId": "n5.l09",
      "pattern": "[Noun] が 好きです / 上手です",
      "meaning": "Like [Noun] / Good at [Noun]",
      "formation": "Topic (は) + Object of preference/skill + が + 好き/嫌い/上手/下手 + です",
      "explanation": {
        "en": "Unlike English where like/skill take direct objects, in Japanese the target of feeling or capability is marked by particle が because 好き/上手 are stative predicates.",
        "my": "ကြိုက်နှစ်သက်မှုနှင့် ကျွမ်းကျင်မှုကို ဖော်ပြသည့်အခါ ကံပုဒ်နောက်တွင် 「が」 လိုက်သည်။ (ဥပမာ 日本料理が好きです)။"
      },
      "examples": [
        {
          "sentenceId": "n5.l09.s001",
          "note": "Basic usage"
        },
        {
          "sentenceId": "n5.l09.s002",
          "note": "Conversational context"
        }
      ],
      "similarGrammarIds": [],
      "commonMistakes": [
        "Do NOT say *日本語を好きです. The target of 好き must be marked with が (日本語が好きです)."
      ],
      "difficulty": 1,
      "level": "N5",
      "prov": {
        "source": "Nihongo N2 Master Editorial Team (Native Review)",
        "license": "CC-BY-4.0",
        "status": "reviewed",
        "updatedAt": "2026-10-01T00:00:00Z",
        "rev": 2
      }
    },
    {
      "id": "n5.l09.g002",
      "lessonId": "n5.l09",
      "pattern": "[Reason sentence] から、[Result sentence]",
      "meaning": "Because [Reason], [Result]",
      "formation": "Clause 1 (Reason) + から、 + Clause 2 (Result)",
      "explanation": {
        "en": "から attaches to the reason clause. Can also end a sentence to answer どうしてですか (Why?).",
        "my": "အကြောင်းပြချက်ဝါကျနောက်တွင် 「から」 (သောကြောင့်) ထည့်ပြီး ရလဒ်ဝါကျကို ဆက်ရေးသည်။"
      },
      "examples": [
        {
          "sentenceId": "n5.l09.s003",
          "note": "Basic usage"
        },
        {
          "sentenceId": "n5.l09.s004",
          "note": "Conversational context"
        }
      ],
      "similarGrammarIds": [],
      "commonMistakes": [
        "Remember the order: Reason comes BEFORE から. (時間がありませんから、タクシーで行きます = Because I have no time, I will go by taxi)."
      ],
      "difficulty": 1,
      "level": "N5",
      "prov": {
        "source": "Nihongo N2 Master Editorial Team (Native Review)",
        "license": "CC-BY-4.0",
        "status": "reviewed",
        "updatedAt": "2026-10-01T00:00:00Z",
        "rev": 2
      }
    }
  ],
