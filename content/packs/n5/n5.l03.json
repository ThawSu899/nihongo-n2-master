  "grammars": [
    {
      "id": "n5.l03.g001",
      "lessonId": "n5.l03",
      "pattern": "[Noun] は [Place] です",
      "meaning": "[Noun] is at [Place]",
      "formation": "Noun + は + Place (ここ/そこ/あそこ) + です",
      "explanation": {
        "en": "States the location of a person, object, or facility.",
        "my": "လူ၊ ပစ္စည်း သို့မဟုတ် နေရာဌာန တည်ရှိရာကို ဖော်ပြရာတွင် သုံးသည်။"
      },
      "examples": [
        {
          "sentenceId": "n5.l03.s001",
          "note": "Basic usage"
        },
        {
          "sentenceId": "n5.l03.s003",
          "note": "Conversational context"
        }
      ],
      "similarGrammarIds": [],
      "commonMistakes": [
        "Do not confuse どこ (where) with どれ (which one). Use どこ to ask for physical location."
      ],
      "difficulty": 1,
      "level": "N5",
      "prov": {
        "source": "Nihongo N2 Master Editorial Team (Native Review)",
        "license": "CC-BY-4.0",
        "status": "reviewed",
        "updatedAt": "2026-10-01T00:00:00Z",
        "rev": 2
      }
    },
    {
      "id": "n5.l03.g002",
      "lessonId": "n5.l03",
      "pattern": "[Noun] は どこですか",
      "meaning": "Where is [Noun]?",
      "formation": "Noun + は + どこ / どちら + ですか",
      "explanation": {
        "en": "Used to ask the location of an office, room, or item. どちら is the polite equivalent of どこ.",
        "my": "နေရာကို မေးမြန်းရာတွင် 「〜は どこですか」 သို့မဟုတ် ပိုမိုယဉ်ကျေးစွာ 「〜は どちらですか」 ဟု သုံးသည်။"
      },
      "examples": [
        {
          "sentenceId": "n5.l03.s002",
          "note": "Basic usage"
        },
        {
          "sentenceId": "n5.l03.s006",
          "note": "Conversational context"
        }
      ],
      "similarGrammarIds": [],
      "commonMistakes": [
        "Remember that polite conversations (reception, department stores) prefer どちら/こちら/そちら/あちら over どこ/ここ/そこ/あそこ."
      ],
      "difficulty": 1,
      "level": "N5",
      "prov": {
        "source": "Nihongo N2 Master Editorial Team (Native Review)",
        "license": "CC-BY-4.0",
        "status": "reviewed",
        "updatedAt": "2026-10-01T00:00:00Z",
        "rev": 2
      }
    }
