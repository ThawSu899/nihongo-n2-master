  "grammars": [
    {
      "id": "n5.l08.g001",
      "lessonId": "n5.l08",
      "pattern": "[Noun] は [い-Adj] です / 〜くないです",
      "meaning": "[Noun] is [Adjective] / is not [Adjective]",
      "formation": "Affirmative: い-Adj + です  |  Negative: drop い + くないです",
      "explanation": {
        "en": "i-adjectives end with ~い. For negatives, drop the final ~い and append ~くないです (e.g. 高い -> 高くないです). Irregular: いい -> よくないです.",
        "my": "い-နာမဝိသေသန ငြင်းပယ်ဝါကျတွင် နောက်ဆုံး 「い」 ကို ဖြုတ်ပြီး 「くないです」 ပေါင်းထည့်ရသည်။ (ဥပမာ - いい -> よくないです)။"
      },
      "examples": [
        {
          "sentenceId": "n5.l08.s001",
          "note": "Basic usage"
        },
        {
          "sentenceId": "n5.l08.s002",
          "note": "Conversational context"
        }
      ],
      "similarGrammarIds": [],
      "commonMistakes": [
        "Never say *いくないです. For いい (good), the negative is always よくないです."
      ],
      "difficulty": 1,
      "level": "N5",
      "prov": {
        "source": "Nihongo N2 Master Editorial Team (Native Review)",
        "license": "CC-BY-4.0",
        "status": "reviewed",
        "updatedAt": "2026-10-01T00:00:00Z",
        "rev": 2
      }
    },
    {
      "id": "n5.l08.g002",
      "lessonId": "n5.l08",
      "pattern": "[Noun] は [な-Adj] です / ではありません",
      "meaning": "[Noun] is [Na-Adjective] / is not [Na-Adjective]",
      "formation": "Predicate: な-Adj root + です / ではありません  |  Modifying Noun: な-Adj + な + Noun",
      "explanation": {
        "en": "na-adjectives drop な when used as predicates (静かです), but require な when modifying nouns directly (静かな部屋).",
        "my": "な-နာမဝိသေသနသည် ဝါကျအဆုံးတွင် 「〜です」 တွဲပြီး၊ နာမ်ရှေ့တွင် အထူးပြုပါက 「〜な Noun」 (ဥပမာ 静かな部屋) ဖြစ်သည်။"
      },
      "examples": [
        {
          "sentenceId": "n5.l08.s003",
          "note": "Basic usage"
        },
        {
          "sentenceId": "n5.l08.s004",
          "note": "Conversational context"
        }
      ],
      "similarGrammarIds": [],
      "commonMistakes": [
        "Do NOT say *静かですな部屋. The modifying form is simply 静かな部屋."
      ],
      "difficulty": 1,
      "level": "N5",
      "prov": {
        "source": "Nihongo N2 Master Editorial Team (Native Review)",
        "license": "CC-BY-4.0",
        "status": "reviewed",
        "updatedAt": "2026-10-01T00:00:00Z",
        "rev": 2
      }
    }
  ],
