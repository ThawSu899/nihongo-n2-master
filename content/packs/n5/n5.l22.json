  "grammars": [
    {
      "id": "n5.l22.g001",
      "lessonId": "n5.l22",
      "pattern": "Plain Present Form (普通形 現在: 書く・書かない・高い・暇だ)",
      "meaning": "Plain casual present affirmative and negative",
      "formation": "Verbs: Dictionary / ない-form. い-adj: 保つ / くない. な-adj/Noun: だ / じゃない",
      "explanation": {
        "en": "The informal plain form is used in casual conversation among peers, close friends, and family: 明日どこ行く？ (Where are you going tomorrow?), 映画を見るよ (I'm watching a movie). In questions, か is often dropped and replaced with rising intonation.",
        "my": "ရင်းနှီးသော သူငယ်ချင်းများ၊ မိသားစုဝင်များနှင့် စကားပြောရာတွင် သုံးသော ရိုးရိုးပုံစံ (普通形) ဖြစ်သည်။ အမေးတွင် 「か」 ကို မသုံးဘဲ လေသံမြင့်၍ မေးလေ့ရှိသည်။"
      },
      "examples": [
        {
          "sentenceId": "n5.l22.s001",
          "note": "Affirmative chat"
        },
        {
          "sentenceId": "n5.l22.s006",
          "note": "Casual question and answer"
        }
      ],
      "similarGrammarIds": [],
      "commonMistakes": [
        "Do not use plain form with seniors, teachers, or strangers. Use polite ます/です style instead."
      ],
      "difficulty": 1,
      "level": "N5",
      "prov": {
        "source": "Nihongo N2 Master Editorial Team (Native Review)",
        "license": "CC-BY-4.0",
        "status": "reviewed",
        "updatedAt": "2026-10-01T00:00:00Z",
        "rev": 2
      }
    },
    {
      "id": "n5.l22.g002",
      "lessonId": "n5.l22",
      "pattern": "Plain Past Form (普通形 過去: 書いた・書かなかった・高かった・暇だった)",
      "meaning": "Plain casual past affirmative and negative",
      "formation": "Verbs: た-form / なかった-form. い-adj: かった / くなかった. な-adj/Noun: だった / じゃなかった",
      "explanation": {
        "en": "Expresses past actions or states in informal style: 昨日何食べた？ (What did you eat yesterday?), ピザを食べたよ (I ate pizza).",
        "my": "အတိတ်ကာလ လုပ်ဆောင်ချက်များနှင့် အခြေအနေများကို ရင်းနှီးသောစကားဖြင့် ဖော်ပြရာတွင် 「た-form / なかった-form」 စသည်ဖြင့် သုံးသည်။"
      },
      "examples": [
        {
          "sentenceId": "n5.l22.s003",
          "note": "Past action"
        },
        {
          "sentenceId": "n5.l22.s007",
          "note": "Negative past"
        }
      ],
      "similarGrammarIds": [],
      "commonMistakes": [
        "Remember that the plain past of だ (is) is だった, not *でしただ. For negative past of い-adjectives, it is 〜くなかった."
      ],
      "difficulty": 1,
      "level": "N5",
      "prov": {
        "source": "Nihongo N2 Master Editorial Team (Native Review)",
        "license": "CC-BY-4.0",
        "status": "reviewed",
        "updatedAt": "2026-10-01T00:00:00Z",
        "rev": 2
      }
    }
  ],
