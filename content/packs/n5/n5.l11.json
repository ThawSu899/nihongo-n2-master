  "grammars": [
    {
      "id": "n5.l11.g001",
      "lessonId": "n5.l11",
      "pattern": "[Noun] を [Quantity] 買います / 食べます",
      "meaning": "[Verb] [Quantity] of [Noun]",
      "formation": "Noun + を + Number/Counter + Verb",
      "explanation": {
        "en": "In Japanese, counters generally follow the particle を directly, before the verb: りんごを二つ買いました (I bought two apples).",
        "my": "ဂျပန်ဘာသာတွင် အရေအတွက်ပြသင်္ချာစကားလုံးသည် ကံပုဒ်အက္ခရာ 「を」 ၏နောက်၊ ကြိယာ၏ရှေ့တွင် တိုက်ရိုက်လိုက်လေ့ရှိသည်။"
      },
      "examples": [
        {
          "sentenceId": "n5.l11.s001",
          "note": "Basic usage"
        },
        {
          "sentenceId": "n5.l11.s002",
          "note": "Conversational context"
        }
      ],
      "similarGrammarIds": [],
      "commonMistakes": [
        "Do NOT attach を after the counter. Say 「りんごを二つください」, NOT *「りんご二つをください」 in standard beginner grammar."
      ],
      "difficulty": 1,
      "level": "N5",
      "prov": {
        "source": "Nihongo N2 Master Editorial Team (Native Review)",
        "license": "CC-BY-4.0",
        "status": "reviewed",
        "updatedAt": "2026-10-01T00:00:00Z",
        "rev": 2
      }
    },
    {
      "id": "n5.l11.g002",
      "lessonId": "n5.l11",
      "pattern": "[Period] に [Times] [Verb]",
      "meaning": "[Times] per [Period]",
      "formation": "Time Period (1週間 / 1か月) + に + Number of times (1回 / 2回) + Verb",
      "explanation": {
        "en": "The particle に indicates the base time unit for frequency: 1か月に2回映画を見ます (I watch movies twice a month).",
        "my": "ကာလအပိုင်းအခြားတစ်ခုအတွင်း အကြိမ်အရေအတွက်ကိုဖော်ပြရာတွင် 「〜に〜回」 (တစ်လတွင်... ကြိမ်) ဟု သုံးသည်။"
      },
      "examples": [
        {
          "sentenceId": "n5.l11.s004",
          "note": "Basic usage"
        }
      ],
      "similarGrammarIds": [],
      "commonMistakes": [
        "Do not omit に. 「1週間に3回」 is correct; 「*1週間3回」 lacks the rate particle."
      ],
      "difficulty": 1,
      "level": "N5",
      "prov": {
        "source": "Nihongo N2 Master Editorial Team (Native Review)",
        "license": "CC-BY-4.0",
        "status": "reviewed",
        "updatedAt": "2026-10-01T00:00:00Z",
        "rev": 2
      }
    }
  ],
