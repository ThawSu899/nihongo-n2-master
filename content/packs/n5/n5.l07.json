  "grammars": [
    {
      "id": "n5.l07.g001",
      "lessonId": "n5.l07",
      "pattern": "[Tool / Language] で [Action]",
      "meaning": "By means of [Tool] / In [Language]",
      "formation": "Tool / Language + で + Action Verb",
      "explanation": {
        "en": "The particle で specifies the instrument, tool, or medium used to complete an action (e.g. はしで食べます = eat with chopsticks; 日本語で書きます = write in Japanese).",
        "my": "ကိရိယာတန်ဆာပလာ သို့မဟုတ် ဘာသာစကားဖြင့် ပြုလုပ်ကြောင်းဖော်ပြရာတွင် 「で」 လိုက်သည်။"
      },
      "examples": [
        {
          "sentenceId": "n5.l07.s001",
          "note": "Basic usage"
        },
        {
          "sentenceId": "n5.l07.s002",
          "note": "Conversational context"
        }
      ],
      "similarGrammarIds": [],
      "commonMistakes": [
        "Do not confuse tool で with location で. Both use particle で, but tool で marks instruments."
      ],
      "difficulty": 1,
      "level": "N5",
      "prov": {
        "source": "Nihongo N2 Master Editorial Team (Native Review)",
        "license": "CC-BY-4.0",
        "status": "reviewed",
        "updatedAt": "2026-10-01T00:00:00Z",
        "rev": 2
      }
    },
    {
      "id": "n5.l07.g002",
      "lessonId": "n5.l07",
      "pattern": "[Person] に [Item] を あげます / もらいます",
      "meaning": "Give [Item] to [Person] / Receive [Item] from [Person]",
      "formation": "Receiver + に + Item + を + あげます  /  Giver + に/から + Item + を + もらいます",
      "explanation": {
        "en": "Marks giving and receiving transactions. Giver gives to receiver (に あげます); receiver receives from giver (に/から もらいます).",
        "my": "ပေးကမ်းခြင်းတွင် လက်ခံသူနောက် 「に」၊ ရရှိခြင်းတွင် ပေးသူနောက် 「に / から」 လိုက်သည်။"
      },
      "examples": [
        {
          "sentenceId": "n5.l07.s002",
          "note": "Basic usage"
        },
        {
          "sentenceId": "n5.l07.s003",
          "note": "Conversational context"
        }
      ],
      "similarGrammarIds": [],
      "commonMistakes": [
        "Never use あげます when someone gives something to YOU. Use もらいます or くれます instead."
      ],
      "difficulty": 1,
      "level": "N5",
      "prov": {
        "source": "Nihongo N2 Master Editorial Team (Native Review)",
        "license": "CC-BY-4.0",
        "status": "reviewed",
        "updatedAt": "2026-10-01T00:00:00Z",
        "rev": 2
      }
    }
  ],
