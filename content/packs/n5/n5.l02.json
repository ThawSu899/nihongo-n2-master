  "listening": {
    "id": "n5.l02.l01",
    "lessonId": "n5.l02",
    "title": "This, That, and Over There (これ・それ・あれ) - 聴解",
    "level": "N5",
    "audio": {
      "kind": "tts",
      "lang": "ja-JP"
    },
    "speakers": [
      "A",
      "B"
    ],
    "transcript": "A：すみません、それはあなたの傘ですか。\nB：いいえ、違います。私のはあれです。あの青い傘です。\nA：そうですか。では、この黒い傘は誰のですか。\nB：あ、それは田中さんのですよ。",
    "translation": "A dialogue between two students finding an umbrella in the classroom.",
    "turns": [
      {
        "speaker": "A",
        "ja": "すみません、それはあなたの傘ですか。",
        "kana": "すみません、それはあなたのかさですか。",
        "en": "Excuse me, is that umbrella yours?"
      },
      {
        "speaker": "B",
        "ja": "いいえ、違います。私のはあれです。あの青い傘です。",
        "kana": "いいえ、ちがいます。わたしのはあれです。あのあおいかさです。",
        "en": "No, it isn't. Mine is that one over there. That blue umbrella."
      },
      {
        "speaker": "A",
        "ja": "そうですか。では、この黒い傘は誰のですか。",
        "kana": "そうですか。では、このくろいかさはだれのですか。",
        "en": "I see. Then whose black umbrella is this?"
      },
      {
        "speaker": "B",
        "ja": "あ、それは田中さんのですよ。",
        "kana": "あ、それはたなかさんのですよ。",
        "en": "Ah, that belongs to Tanaka-san."
      }
