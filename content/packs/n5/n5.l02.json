  "grammars": [
    {
      "id": "n5.l02.g001",
      "lessonId": "n5.l02",
      "pattern": "これ / それ / あれ は [Noun] です",
      "meaning": "This / That / That over there is [Noun]",
      "formation": "これ/それ/あれ + は + Noun + です",
      "explanation": {
        "en": "Used to refer to objects based on distance relative to the speaker and listener: これ (near speaker), それ (near listener), あれ (far from both).",
        "my": "ပြောသူအနီးအရာဝတ္ထုကို これ၊ နားထောင်သူအနီးကို それ၊ နှစ်ဦးစလုံးနှင့်ဝေးရာကို あれ ဟု သုံးသည်။"
      },
      "examples": [
        {
          "sentenceId": "n5.l02.s001",
          "note": "Basic usage"
        },
        {
          "sentenceId": "n5.l02.s002",
          "note": "Conversational context"
        }
      ],
      "similarGrammarIds": [],
      "commonMistakes": [
        "Never attach a noun directly after これ/それ/あれ (e.g. *これ本 is ungrammatical; use この本 instead)."
      ],
      "difficulty": 1,
      "level": "N5",
      "prov": {
        "source": "Nihongo N2 Master Editorial Team (Native Review)",
        "license": "CC-BY-4.0",
        "status": "reviewed",
        "updatedAt": "2026-10-01T00:00:00Z",
        "rev": 2
      }
    },
    {
      "id": "n5.l02.g002",
      "lessonId": "n5.l02",
      "pattern": "この / その / あの [Noun] は [Person] の です",
      "meaning": "This / That / That [Noun] belongs to [Person]",
      "formation": "この/その/あの + Noun + は + Person + の + です",
      "explanation": {
        "en": "Demonstrative determiners (この, その, あの) MUST be immediately followed by a noun, specifying which item belongs to someone.",
        "my": "この/その/あの နောက်တွင် နာမ် အမြဲတွဲရသည်။ ပိုင်ဆိုင်မှုကိုဖော်ပြရာတွင် 「〜の です」 (၏ဥစ္စာဖြစ်သည်) ဟု သုံးသည်။"
      },
      "examples": [
        {
          "sentenceId": "n5.l02.s004",
          "note": "Basic usage"
        },
        {
          "sentenceId": "n5.l02.s005",
          "note": "Conversational context"
        }
      ],
      "similarGrammarIds": [],
      "commonMistakes": [
        "Do not use この without a noun. 「*これは本」 is correct, but 「*このは本」 is ungrammatical."
      ],
      "difficulty": 1,
      "level": "N5",
      "prov": {
        "source": "Nihongo N2 Master Editorial Team (Native Review)",
        "license": "CC-BY-4.0",
        "status": "reviewed",
        "updatedAt": "2026-10-01T00:00:00Z",
        "rev": 2
      }
    }
  ],
