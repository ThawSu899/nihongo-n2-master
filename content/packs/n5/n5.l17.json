  "grammars": [
    {
      "id": "n5.l17.g001",
      "lessonId": "n5.l17",
      "pattern": "[V-te]、[V-te]、それから [Verb]",
      "meaning": "[Action 1], [Action 2], and then [Action 3]",
      "formation": "Verb 1 (て-form) + 、 + Verb 2 (て-form) + 、 + Verb 3",
      "explanation": {
        "en": "Chains chronological events in sequence. The tense of the sentence is determined exclusively by the final verb.",
        "my": "လုပ်ဆောင်ချက်များကို အစဉ်လိုက်ဆက်စပ်ဖော်ပြရာတွင် 「Verb 1 て, Verb 2 て」 ဟု ဆက်ရေးသည်။ ဝါကျ၏ ကာလ (အတိတ်/ပစ္စုပ္ပန်) ကို နောက်ဆုံးကြိယာက ဆုံးဖြတ်သည်။"
      },
      "examples": [
        {
          "sentenceId": "n5.l17.s001",
          "note": "Basic usage"
        },
        {
          "sentenceId": "n5.l17.s002",
          "note": "Conversational context"
        }
      ],
      "similarGrammarIds": [],
      "commonMistakes": [
        "Do not use と to connect verbs (*食べると飲みます is incorrect). Always use the て-form: 食べて、飲みます."
      ],
      "difficulty": 1,
      "level": "N5",
      "prov": {
        "source": "Nihongo N2 Master Editorial Team (Native Review)",
        "license": "CC-BY-4.0",
        "status": "reviewed",
        "updatedAt": "2026-10-01T00:00:00Z",
        "rev": 2
      }
    },
    {
      "id": "n5.l17.g002",
      "lessonId": "n5.l17",
      "pattern": "[Verb-te] から、[Action 2]",
      "meaning": "After doing [Verb 1], do [Action 2]",
      "formation": "Verb 1 (て-form) + から、 + Action 2",
      "explanation": {
        "en": "Specifies that Action 2 occurs only AFTER Action 1 has fully concluded: 手を洗ってから、ご飯を食べます (I eat meal after washing my hands).",
        "my": "ပထမလုပ်ဆောင်ချက် ပြီးမြောက်ပြီးမှ ဒုတိယလုပ်ဆောင်ချက်ကို ပြုလုပ်ကြောင်း 「Verb て + から」 (ပြီးနောက်မှ) ဖြင့် ဖော်ပြသည်။"
      },
      "examples": [
        {
          "sentenceId": "n5.l17.s002",
          "note": "Basic usage"
        },
        {
          "sentenceId": "n5.l17.s004",
          "note": "Conversational context"
        }
      ],
      "similarGrammarIds": [],
      "commonMistakes": [
        "Do not confuse [V-te] から (after doing) with [Noun/Clause] から (because/from). The meaning depends on whether it follows the て-form."
      ],
      "difficulty": 1,
      "level": "N5",
      "prov": {
        "source": "Nihongo N2 Master Editorial Team (Native Review)",
        "license": "CC-BY-4.0",
        "status": "reviewed",
        "updatedAt": "2026-10-01T00:00:00Z",
        "rev": 2
      }
    }
  ],
