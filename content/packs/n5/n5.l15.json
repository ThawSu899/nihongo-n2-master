  "grammars": [
    {
      "id": "n5.l15.g001",
      "lessonId": "n5.l15",
      "pattern": "[Verb-te] ください",
      "meaning": "Please [Verb]",
      "formation": "Verb (て-form) + ください",
      "explanation": {
        "en": "Used to politely request someone to perform an action: ちょっと待ってください (Please wait a moment); 名前を書いてください (Please write your name).",
        "my": "ယဉ်ကျေးစွာ မေတ္တာရပ်ခံတောင်းဆိုရာတွင် 「ကြိယာ て-form + ください」 (ကျေးဇူးပြု၍... ပါ) ဟု သုံးသည်။"
      },
      "examples": [
        {
          "sentenceId": "n5.l15.s001",
          "note": "Basic usage"
        },
        {
          "sentenceId": "n5.l15.s002",
          "note": "Conversational context"
        }
      ],
      "similarGrammarIds": [],
      "commonMistakes": [
        "Do NOT attach ください to the dictionary form or ます-stem (*待つください is ungrammatical; must be 待ってください)."
      ],
      "difficulty": 1,
      "level": "N5",
      "prov": {
        "source": "Nihongo N2 Master Editorial Team (Native Review)",
        "license": "CC-BY-4.0",
        "status": "reviewed",
        "updatedAt": "2026-10-01T00:00:00Z",
        "rev": 2
      }
    },
    {
      "id": "n5.l15.g002",
      "lessonId": "n5.l15",
      "pattern": "[Verb-te] います",
      "meaning": "Is [Verbing] (Current Continuous Action)",
      "formation": "Verb (て-form) + います",
      "explanation": {
        "en": "Indicates an ongoing action in progress at the current moment: 今日本語を勉強しています (I am studying Japanese right now).",
        "my": "လက်ရှိဖြစ်ပျက်နေဆဲ လုပ်ဆောင်ချက်ကို 「ကြိယာ て-form + います」 (...နေသည်) ဖြင့် ဖော်ပြသည်။"
      },
      "examples": [
        {
          "sentenceId": "n5.l15.s003",
          "note": "Basic usage"
        },
        {
          "sentenceId": "n5.l15.s004",
          "note": "Conversational context"
        }
      ],
      "similarGrammarIds": [],
      "commonMistakes": [
        "Do not confuse with present habitual: 勉強します (I study) vs 勉強しています (I am currently studying)."
      ],
      "difficulty": 1,
      "level": "N5",
      "prov": {
        "source": "Nihongo N2 Master Editorial Team (Native Review)",
        "license": "CC-BY-4.0",
        "status": "reviewed",
        "updatedAt": "2026-10-01T00:00:00Z",
        "rev": 2
      }
    }
  ],
