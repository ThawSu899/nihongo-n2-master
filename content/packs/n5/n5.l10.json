  "grammars": [
    {
      "id": "n5.l10.g001",
      "lessonId": "n5.l10",
      "pattern": "[Place] に [Thing] が あります / [Person/Animal] が います",
      "meaning": "There is [Thing/Person] at [Place]",
      "formation": "Location + に + Item/Living Being + が + あります (inanimate) / います (animate)",
      "explanation": {
        "en": "Differentiates living, moving entities (people, dogs, cats take います) from stationary non-living items and plants (books, tables, trees take あります).",
        "my": "တည်ရှိရာနေရာနောက် 「に」 လိုက်ပြီး၊ သက်မဲ့အတွက် 「あります」၊ သက်ရှိလူနှင့်တိရစ္ဆာန်အတွက် 「います」 ကို ခွဲခြားသုံးရသည်။"
      },
      "examples": [
        {
          "sentenceId": "n5.l10.s001",
          "note": "Basic usage"
        },
        {
          "sentenceId": "n5.l10.s002",
          "note": "Conversational context"
        }
      ],
      "similarGrammarIds": [],
      "commonMistakes": [
        "Trees and plants take あります (not います), because they are rooted and non-motile in Japanese grammar."
      ],
      "difficulty": 1,
      "level": "N5",
      "prov": {
        "source": "Nihongo N2 Master Editorial Team (Native Review)",
        "license": "CC-BY-4.0",
        "status": "reviewed",
        "updatedAt": "2026-10-01T00:00:00Z",
        "rev": 2
      }
    },
    {
      "id": "n5.l10.g002",
      "lessonId": "n5.l10",
      "pattern": "[Noun 1] の [Position] に [Noun 2] が あります/います",
      "meaning": "[Noun 2] is [Position] of [Noun 1]",
      "formation": "Reference Noun + の + Position (上/下/前/後ろ/中/隣/間) + に + Target + が + あります/います",
      "explanation": {
        "en": "States relative spatial positioning (e.g. 机の上に本があります = There is a book on the desk; 木の下に猫がいます = There is a cat under the tree).",
        "my": "အရာဝတ္ထုတစ်ခု၏ အနေအထားနေရာ (အပေါ်၊ အောက်၊ အရှေ့၊ အနောက်၊ အထဲ၊ ဘေး) ကို 「Noun 1 の Position に」 ဖြင့် တိကျစွာ ဖော်ပြသည်။"
      },
      "examples": [
        {
          "sentenceId": "n5.l10.s001",
          "note": "Basic usage"
        },
        {
          "sentenceId": "n5.l10.s002",
          "note": "Conversational context"
        }
      ],
      "similarGrammarIds": [],
      "commonMistakes": [
        "Remember that the reference landmark comes before の: 机の上 (on top of desk), not *上机."
      ],
      "difficulty": 1,
      "level": "N5",
      "prov": {
        "source": "Nihongo N2 Master Editorial Team (Native Review)",
        "license": "CC-BY-4.0",
        "status": "reviewed",
        "updatedAt": "2026-10-01T00:00:00Z",
        "rev": 2
      }
    }
  ],
