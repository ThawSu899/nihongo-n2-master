  "grammars": [
    {
      "id": "n5.l12.g001",
      "lessonId": "n5.l12",
      "pattern": "[い-Adj] かったです / 〜くなかったです",
      "meaning": "Was [Adjective] / Was not [Adjective] (Past)",
      "formation": "Past affirmative: drop い + かったです | Past negative: drop い + くなかったです",
      "explanation": {
        "en": "Conjugates i-adjectives into the past tense: 暑い -> 暑かったです (was hot); 寒くない -> 寒くなかったです (was not cold). Irregular: いい -> よかったです / よくなかったです.",
        "my": "い-နာမဝိသေသန အတိတ်ကာလတွင် နောက်ဆုံး 「い」 ကို ဖြုတ်ပြီး 「かったです」 သို့မဟုတ် 「くなかったです」 ပေါင်းထည့်ရသည်။"
      },
      "examples": [
        {
          "sentenceId": "n5.l12.s001",
          "note": "Basic usage"
        },
        {
          "sentenceId": "n5.l12.s002",
          "note": "Conversational context"
        }
      ],
      "similarGrammarIds": [],
      "commonMistakes": [
        "Never say *暑いでした. i-adjectives conjugate internally into かったです."
      ],
      "difficulty": 1,
      "level": "N5",
      "prov": {
        "source": "Nihongo N2 Master Editorial Team (Native Review)",
        "license": "CC-BY-4.0",
        "status": "reviewed",
        "updatedAt": "2026-10-01T00:00:00Z",
        "rev": 2
      }
    },
    {
      "id": "n5.l12.g002",
      "lessonId": "n5.l12",
      "pattern": "[Noun / な-Adj] でした / 〜ではありませんでした",
      "meaning": "Was [Noun/Na-Adj] / Was not [Noun/Na-Adj]",
      "formation": "Noun / な-Adj root + でした / ではありませんでした",
      "explanation": {
        "en": "Nouns and na-adjectives use でした for past affirmative and ではありませんでした (or じゃありませんでした) for past negative.",
        "my": "နာမ်နှင့် な-နာမဝိသေသန အတိတ်ကာလတွင် 「でした」 နှင့် 「ではありませんでした」 သုံးသည်။"
      },
      "examples": [
        {
          "sentenceId": "n5.l12.s003",
          "note": "Basic usage"
        },
        {
          "sentenceId": "n5.l12.s005",
          "note": "Conversational context"
        }
      ],
      "similarGrammarIds": [],
      "commonMistakes": [
        "Do NOT add かったです to na-adjectives (e.g. *静かかったです is WRONG; use 静かでした)."
      ],
      "difficulty": 1,
      "level": "N5",
      "prov": {
        "source": "Nihongo N2 Master Editorial Team (Native Review)",
        "license": "CC-BY-4.0",
        "status": "reviewed",
        "updatedAt": "2026-10-01T00:00:00Z",
        "rev": 2
      }
    }
  ],
