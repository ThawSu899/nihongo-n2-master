  "listening": {
    "id": "n5.l12.l01",
    "lessonId": "n5.l12",
    "title": "Past Tense of Adjectives and Verbs - 聴解",
    "level": "N5",
    "audio": {
      "kind": "tts",
      "lang": "ja-JP"
    },
    "speakers": [
      "松本",
      "カリナ"
    ],
    "transcript": "松本：カリナさん、先週の長野旅行はどうでしたか。\nカリナ：とても楽しかったです！雪がたくさん降って、白くてきれいでした。\n松本：寒くなかったですか。\nカリナ：ええ、とても寒かったです。でも、ホテルの温泉が温かくて気持ちよかったです。",
    "translation": "Colleagues exchange thoughts on a weekend skiing trip to Nagano.",
    "turns": [
      {
        "speaker": "松本",
        "ja": "カリナさん、先週の長野旅行はどうでしたか。",
        "kana": "かりなさん、せんしゅうのながのりょこうはどうでしたか。",
        "en": "Karina-san, how was your trip to Nagano last week?"
      },
      {
        "speaker": "カリナ",
        "ja": "とても楽しかったです！雪がたくさん降って、白くてきれいでした。",
        "kana": "とてもたのしかったです！ゆきがたくさんふって、しろくてきれいでした。",
        "en": "It was very fun! A lot of snow fell, and it was white and beautiful."
      },
      {
        "speaker": "松本",
        "ja": "寒くなかったですか。",
        "kana": "さむくなかったですか。",
        "en": "Wasn't it cold?"
      },
      {
        "speaker": "カリナ",
        "ja": "ええ、とても寒かったです。でも、ホテルの温泉が温かくて気持ちよかったです。",
        "kana": "ええ、とてもさむかったです。でも、ほてるのおんせんがあたたかくてきもちよかったです。",
        "en": "Yes, it was very cold! But the hotel's hot spring was warm and felt wonderful."
      }
    ],
