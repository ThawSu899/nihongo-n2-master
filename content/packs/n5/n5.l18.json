  "grammars": [
    {
      "id": "n5.l18.g001",
      "lessonId": "n5.l18",
      "pattern": "[Verb-nai] でください",
      "meaning": "Please do not [Verb]",
      "formation": "Verb (ない-form) + でください",
      "explanation": {
        "en": "Politely requests someone to refrain from an action: 心配しないでください (Please do not worry); ここで写真を撮らないでください (Please do not take photos here).",
        "my": "ယဉ်ကျေးစွာ မပြုလုပ်ရန် မေတ္တာရပ်ခံရာတွင် 「ကြိယာ ない-form + でください」 (မ... ပါနှင့်) ဟု သုံးသည်။"
      },
      "examples": [
        {
          "sentenceId": "n5.l18.s001",
          "note": "Basic usage"
        },
        {
          "sentenceId": "n5.l18.s003",
          "note": "Conversational context"
        }
      ],
      "similarGrammarIds": [],
      "commonMistakes": [
        "Do NOT say *撮るないでください or *撮らないてください. The form is strictly [ない-form] + で + ください."
      ],
      "difficulty": 1,
      "level": "N5",
      "prov": {
        "source": "Nihongo N2 Master Editorial Team (Native Review)",
        "license": "CC-BY-4.0",
        "status": "reviewed",
        "updatedAt": "2026-10-01T00:00:00Z",
        "rev": 2
      }
    },
    {
      "id": "n5.l18.g002",
      "lessonId": "n5.l18",
      "pattern": "[Verb-nai] なければなりません",
      "meaning": "Must [Verb] / Have to [Verb]",
      "formation": "Verb (drop final い of ない-form) + ければなりません",
      "explanation": {
        "en": "Expresses mandatory obligation, necessity, or duty regardless of speaker's personal preference: 薬を飲まなければなりません (I must take medicine).",
        "my": "မဖြစ်မနေ ပြုလုပ်ရမည့် တာဝန်ဝတ္တရားကို 「ကြိယာ ない-form အဆုံး い ဖြုတ် + ければなりません」 (ပြုလုပ်ရမည်) ဖြင့် ဖော်ပြသည်။"
      },
      "examples": [
        {
          "sentenceId": "n5.l18.s002",
          "note": "Basic usage"
        },
        {
          "sentenceId": "n5.l18.s004",
          "note": "Conversational context"
        }
      ],
      "similarGrammarIds": [],
      "commonMistakes": [
        "Notice the double negative structure (if you don't do it, it won't do). Do not omit ければ."
      ],
      "difficulty": 1,
      "level": "N5",
      "prov": {
        "source": "Nihongo N2 Master Editorial Team (Native Review)",
        "license": "CC-BY-4.0",
        "status": "reviewed",
        "updatedAt": "2026-10-01T00:00:00Z",
        "rev": 2
      }
    }
  ],
