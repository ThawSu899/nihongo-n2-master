  "grammars": [
    {
      "id": "n5.l06.g001",
      "lessonId": "n5.l06",
      "pattern": "[Noun] を [Verb] します",
      "meaning": "[Action] [Noun] (Direct Object)",
      "formation": "Direct Object Noun + を (pronounced \"o\") + Transitive Verb",
      "explanation": {
        "en": "The particle を marks the direct object of a transitive action verb. Always written with を in hiragana.",
        "my": "ကံပုဒ် (တိုက်ရိုက်ခံရသည့်အရာ) နောက်တွင် 「を」 (အသံထွက် \"အို\") လိုက်ရသည်။"
      },
      "examples": [
        {
          "sentenceId": "n5.l06.s001",
          "note": "Basic usage"
        },
        {
          "sentenceId": "n5.l06.s002",
          "note": "Conversational context"
        }
      ],
      "similarGrammarIds": [],
      "commonMistakes": [
        "Do NOT confuse を with お. The grammatical particle is always written as を."
      ],
      "difficulty": 1,
      "level": "N5",
      "prov": {
        "source": "Nihongo N2 Master Editorial Team (Native Review)",
        "license": "CC-BY-4.0",
        "status": "reviewed",
        "updatedAt": "2026-10-01T00:00:00Z",
        "rev": 2
      }
    },
    {
      "id": "n5.l06.g002",
      "lessonId": "n5.l06",
      "pattern": "[Place] で [Verb] します",
      "meaning": "Do [Action] at [Place]",
      "formation": "Place of Action + で + Action Verb",
      "explanation": {
        "en": "The particle で specifies the location where an active event or action takes place (contrasted with に for existence).",
        "my": "လုပ်ဆောင်မှုပြုလုပ်ရာ နေရာနောက်တွင် 「で」 (မှာ/တွင်) လိုက်သည်။"
      },
      "examples": [
        {
          "sentenceId": "n5.l06.s002",
          "note": "Basic usage"
        },
        {
          "sentenceId": "n5.l06.s003",
          "note": "Conversational context"
        }
      ],
      "similarGrammarIds": [],
      "commonMistakes": [
        "Do not use で with existence verbs います/あります; use に for stationary existence."
      ],
      "difficulty": 1,
      "level": "N5",
      "prov": {
        "source": "Nihongo N2 Master Editorial Team (Native Review)",
        "license": "CC-BY-4.0",
        "status": "reviewed",
        "updatedAt": "2026-10-01T00:00:00Z",
        "rev": 2
      }
    }
  ],
