  "grammars": [
    {
      "id": "n5.l13.g001",
      "lessonId": "n5.l13",
      "pattern": "[A] は [B] より [Adj] です",
      "meaning": "[A] is more [Adjective] than [B]",
      "formation": "Item A + は + Item B + より + Adjective + です",
      "explanation": {
        "en": "Compares two entities. Item A has a higher degree of the quality than Item B: 新幹線はバスより速いです (The bullet train is faster than a bus).",
        "my": "A သည် B ထက် ပို၍ [နာမဝိသေသန] ဖြစ်သည်ဟု နှိုင်းယှဉ်ဖော်ပြသည်။"
      },
      "examples": [
        {
          "sentenceId": "n5.l13.s001",
          "note": "Basic usage"
        },
        {
          "sentenceId": "n5.l13.s002",
          "note": "Conversational context"
        }
      ],
      "similarGrammarIds": [],
      "commonMistakes": [
        "Do not confuse the order: the one possessing more of the adjective comes before は."
      ],
      "difficulty": 1,
      "level": "N5",
      "prov": {
        "source": "Nihongo N2 Master Editorial Team (Native Review)",
        "license": "CC-BY-4.0",
        "status": "reviewed",
        "updatedAt": "2026-10-01T00:00:00Z",
        "rev": 2
      }
    },
    {
      "id": "n5.l13.g002",
      "lessonId": "n5.l13",
      "pattern": "[Category] の中で [Item] が 一番 [Adj] です",
      "meaning": "Among [Category], [Item] is the most [Adjective]",
      "formation": "Category (1年 / 家族 / スポーツ) + の中で + 何/誰/どこ + が 一番 + Adj + ですか",
      "explanation": {
        "en": "Expresses superlatives within a group of three or more: 一年の中で春が一番好きです (Among all seasons in the year, I like spring the most).",
        "my": "အစုအဖွဲ့တစ်ခုအတွင်း အသာလွန်ဆုံးအရာကို 「〜の中で〜が一番...」 ဖြင့် သုံးသည်။"
      },
      "examples": [
        {
          "sentenceId": "n5.l13.s003",
          "note": "Basic usage"
        },
        {
          "sentenceId": "n5.l13.s005",
          "note": "Conversational context"
        }
      ],
      "similarGrammarIds": [],
      "commonMistakes": [
        "When asking questions, use 何 (what), 誰 (who), どこ (where), or いつ (when) based on category, not どちら (which of two)."
      ],
      "difficulty": 1,
      "level": "N5",
      "prov": {
        "source": "Nihongo N2 Master Editorial Team (Native Review)",
        "license": "CC-BY-4.0",
        "status": "reviewed",
        "updatedAt": "2026-10-01T00:00:00Z",
        "rev": 2
      }
    }
  ],
