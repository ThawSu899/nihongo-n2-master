  "grammars": [
    {
      "id": "n5.l14.g001",
      "lessonId": "n5.l14",
      "pattern": "[Noun] が ほしいです / [Verb stem] たいです",
      "meaning": "I want [Noun] / I want to [Verb]",
      "formation": "Desire for item: Noun + が + ほしいです  |  Desire to do: Verb-stem (masu-drop) + たいです",
      "explanation": {
        "en": "ほしいです expresses wanting to possess an entity; 〜たいです expresses wanting to perform an action. Both conjugate as i-adjectives (たくないです). Only used for 1st person or direct questions to 2nd person.",
        "my": "အရာဝတ္ထု လိုချင်ပါက 「Noun が ほしいです」၊ ပြုလုပ်လိုပါက 「Verb-stem たいです」 ကို သုံးသည်။"
      },
      "examples": [
        {
          "sentenceId": "n5.l14.s001",
          "note": "Basic usage"
        },
        {
          "sentenceId": "n5.l14.s002",
          "note": "Conversational context"
        }
      ],
      "similarGrammarIds": [],
      "commonMistakes": [
        "Do NOT use ほしいです or 〜たいです directly to describe a 3rd person's desire (e.g. *田中さんは本がほしいです is unnatural; use たがっています for 3rd party)."
      ],
      "difficulty": 1,
      "level": "N5",
      "prov": {
        "source": "Nihongo N2 Master Editorial Team (Native Review)",
        "license": "CC-BY-4.0",
        "status": "reviewed",
        "updatedAt": "2026-10-01T00:00:00Z",
        "rev": 2
      }
    },
    {
      "id": "n5.l14.g002",
      "lessonId": "n5.l14",
      "pattern": "[Place] へ [Verb stem / Noun] に 行きます / 来ます",
      "meaning": "Go / Come to [Place] to [Purpose]",
      "formation": "Place + へ + Verb stem / Action Noun + に + 行きます/来ます/帰ります",
      "explanation": {
        "en": "The particle に after a verb stem or action noun indicates the explicit purpose of motion.",
        "my": "နေရာဌာနသို့ တစ်စုံတစ်ခုပြုလုပ်ရန် သွားခြင်း၊ လာခြင်း ရည်ရွယ်ချက်ကို 「〜へ〜に行きます」 (ပြုလုပ်ရန် သွားသည်) ဖြင့် ဖော်ပြသည်။"
      },
      "examples": [
        {
          "sentenceId": "n5.l14.s002",
          "note": "Basic usage"
        },
        {
          "sentenceId": "n5.l14.s003",
          "note": "Conversational context"
        }
      ],
      "similarGrammarIds": [],
      "commonMistakes": [
        "Remember to drop ます from the verb: 買いに行きます (correct), NOT *買いますに行きます."
      ],
      "difficulty": 1,
      "level": "N5",
      "prov": {
        "source": "Nihongo N2 Master Editorial Team (Native Review)",
        "license": "CC-BY-4.0",
        "status": "reviewed",
        "updatedAt": "2026-10-01T00:00:00Z",
        "rev": 2
      }
    }
  ],
