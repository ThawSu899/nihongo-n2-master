  "grammars": [
    {
      "id": "n5.l24.g001",
      "lessonId": "n5.l24",
      "pattern": "[Plain Form / Quote] と 言いました",
      "meaning": "Said that...",
      "formation": "[Plain Form] と 言いました / 「Direct Quote」 と 言いました",
      "explanation": {
        "en": "Used for both indirect and direct quotations: 田中さんは「明日休みます」と言いました (Tanaka said, \"I will take off tomorrow\"). Indirect: 田中さんは明日休むと言いました (Tanaka said that he will take off tomorrow).",
        "my": "ပြောဆိုခဲ့သောစကားများကို တိုက်ရိုက် သို့မဟုတ် သွယ်ဝိုက်၍ ပြန်လည်ဖော်ပြရာတွင် 「ရိုးရိုးပုံစံ (Plain form) + と言いました」 (...ဟု ပြောခဲ့သည်) သုံးသည်။"
      },
      "examples": [
        {
          "sentenceId": "n5.l24.s001",
          "note": "Direct and indirect reporting"
        },
        {
          "sentenceId": "n5.l24.s003",
          "note": "Reporting boss statement"
        }
      ],
      "similarGrammarIds": [],
      "commonMistakes": [
        "When quoting indirectly, remember to convert the clause to plain form: 行きます → 行くと言いました."
      ],
      "difficulty": 1,
      "level": "N5",
      "prov": {
        "source": "Nihongo N2 Master Editorial Team (Native Review)",
        "license": "CC-BY-4.0",
        "status": "reviewed",
        "updatedAt": "2026-10-01T00:00:00Z",
        "rev": 2
      }
    },
    {
      "id": "n5.l24.g002",
      "lessonId": "n5.l24",
      "pattern": "[Plain Form] でしょう / だろう",
      "meaning": "Probably / Right? Isn't it?",
      "formation": "Verb/Adj Plain Form (no だ for Nouns and な-adj) + でしょう / だろう",
      "explanation": {
        "en": "With rising intonation, asks the listener to agree: 明日は晴れるでしょう？ (It will be sunny tomorrow, right?). With falling intonation, expresses a polite conjecture: 明日は雨が降るでしょう (It will probably rain tomorrow).",
        "my": "လေသံမြင့်၍ ပြောလျှင် အခြားသူထံမှ ထောက်ခံချက်တောင်းခြင်း (...မဟုတ်လား) ဖြစ်ပြီး၊ လေသံနှိမ့်၍ ပြောလျှင် ယဉ်ကျေးသော ခန့်မှန်းချက် (...ဖြစ်လောက်မည်) ဖြစ်သည်။ နာမ်နှင့် な-adjective တွင် 「だ」 မပါဘဲ တွဲရသည် (e.g. 暇でしょう)."
      },
      "examples": [
        {
          "sentenceId": "n5.l24.s006",
          "note": "Weather conjecture"
        },
        {
          "sentenceId": "n5.l24.s007",
          "note": "Seeking agreement on game"
        }
      ],
      "similarGrammarIds": [],
      "commonMistakes": [
        "Do not put だ before でしょう (*雨だでしょう is wrong; say 雨でしょう)."
      ],
      "difficulty": 1,
      "level": "N5",
      "prov": {
        "source": "Nihongo N2 Master Editorial Team (Native Review)",
        "license": "CC-BY-4.0",
        "status": "reviewed",
        "updatedAt": "2026-10-01T00:00:00Z",
        "rev": 2
      }
    }
  ],
