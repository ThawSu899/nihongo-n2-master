    {
      "id": "n5.l20.g001",
      "lessonId": "n5.l20",
      "pattern": "[Verb-ta] ことが あります",
      "meaning": "Have done [Verb] before (Experience)",
      "formation": "Verb (た-form) + ことが + あります / ありません",
      "explanation": {
        "en": "Describes past personal life experience: 富士山に登ったことがあります (I have climbed Mt. Fuji before). Negative: 一度も〜たことがありません (Never done once).",
        "my": "အတိတ်က အတွေ့အကြုံရှိဖူးခြင်းကို 「ကြိယာ た-form + ことがあります」 (...ဖူးသည်) ဖြင့် ဖော်ပြသည်။ တစ်ကြိမ်မျှမရှိပါက 「一度も〜ありません」 ဖြစ်သည်။"
      },
      "examples": [
        {
          "sentenceId": "n5.l20.s001",
          "note": "Basic usage"
        },
        {
          "sentenceId": "n5.l20.s002",
          "note": "Conversational context"
        }
      ],
      "similarGrammarIds": [],
      "commonMistakes": [
        "Do NOT use for recent routine past events (e.g. for \"I ate lunch an hour ago\", say 食べました, NOT *食べたことがあります)."
      ],
