  "grammars": [
    {
      "id": "n4.l21.g001",
      "lessonId": "n4.l21",
      "pattern": "[Plain form / Noun / Na-adj stem] + らしい",
      "meaning": "Hearsay / Conjecture based on external information or rumors (\"Apparently / I hear that...\")",
      "formation": "Verbs (Plain form) + らしい (行くらしい, 行かないらしい)\ni-adjectives (Plain form) + らしい (高いらしい)\nna-adjectives (Stem) + らしい (*no だ: 静からしい)\nNouns + らしい (*no だ: 雨らしい, 病気らしい)",
      "explanation": {
        "en": "Used when the speaker forms a conjecture or relays hearsay based on external evidence, rumors, media reports, or other people's words. Unlike 〜そうだ (which simply relays an identified source: ニュースによると〜そうだ), 〜らしい conveys that the speaker assesses the rumor as having objective credibility (\"It seems to be true that... / Apparently...\").",
