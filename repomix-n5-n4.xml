  "grammars": [
    {
      "id": "n5.l29.g001",
      "lessonId": "n5.l29",
      "pattern": "[Clause] から vs [Clause] ので",
      "meaning": "Because / Since (Subjective vs Objective polite)",
      "formation": "[Plain/Polite] から / [Plain (な for な-adj & Nouns)] ので",
      "explanation": {
        "en": "Both express reasons. から emphasizes the speaker's subjective personal viewpoint, feelings, or justifications, and can be followed by requests or commands (寒いから窓を閉めてください). ので presents the reason objectively and politely as an unavoidable natural cause, making it standard for business apologies, polite requests, and social excuses (電車が遅れたので、遅刻しました).",
        "my": "နှစ်ခုစလုံး အကြောင်းပြချက်ကို ဖော်ပြသည်။ 「から」 သည် ပြောသူ၏ ကိုယ်ပိုင်ထင်မြင်ချက်၊ ခံစားချက်ကို အဓိကထားပြီး၊ 「ので」 သည် လူမှုရေးအရ ယဉ်ကျေးသိမ်မွေ့သော သဘာဝအကြောင်းပြချက်အဖြစ် တင်ပြရာတွင် သုံးသည် (e.g. အလုပ်နောက်ကျခြင်း၊ တောင်းပန်ခြင်းစကားများတွင် 「ので」 သုံးသည်)."
      },
      "examples": [
        {
          "sentenceId": "n5.l29.s002",
          "note": "Objective reason with ので"
        },
        {
          "sentenceId": "n5.l29.s009",
          "note": "Subjective reason with から"
        }
      ],
      "similarGrammarIds": [],
      "commonMistakes": [
        "Before ので, for な-adjectives and nouns, use な, NOT だ (暇なので, NOT *暇だので; 雨なので, NOT *雨だので)."
      ],
      "difficulty": 1,
