  "grammars": [
    {
      "id": "n5.l25.g001",
      "lessonId": "n5.l25",
      "pattern": "[Clause: Verb Plain Form] + Noun",
      "meaning": "Noun modified by a relative clause",
      "formation": "Verb Plain Form (Dict / ない / た / なかった) + Noun",
      "explanation": {
        "en": "In Japanese, relative clauses always come BEFORE the noun they modify, with no relative pronoun (who, which, that). Inside the modifying clause, the subject is marked with が instead of は: 母が作った料理 (The dish that my mother made).",
        "my": "နာမ်တစ်ခုကို ကြိယာဝါကျဖြင့် အထူးပြုရာတွင် 「ကြိယာ ရိုးရိုးပုံစံ (Plain form) + နာမ်」 ဖြစ်ပြီး နာမ်၏ အရှေ့တွင် ထားရသည်။ ဝါကျတွင်း ကတ္တားကို 「は」 အစား 「が」 ဖြင့် ပြရသည် (e.g. 母が作った料理 - အမေချက်ထားသော ဟင်းလျာ)."
      },
      "examples": [
        {
          "sentenceId": "n5.l25.s001",
          "note": "Modified object"
        },
        {
          "sentenceId": "n5.l25.s003",
          "note": "Subject marked with が inside clause"
        }
      ],
      "similarGrammarIds": [],
      "commonMistakes": [
        "言わない! (မှားယွင်းသုံးစွဲတတ်သော ပုံစံ) - × 帽子を着る မဟုတ်ပါ၊ ○ 帽子をかぶる သာ ဖြစ်ပါသည်။ (Hats take かぶる, upper-body clothes take 着る).",
        "Do not use は for the subject inside the modifying clause (*母は作った料理 is incorrect; use 母が作った料理). Do not put polite form before the noun (*買いました本 is incorrect; say 買った本)."
      ],
      "difficulty": 1,
      "level": "N5",
      "prov": {
        "source": "Nihongo N2 Master Editorial Team (Native Review)",
        "license": "CC-BY-4.0",
