  "grammars": [
    {
      "id": "n5.l27.g001",
      "lessonId": "n5.l27",
      "pattern": "[V-ta / A-katta / N-datta] ら、〜",
      "meaning": "If / When...",
      "formation": "Verb (た-form) + ら / い-adj (〜かった) + ら / な-adj & Noun (〜だった) + ら",
      "explanation": {
        "en": "The most versatile conditional pattern in Japanese. Can express hypothetical conditions (if) or temporal triggers (when/once): 雨が降ったら行きません (If it rains, I won't go), 駅に着いたら電話してください (When you arrive at the station, please call me). Unlike と, the main clause CAN contain requests or invitations.",
        "my": "ဂျပန်ဘာသာတွင် အသုံးအများဆုံး အခြေအနေပြဝါကျပုံစံ ဖြစ်သည်။ 「ကြိယာ た-form + ら」 (...လျှင် / ...ပြီးသောအခါ) ဟု သုံးပြီး နောက်ဝါကျတွင် တောင်းဆိုချက် (〜てください) သို့မဟုတ် ဖိတ်ခေါ်ချက်များ ထည့်သွင်းနိုင်သည်။"
      },
      "examples": [
        {
          "sentenceId": "n5.l27.s001",
          "note": "Hypothetical condition"
        },
        {
          "sentenceId": "n5.l27.s005",
          "note": "Temporal trigger with request"
        }
      ],
      "similarGrammarIds": [],
      "commonMistakes": [
        "Form it from the た-form, not dictionary form (*行くら is incorrect; say 行ったら)."
      ],
