<file path="src/presentation/components/CommandPaletteModal.tsx">
import React, { useState, useEffect, useRef } from 'react';
import { motion, AnimatePresence } from 'framer-motion';
import {
  Search,
  X,
  BookOpen,
  Layers,
  Sparkles,
  ArrowRight,
  Plus,
  BookmarkCheck,
  Volume2,
  CheckCircle2,
  CornerDownLeft,
} from 'lucide-react';
import {
  QuickSearchEngine,
  QuickSearchResult,
} from '../../domain/search/quick-search-engine';
import { KanjiDetail } from '../../domain/dictionary/kanji-catalog';
import { db } from '../../data/db/dexie-db';
import { SRSCard } from '../../domain/models/types';

interface CommandPaletteModalProps {
  isOpen: boolean;
  onClose: () => void;
  onInspectKanji?: (kanji: KanjiDetail) => void;
  onOpenReference?: (tab: 'counters' | 'expressions' | 'mistakes') => void;
}

export const CommandPaletteModal: React.FC<CommandPaletteModalProps> = ({
  isOpen,
  onClose,
  onInspectKanji,
  onOpenReference,
}) => {
  const [query, setQuery] = useState('');
  const [results, setResults] = useState<QuickSearchResult[]>([]);
  const [selectedIndex, setSelectedIndex] = useState(0);
  const [loading, setLoading] = useState(false);
  const [minedSet, setMinedSet] = useState<Set<string>>(new Set());
  const [toastMessage, setToastMessage] = useState<string | null>(null);

  const inputRef = useRef<HTMLInputElement>(null);
  const resultsContainerRef = useRef<HTMLDivElement>(null);

  // Focus input upon open
  useEffect(() => {
    if (isOpen) {
      setQuery('');
      setResults([]);
      setSelectedIndex(0);
      setTimeout(() => inputRef.current?.focus(), 50);
    }
  }, [isOpen]);

  // Global keydown listener for palette shortcuts
  useEffect(() => {
    if (!isOpen) return;

    const handleKeyDown = (e: KeyboardEvent) => {
      if (e.key === 'Escape') {
        e.preventDefault();
        onClose();
      } else if (e.key === 'ArrowDown') {
        e.preventDefault();
        setSelectedIndex((prev) => (results.length > 0 ? (prev + 1) % results.length : 0));
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        setSelectedIndex((prev) =>
          results.length > 0 ? (prev - 1 + results.length) % results.length : 0
        );
      } else if (e.key === 'Enter') {
        e.preventDefault();
        if (results[selectedIndex]) {
          handleSelectResult(results[selectedIndex]);
        }
      }
    };

    window.addEventListener('keydown', handleKeyDown);
    return () => window.removeEventListener('keydown', handleKeyDown);
  }, [isOpen, results, selectedIndex, onClose]);

  // Debounced search querying
  useEffect(() => {
    if (!query.trim()) {
      setResults([]);
      setLoading(false);
      return;
    }

    setLoading(true);
    const timer = setTimeout(async () => {
      const res = await QuickSearchEngine.search(query);
      setResults(res);
      setSelectedIndex(0);
      setLoading(false);
    }, 150);

    return () => clearTimeout(timer);
  }, [query]);

  // Handle action on result item
  const handleSelectResult = (item: QuickSearchResult) => {
    if (item.category === 'kanji' && item.kanjiData && onInspectKanji) {
      onInspectKanji(item.kanjiData);
      onClose();
    } else if (item.referenceTab && onOpenReference) {
      onOpenReference(item.referenceTab);
      onClose();
    } else {
      // 1-Click mine to SRS
      handleAddResultToSRS(item);
    }
  };

  // 1-Click Add item to SRS
  const handleAddResultToSRS = async (item: QuickSearchResult) => {
    try {
      const profile = await db.profile.get('current_user');
      const activeDeckId = profile?.currentLessonId || 'n2.quick_search';

      const cardId = `quick_${item.category}_${item.title}_${Date.now()}`;
      const newCard: SRSCard = {
        id: cardId,
        itemId: `item_${item.title}`,
        lessonId: activeDeckId,
        itemType: item.category === 'kanji' ? 'kanji' : item.category === 'grammar' ? 'grammar' : 'vocab',
        facet: 'meaning',
        prompt: item.title,
        reading: item.reading || item.title,
        meaning: item.meaningEn,
        state: 'new',
        intervalDays: 1,
        repetition: 0,
        stability: 1.0,
        difficulty: 3,
        lapses: 0,
        isLeech: false,
        due: new Date().toISOString(),
      };

      const existing = await db.srs_cards.where('itemId').equals(`item_${item.title}`).first();
      if (!existing) {
        await db.srs_cards.add(newCard);
      }

      setMinedSet((prev) => new Set([...prev, item.id]));
      setToastMessage(`「${item.title}」をSRSキューに追加しました`);
      setTimeout(() => setToastMessage(null), 2500);
    } catch (err) {
      console.error('Failed to add card from search:', err);
    }
  };

  // Native Speech
  const handleSpeak = (text: string, e: React.MouseEvent) => {
    e.stopPropagation();
    if (typeof window === 'undefined' || !('speechSynthesis' in window)) return;
    window.speechSynthesis.cancel();
    const utterance = new SpeechSynthesisUtterance(text);
    utterance.lang = 'ja-JP';
    utterance.rate = 0.9;
    window.speechSynthesis.speak(utterance);
  };

  if (!isOpen) return null;

  return (
    <AnimatePresence>
      <div className="fixed inset-0 z-50 flex items-start justify-center pt-16 sm:pt-24 px-4 select-none">
        {/* Backdrop */}
        <motion.div
          initial={{ opacity: 0 }}
          animate={{ opacity: 1 }}
          exit={{ opacity: 0 }}
          onClick={onClose}
          className="fixed inset-0 bg-black/70 backdrop-blur-md cursor-pointer"
        />

        {/* Modal Window */}
        <motion.div
          initial={{ opacity: 0, scale: 0.96, y: -16 }}
          animate={{ opacity: 1, scale: 1, y: 0 }}
          exit={{ opacity: 0, scale: 0.96, y: -16 }}
          transition={{ duration: 0.2, ease: 'easeOut' }}
          className="relative z-10 w-full max-w-2xl bg-zinc-950/95 backdrop-blur-2xl border border-zinc-800/80 rounded-2xl shadow-[0_20px_60px_rgba(0,0,0,0.9)] overflow-hidden flex flex-col max-h-[80vh]"
        >
          {/* Search Header */}
          <div className="p-4 border-b border-zinc-800/80 flex items-center gap-3">
            <Search className="w-5 h-5 text-zinc-400 shrink-0" />
            <input
              ref={inputRef}
              type="text"
              value={query}
              onChange={(e) => setQuery(e.target.value)}
              placeholder="Search Kanji, Vocabulary, N2 Grammar, or Leeches (e.g. 契, 把握, 契機, わけには)..."
              className="flex-1 bg-transparent text-sm sm:text-base text-zinc-100 placeholder:text-zinc-500 focus:outline-none font-japanese"
            />
            {query && (
              <button
                onClick={() => setQuery('')}
                className="text-zinc-500 hover:text-zinc-300 p-1 rounded"
              >
                <X className="w-4 h-4" />
              </button>
            )}
            <kbd className="hidden sm:inline-block px-2 py-0.5 rounded bg-zinc-900 border border-zinc-800 text-[10px] text-zinc-400 font-mono">
              ESC
            </kbd>
          </div>

          {/* Toast Notification */}
          {toastMessage && (
            <div className="bg-emerald-950/90 border-b border-emerald-500/40 text-emerald-300 px-4 py-2 text-xs flex items-center gap-2 shadow-[0_0_16px_rgba(16,185,129,0.25)]">
              <CheckCircle2 className="w-4 h-4 text-emerald-400 shrink-0" />
              <span>{toastMessage}</span>
            </div>
          )}

          {/* Results List */}
          <div ref={resultsContainerRef} className="flex-1 overflow-y-auto p-2 sm:p-3 space-y-1">
            {loading && (
              <div className="py-8 text-center text-xs text-zinc-500 font-mono">
                Searching curriculum database...
              </div>
            )}

            {!loading && query.trim() && results.length === 0 && (
              <div className="py-12 text-center space-y-2">
                <p className="text-sm text-zinc-400">No results found for &ldquo;{query}&rdquo;</p>
                <p className="text-xs text-zinc-500">
                  Try searching by Kanji character, English meaning, or Japanese reading.
                </p>
              </div>
            )}

            {!query.trim() && (
              <div className="py-10 px-6 text-center space-y-3">
                <div className="flex justify-center gap-3">
                  <span className="px-2.5 py-1 rounded-lg bg-zinc-900 border border-zinc-800 text-xs text-zinc-400 font-mono">
                    漢字 · Kanji
                  </span>
                  <span className="px-2.5 py-1 rounded-lg bg-zinc-900 border border-zinc-800 text-xs text-zinc-400 font-mono">
                    語彙 · Vocabulary
                  </span>
                  <span className="px-2.5 py-1 rounded-lg bg-zinc-900 border border-zinc-800 text-xs text-zinc-400 font-mono">
                    文法 · N2 Grammar
                  </span>
                </div>
                <p className="text-xs text-zinc-500 max-w-sm mx-auto leading-relaxed">
                  Type any keyword to query all JLPT N2 curriculum items, official dokkai glossary terms, and your active SRS flashcard deck instantly.
                </p>
              </div>
            )}

            {results.map((item, index) => {
              const isSelected = selectedIndex === index;
              const isMined = minedSet.has(item.id);

              let badgeColor = 'bg-zinc-800 text-zinc-300 border-zinc-700';
              if (item.category === 'kanji') {
                badgeColor = 'bg-rose-950/60 text-rose-300 border-rose-500/30';
              } else if (item.category === 'grammar') {
                badgeColor = 'bg-indigo-950/60 text-indigo-300 border-indigo-500/30';
              } else if (item.category === 'srs_card') {
                badgeColor = 'bg-amber-950/60 text-amber-300 border-amber-500/30';
              } else if (item.category === 'counter') {
                badgeColor = 'bg-rose-950/70 text-rose-300 border-rose-500/40';
              } else if (item.category === 'expression') {
                badgeColor = 'bg-indigo-950/70 text-indigo-300 border-indigo-500/40';
              } else if (item.category === 'trap') {
                badgeColor = 'bg-amber-950/80 text-amber-300 border-amber-500/50';
              } else {
                badgeColor = 'bg-sky-950/60 text-sky-300 border-sky-500/30';
              }

              return (
                <div
                  key={item.id}
                  onClick={() => handleSelectResult(item)}
                  onMouseEnter={() => setSelectedIndex(index)}
                  className={`p-3 rounded-xl border transition cursor-pointer flex items-center justify-between gap-3 ${
                    isSelected
                      ? 'bg-zinc-900/90 border-indigo-500/60 shadow-[0_0_16px_rgba(99,102,241,0.25)]'
                      : 'bg-zinc-900/40 border-zinc-800/60 hover:bg-zinc-900/70'
                  }`}
                >
                  <div className="flex items-center gap-3.5 min-w-0">
                    {/* Leading Badge / Char */}
                    <div className="w-10 h-10 rounded-xl bg-zinc-950 border border-zinc-800 flex items-center justify-center shrink-0 shadow-inner">
                      <span className="text-lg font-bold font-japanese text-zinc-100">
                        {item.title.slice(0, 2)}
                      </span>
                    </div>

                    <div className="space-y-0.5 min-w-0">
                      <div className="flex items-center gap-2">
                        <span className="font-bold text-sm text-zinc-100 font-japanese truncate">
                          {item.title}
                        </span>
                        {item.reading && (
                          <span className="text-xs text-rose-300 font-japanese truncate">
                            【{item.reading}】
                          </span>
                        )}
                        <span
                          className={`text-[10px] font-mono px-2 py-0.5 rounded-full border ${badgeColor}`}
                        >
                          {item.badge}
                        </span>
                      </div>

                      <p className="text-xs text-zinc-400 truncate">{item.meaningEn}</p>
                      {item.meaningMy && (
                        <p className="text-[11px] text-amber-300/80 font-myanmar truncate">
                          {item.meaningMy}
                        </p>
                      )}
                    </div>
                  </div>

                  {/* Right Actions */}
                  <div className="flex items-center gap-2 shrink-0">
                    <button
                      onClick={(e) => handleSpeak(item.title, e)}
                      className="p-1.5 rounded-lg bg-zinc-800/80 hover:bg-zinc-700 text-zinc-400 hover:text-zinc-200 transition"
                      title="Pronounce"
                    >
                      <Volume2 className="w-3.5 h-3.5" />
                    </button>

                    {item.category === 'kanji' && (
                      <button
                        onClick={(e) => {
                          e.stopPropagation();
                          if (item.kanjiData && onInspectKanji) {
                            onInspectKanji(item.kanjiData);
                            onClose();
                          }
                        }}
                        className="px-2 py-1 rounded-lg bg-rose-950/60 hover:bg-rose-900/80 text-rose-300 border border-rose-500/30 text-xs font-semibold flex items-center gap-1 transition"
                        title="Open in Kanji Drawer"
                      >
                        <span>Inspect</span>
                        <ArrowRight className="w-3 h-3" />
                      </button>
                    )}

                    {item.referenceTab && (
                      <button
                        onClick={(e) => {
                          e.stopPropagation();
                          if (onOpenReference && item.referenceTab) {
                            onOpenReference(item.referenceTab);
                            onClose();
                          }
                        }}
                        className="px-2 py-1 rounded-lg bg-amber-950/60 hover:bg-amber-900/80 text-amber-300 border border-amber-500/40 text-xs font-semibold flex items-center gap-1 transition cursor-pointer"
                        title="Open in N5 Reference Workbench"
                      >
                        <span>Open Ref</span>
                        <ArrowRight className="w-3 h-3 text-amber-400" />
                      </button>
                    )}

                    <button
                      onClick={(e) => {
                        e.stopPropagation();
                        handleAddResultToSRS(item);
                      }}
                      className={`px-2.5 py-1 rounded-lg text-xs font-semibold flex items-center gap-1 transition ${
                        isMined
                          ? 'bg-emerald-950/80 text-emerald-300 border border-emerald-600/70'
                          : 'bg-zinc-800 hover:bg-zinc-700 text-zinc-200 border border-zinc-700'
                      }`}
                      title="Add to active SRS queue"
                    >
                      {isMined ? (
                        <>
                          <BookmarkCheck className="w-3.5 h-3.5 text-emerald-400" />
                          <span>Added</span>
                        </>
                      ) : (
                        <>
                          <Plus className="w-3.5 h-3.5" />
                          <span>Add SRS</span>
                        </>
                      )}
                    </button>
                  </div>
                </div>
              );
            })}
          </div>

          {/* Modal Footer Hotkeys */}
          <div className="p-3 bg-zinc-950 border-t border-zinc-800/80 flex items-center justify-between text-[11px] text-zinc-500 font-mono">
            <div className="flex items-center gap-3">
              <span>Navigate: <kbd className="text-zinc-400">↑</kbd> <kbd className="text-zinc-400">↓</kbd></span>
              <span>Select: <kbd className="text-zinc-400">↵</kbd></span>
              <span>Close: <kbd className="text-zinc-400">ESC</kbd></span>
            </div>
            <div>
              <span>JLPT N2 Command Palette</span>
            </div>
          </div>
        </motion.div>
      </div>
    </AnimatePresence>
  );
};
</file>

<file path="src/presentation/components/DailyTargetStreakWidget.tsx">
import React, { useState, useEffect, useMemo, useCallback } from 'react';
import {
  Flame,
  CheckCircle2,
  Calendar,
  Sparkles,
  Trophy,
  Snowflake,
  ArrowRight,
  TrendingUp,
} from 'lucide-react';
import {
  WeeklyHabitDay,
  calculateLongestStreak,
  getWeeklyHabitHistory,
  getLogicalDayKey,
} from '../../domain/analytics/streak-calculator';
import { db } from '../../data/db/dexie-db';

export interface DailyTargetStreakWidgetProps {
  currentStreak?: number;
  longestStreak?: number;
  todayCompletedCount?: number;
  defaultTarget?: number;
  onTargetChange?: (newTarget: number) => void;
  weeklyHistory?: WeeklyHabitDay[];
  isStreakProtected?: boolean;
  onStartStudy?: () => void;
  className?: string;
}

const TARGET_PRESETS = [15, 30, 50];
const STORAGE_TARGET_KEY = 'nihongo_daily_target_words';
const STORAGE_FREEZE_KEY = 'nihongo_streak_freeze';

export const DailyTargetStreakWidget: React.FC<DailyTargetStreakWidgetProps> = ({
  currentStreak: propStreak,
  longestStreak: propLongest,
  todayCompletedCount: propCompleted,
  defaultTarget = 30,
  onTargetChange,
  weeklyHistory: propWeekly,
  isStreakProtected: propProtected,
  onStartStudy,
  className = '',
}) => {
  // Target Setting State (Persisted to localStorage)
  const [target, setTarget] = useState<number>(() => {
    if (typeof window !== 'undefined') {
      const saved = localStorage.getItem(STORAGE_TARGET_KEY);
      if (saved) {
        const parsed = parseInt(saved, 10);
        if (TARGET_PRESETS.includes(parsed)) return parsed;
      }
    }
    return defaultTarget;
  });

  // Local Hydrated State from Dexie DB
  const [dbStreak, setDbStreak] = useState<number>(propStreak ?? 0);
  const [dbLongest, setDbLongest] = useState<number>(propLongest ?? 0);
  const [dbCompletedToday, setDbCompletedToday] = useState<number>(propCompleted ?? 0);
  const [dbWeeklyHistory, setDbWeeklyHistory] = useState<WeeklyHabitDay[]>(propWeekly ?? []);
  const [isProtected, setIsProtected] = useState<boolean>(() => {
    if (propProtected !== undefined) return propProtected;
    if (typeof window !== 'undefined') {
      return localStorage.getItem(STORAGE_FREEZE_KEY) === 'true';
    }
    return false;
  });

  // Query DB asynchronously for live stats
  useEffect(() => {
    let isCancelled = false;

    const loadLiveStats = async () => {
      try {
        const sessions = await db.study_sessions.toArray();
        const longest = calculateLongestStreak(sessions);
        const weekly = getWeeklyHabitHistory(sessions);

        // Calculate today's reviews/exercises
        const now = new Date();
        const todayKey = getLogicalDayKey(now, 4);

        let todayCount = 0;
        // Count from review_logs
        const reviews = await db.review_logs.toArray();
        for (const r of reviews) {
          if (r.reviewedAt && getLogicalDayKey(r.reviewedAt, 4) === todayKey) {
            todayCount++;
          }
        }

        // Add from sessions if reviews are 0
        if (todayCount === 0) {
          for (const s of sessions) {
            if (s.startedAt && getLogicalDayKey(s.startedAt, 4) === todayKey) {
              todayCount += s.exercisesCompleted || 0;
            }
          }
        }

        if (!isCancelled) {
          if (propLongest === undefined) setDbLongest(longest);
          if (propWeekly === undefined) setDbWeeklyHistory(weekly);
          if (propCompleted === undefined) setDbCompletedToday(todayCount);
        }
      } catch {
        // Fallback gracefully in test/SSR environments
      }
    };

    loadLiveStats();

    return () => {
      isCancelled = true;
    };
  }, [propLongest, propWeekly, propCompleted]);

  // Sync prop changes
  useEffect(() => {
    if (propStreak !== undefined) setDbStreak(propStreak);
  }, [propStreak]);

  useEffect(() => {
    if (propLongest !== undefined) setDbLongest(propLongest);
  }, [propLongest]);

  useEffect(() => {
    if (propCompleted !== undefined) setDbCompletedToday(propCompleted);
  }, [propCompleted]);

  useEffect(() => {
    if (propWeekly !== undefined) setDbWeeklyHistory(propWeekly);
  }, [propWeekly]);

  useEffect(() => {
    if (propProtected !== undefined) setIsProtected(propProtected);
  }, [propProtected]);

  // Target change handler
  const handleSetTarget = useCallback(
    (newTarget: number) => {
      setTarget(newTarget);
      if (typeof window !== 'undefined') {
        localStorage.setItem(STORAGE_TARGET_KEY, String(newTarget));
      }
      onTargetChange?.(newTarget);
    },
    [onTargetChange]
  );

  const effectiveStreak = propStreak !== undefined ? propStreak : dbStreak;
  const effectiveLongest = Math.max(
    effectiveStreak,
    propLongest !== undefined ? propLongest : dbLongest
  );
  const effectiveCompleted = propCompleted !== undefined ? propCompleted : dbCompletedToday;

  const percent = Math.min(100, Math.round((effectiveCompleted / target) * 100));
  const isGoalAchieved = effectiveCompleted >= target;

  // Fallback 7-day matrix if history not yet populated
  const displayWeekly: WeeklyHabitDay[] = useMemo(() => {
    if (dbWeeklyHistory && dbWeeklyHistory.length === 7) {
      return dbWeeklyHistory;
    }
    const days = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
    return days.map((d, i) => ({
      day: d,
      date: `2026-11-0${i + 1}`,
      completed: i < effectiveStreak,
      isToday: i === 6,
      count: i < effectiveStreak ? 1 : 0,
    }));
  }, [dbWeeklyHistory, effectiveStreak]);

  // SVG Circular progress math (r=38, circumference=238.76)
  const radius = 38;
  const circumference = 2 * Math.PI * radius;
  const strokeOffset = circumference - (percent / 100) * circumference;

  return (
    <section
      aria-label="Daily Target and Study Streak Dashboard"
      className={`w-full bg-zinc-900/80 backdrop-blur-xl border border-zinc-800 rounded-3xl p-5 sm:p-6 shadow-2xl space-y-5 ${className}`}
    >
      {/* Header Bar */}
      <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-zinc-800/80 pb-4">
        <div className="flex items-center gap-3">
          <div className="p-2.5 rounded-2xl bg-amber-500/10 border border-amber-500/30 text-amber-400 shrink-0 shadow-[0_0_16px_rgba(245,158,11,0.2)]">
            <Flame className="w-5 h-5 text-amber-400 animate-pulse" />
          </div>
          <div>
            <h3 className="text-zinc-100 font-bold text-base sm:text-lg flex items-center gap-2">
              <span>Daily Target &amp; Study Streak</span>
              {isProtected && (
                <span className="text-[10px] font-mono font-medium text-cyan-300 bg-cyan-950/80 border border-cyan-500/40 px-2 py-0.5 rounded-full flex items-center gap-1 shadow-xs">
                  <Snowflake className="w-3 h-3 text-cyan-300" />
                  <span>Protected</span>
                </span>
              )}
            </h3>
            <p className="text-zinc-400 text-xs font-burmese mt-0.5">
              နေ့စဉ် လေ့လာရေး ပန်းတိုင်နှင့် ရက်ဆက် လေ့လာမှု အလေ့အကျင့်
            </p>
          </div>
        </div>

        {/* Quick Goal Selector */}
        <div className="flex items-center gap-2 self-start sm:self-auto">
          <span className="text-[11px] font-mono text-zinc-400 uppercase">Goal:</span>
          <div className="flex items-center gap-1 p-1 bg-zinc-950/80 border border-zinc-800 rounded-xl">
            {TARGET_PRESETS.map((t) => (
              <button
                key={t}
                type="button"
                onClick={() => handleSetTarget(t)}
                className={`px-2.5 py-1 rounded-lg text-xs font-mono font-bold transition cursor-pointer ${
                  target === t
                    ? 'bg-gradient-to-r from-rose-600 to-rose-700 text-white shadow-md shadow-rose-950/60'
                    : 'text-zinc-400 hover:text-zinc-200 hover:bg-zinc-800'
                }`}
                title={`Set daily target to ${t} words`}
              >
                {`${t}w`}
              </button>
            ))}
          </div>
        </div>
      </div>

      {/* 3-Column Bento Grid */}
      <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
        {/* Card 1: Consecutive Study Streak & Flame */}
        <div className="bg-zinc-950/60 border border-amber-500/30 hover:border-amber-500/50 rounded-2xl p-4.5 space-y-3 transition shadow-lg flex flex-col justify-between">
          <div className="flex items-center justify-between">
            <span className="text-xs font-mono font-semibold uppercase tracking-wider text-amber-400 flex items-center gap-1.5">
              <Flame className="w-4 h-4 text-amber-400" /> Study Streak
            </span>
            <span className="text-[10px] font-mono text-amber-300 bg-amber-950/70 border border-amber-500/40 px-2 py-0.5 rounded-full">
              {effectiveStreak > 0 ? 'Active 🔥' : 'Start Today'}
            </span>
          </div>

          <div className="flex items-baseline gap-2">
            <span className="text-4xl font-black font-mono text-zinc-100 tracking-tight text-amber-100 drop-shadow-[0_0_12px_rgba(245,158,11,0.3)]">
              {effectiveStreak}
            </span>
            <span className="text-xs text-amber-400/90 font-medium font-sans">
              {`${effectiveStreak === 1 ? 'Day' : 'Days'} / ရက်ဆက်`}
            </span>
          </div>

          <div className="pt-2 border-t border-zinc-800/80 flex items-center justify-between text-[11px] text-zinc-400 font-mono">
            <span>Longest: <strong className="text-zinc-200">{`${effectiveLongest}d`}</strong></span>
            <span className="text-zinc-500">04:00 AM Rollover</span>
          </div>
        </div>

        {/* Card 2: Today's Target Circular & Linear Progress */}
        <div className="bg-zinc-950/60 border border-zinc-800 hover:border-zinc-700 rounded-2xl p-4.5 transition shadow-lg flex items-center justify-between gap-4">
          <div className="space-y-2 flex-1">
            <div className="flex items-center justify-between text-xs">
              <span className="font-mono text-zinc-400 flex items-center gap-1.5">
                <Trophy className="w-3.5 h-3.5 text-rose-400" /> Today&apos;s Target
              </span>
              <span className="font-mono font-bold text-rose-400">{percent}%</span>
            </div>

            <div className="flex items-baseline gap-1.5">
              <span className="text-2xl font-bold font-mono text-zinc-100">
                {effectiveCompleted}
              </span>
              <span className="text-xs font-mono text-zinc-400">{`/ ${target} words`}</span>
            </div>

            {/* Linear Progress Bar */}
            <div className="w-full bg-zinc-900 rounded-full h-1.5 overflow-hidden border border-zinc-800/80">
              <div
                className="h-full rounded-full bg-gradient-to-r from-rose-600 via-rose-500 to-amber-500 transition-all duration-700 ease-out"
                style={{ width: `${percent}%` }}
              />
            </div>

            <p className="text-[10px] font-burmese text-zinc-400 truncate">
              {isGoalAchieved
                ? '🎉 ယနေ့ ပန်းတိုင် ပြည့်မီပါပြီ!'
                : `ပန်းတိုင်ရောက်ရန် ${Math.max(0, target - effectiveCompleted)} လိုပါသည်`}
            </p>
          </div>

          {/* Circular SVG Ring */}
          <div className="relative w-20 h-20 shrink-0 flex items-center justify-center">
            <svg className="w-full h-full -rotate-90" viewBox="0 0 90 90">
              {/* Background Ring */}
              <circle
                cx="45"
                cy="45"
                r={radius}
                className="stroke-zinc-800/80 fill-none"
                strokeWidth="6"
              />
              {/* Progress Ring */}
              <circle
                cx="45"
                cy="45"
                r={radius}
                className="stroke-rose-500 fill-none transition-all duration-700 ease-out"
                strokeWidth="6"
                strokeLinecap="round"
                strokeDasharray={circumference}
                strokeDashoffset={strokeOffset}
              />
            </svg>
            <div className="absolute inset-0 flex flex-col items-center justify-center text-center">
              <span className="text-xs font-mono font-bold text-zinc-100">{percent}%</span>
              {isGoalAchieved && <CheckCircle2 className="w-3 h-3 text-emerald-400" />}
            </div>
          </div>
        </div>

        {/* Card 3: 7-Day Weekly Habit Matrix */}
        <div className="bg-zinc-950/60 border border-zinc-800 hover:border-zinc-700 rounded-2xl p-4.5 space-y-3 transition shadow-lg flex flex-col justify-between">
          <div className="flex items-center justify-between">
            <span className="text-xs font-mono font-semibold uppercase tracking-wider text-zinc-300 flex items-center gap-1.5">
              <Calendar className="w-4 h-4 text-emerald-400" /> 7-Day Habit Tracker
            </span>
            <span className="text-[10px] font-mono text-zinc-500">
              {`${displayWeekly.filter((w) => w.completed).length}/7 days`}
            </span>
          </div>

          {/* 7-Day Visual Matrix Pills */}
          <div className="grid grid-cols-7 gap-1.5 pt-1">
            {displayWeekly.map((item, idx) => {
              return (
                <div key={`${item.date}-${idx}`} className="flex flex-col items-center gap-1">
                  <div
                    className={`w-8 h-8 rounded-xl flex items-center justify-center text-xs font-mono font-bold transition shadow-xs ${
                      item.completed
                        ? 'bg-emerald-500/20 border border-emerald-500/50 text-emerald-300 shadow-[0_0_8px_rgba(16,185,129,0.25)]'
                        : item.isToday
                        ? 'bg-amber-500/10 border border-amber-500/40 text-amber-300 animate-pulse'
                        : 'bg-zinc-900/80 border border-zinc-800 text-zinc-600'
                    }`}
                    title={`${item.day} (${item.date}): ${
                      item.completed ? 'Study session completed' : 'No study'
                    }`}
                  >
                    {item.completed ? (
                      <CheckCircle2 className="w-3.5 h-3.5 text-emerald-400" />
                    ) : (
                      <span className="text-[10px]">{item.day.slice(0, 1)}</span>
                    )}
                  </div>
                  <span
                    className={`text-[9px] font-mono ${
                      item.isToday ? 'text-amber-400 font-bold' : 'text-zinc-500'
                    }`}
                  >
                    {item.day.slice(0, 3)}
                  </span>
                </div>
              );
            })}
          </div>

          {/* Footer Action */}
          <div className="pt-2 border-t border-zinc-800/80 flex items-center justify-between text-[11px] text-zinc-400">
            <span className="font-burmese text-[10px] truncate">၇ ရက်တာ လေ့လာမှုမှတ်တမ်း</span>
            {onStartStudy && (
              <button
                type="button"
                onClick={onStartStudy}
                className="text-rose-400 hover:text-rose-300 font-mono text-xs flex items-center gap-1 cursor-pointer"
              >
                <span>Study</span>
                <ArrowRight className="w-3 h-3" />
              </button>
            )}
          </div>
        </div>
      </div>
    </section>
  );
};
