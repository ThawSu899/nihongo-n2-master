          "note": "Uncontrollable deep sorrow and grief welling up"
        },
        {
          "sentenceId": "n2.l07.s005",
          "note": "Deep psychological anxiety that naturally persists"
        }
      ],
      "similarGrammarIds": [
        "n2.l07.g001"
      ],
      "commonMistakes": [
        "Do not use for physical desires like 'I want to drink water'; 〜てならない is reserved for mental and emotional states."
      ],
      "difficulty": 4,
      "level": "N2",
      "prov": {
        "source": "Nihongo N2 Master Editorial Team",
