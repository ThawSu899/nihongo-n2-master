                      reviewFilter === 'missed'
                        ? 'bg-rose-950 text-rose-300 border border-rose-800 font-bold'
                        : 'text-stone-400 hover:text-stone-200'
                    }`}
                  >
                    Missed Only ({scoreReport.missedQuestionIds.length})
                  </button>
                </div>
              </div>

              {/* Scrollable list of questions */}
              <div className="max-h-60 overflow-y-auto space-y-2 pr-1">
                {scoreReport.answers
                  .filter((a) => {
                    if (reviewFilter === 'missed') return !a.isCorrect;
                    if (reviewFilter === 'flagged') return a.isFlaggedForReview;
                    return true;
                  })
                  .map((ans, idx) => {
                    const allQ = [...examData.section1Questions, ...examData.section2Questions];
                    const qMeta = allQ.find((q) => q.question.id === ans.questionId);
                    if (!qMeta) return null;

                    return (
                      <div
                        key={ans.questionId}
                        className={`p-3 rounded-xl border text-xs space-y-1.5 ${
                          ans.isCorrect
                            ? 'bg-stone-950/60 border-stone-800'
                            : 'bg-rose-950/20 border-rose-900/60'
                        }`}
                      >
                        <div className="flex items-center justify-between">
                          <span className="font-japanese font-semibold text-stone-200">
                            #{qMeta.index} · {qMeta.mondaiTitleJa}
                          </span>
                          <span
                            className={`font-mono font-bold flex items-center space-x-1 ${
                              ans.isCorrect ? 'text-emerald-400' : 'text-rose-400'
                            }`}
                          >
                            {ans.isCorrect ? (
                              <>
                                <Check className="w-3.5 h-3.5" />
                                <span>အဖြေမှန် (Correct)</span>
                              </>
                            ) : (
                              <>
                                <X className="w-3.5 h-3.5" />
                                <span>အဖြေမှား (Incorrect)</span>
                              </>
                            )}
                          </span>
                        </div>

                        <p className="text-stone-300 font-japanese line-clamp-2">
                          {qMeta.question.prompt.replace(/<[^>]+>/g, '')}
                        </p>

                        <div className="text-[11px] flex items-center space-x-3 text-stone-400 pt-1 border-t border-stone-800/80">
                          <span>
                            Your choice: <strong>{ans.selectedChoice || '(Unanswered)'}</strong>
                          </span>
                          <span>•</span>
                          <span>
                            အဖြေမှန် (Correct): <strong>{qMeta.question.answer}</strong>
                          </span>
                        </div>
                      </div>
                    );
                  })}
              </div>
            </div>

            {/* Bottom Actions: Remediation Drill CTA & Exit */}
            <div className="flex flex-col sm:flex-row items-center justify-between gap-3 pt-4 border-t border-stone-800">
              {scoreReport.missedQuestionIds.length > 0 && onLaunchRemediationDrill ? (
                <button
                  onClick={() => onLaunchRemediationDrill(scoreReport.missedQuestionIds)}
                  className="w-full sm:w-auto px-5 py-2.5 rounded-xl bg-gradient-to-r from-rose-600 to-amber-600 hover:from-rose-500 hover:to-amber-500 text-white font-bold text-xs flex items-center justify-center space-x-2 shadow-lg shadow-rose-950/50 transition cursor-pointer"
                >
                  <Zap className="w-4 h-4 text-amber-300" />
                  <span>Generate Remediation Drill ({scoreReport.missedQuestionIds.length} Missed Items)</span>
                </button>
              ) : (
                <div />
              )}

              <button
                onClick={onExit}
                className="w-full sm:w-auto px-6 py-2.5 rounded-xl bg-stone-800 hover:bg-stone-700 text-stone-200 text-xs font-semibold transition cursor-pointer"
              >
                Return to Assessment Battery
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
};
