  "grammars": [
    {
      "id": "n2.l08.g001",
      "lessonId": "n2.l08",
      "pattern": "〜に決まっている",
      "meaning": "Definitely / Bound to / Must be (speaker's absolute conviction)",
      "formation": "普通形（名詞・な形容詞 ＋ だ省くことあり） ＋ に決まっている",
      "explanation": {
        "en": "Expresses the speaker's intuitive or subjective conviction that something is definitely true or bound to happen ('must be...', 'bound to...'). Stronger and more colloquial than に違いない.",
        "my": "သေချာပေါက် ထိုသို့ဖြစ်မည် သို့မဟုတ် ဖြစ်ရမည် ဟု ပြောသူ၏ ပြတ်သားသော စိတ်ပိုင်းဖြတ် ယူဆချက်ကို ပြသည်။ (သေချာပေါက် ... ဖြစ်မှာ အမှန်ပဲ)။"
      },
      "examples": [
        {
          "sentenceId": "n2.l08.s002",
          "note": "Firm conviction that success will follow dedication"
        },
        {
          "sentenceId": "n2.l08.s007",
          "note": "Absolute assertion identifying an optical illusion"
        }
      ],
      "similarGrammarIds": [
        "n2.l08.g002",
        "n2.l08.g003"
      ],
      "commonMistakes": [
        "Do not use in highly formal scientific papers where objective statistical evidence is required; use に違いない or である instead."
      ],
      "difficulty": 4,
      "level": "N2",
      "prov": {
        "source": "Nihongo N2 Master Editorial Team",
        "license": "CC-BY-4.0",
        "status": "native_verified",
        "updatedAt": "2026-10-19T18:00:00Z",
        "rev": 1
      },
      "clozeSentence": "これだけ努力を重ねてきたのだから、試験に合格する[ _____ ]。",
      "clozeTarget": "に決まっている",
      "clozeHint": "Plain form + に決まっている (speaker's strong conviction: 'must definitely be')",
      "acceptableSynonyms": [
        "に違いない",
        "はずだ",
        "に相違ない",
        "に決まっておる"
      ],
      "nuanceExplanationMy": "「〜に決まっている」သည် ပြောသူ၏ ပြတ်သားသော စိတ်ခံစားမှုအခြေခံ ယုံကြည်ချက် ဖြစ်သည်။ စာရွက်စာတမ်း အထောက်အထားအရ သေချာမှု (に違いない / に相違ない) ထက် ပိုမို ပြတ်သားသည့် ပြောဆိုဟန် ဖြစ်သည်။"
    },
