  "listening": {
    "id": "n2.l11.l001",
    "lessonId": "n2.l11",
    "title": "リモートワーク制度改定をめぐる社内対話",
    "level": "N2",
    "audio": {
      "kind": "tts",
      "lang": "ja-JP"
    },
    "speakers": [
      "人事部長・佐々木",
      "企画課長・藤田"
