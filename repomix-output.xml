export const Navigation: React.FC<NavigationProps> = ({
  currentView,
  onNavigate,
  dueSrsCount,
  hasActiveSession,
  isTestActive = false,
  todayMinutes = 0,
  goalMinutes = 360,
  profile,
  onOpenDiagnostics,
