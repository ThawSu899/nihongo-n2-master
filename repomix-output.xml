/**
 * AnkiConnect REST Client for Local Anki Desktop Integration
 * Default endpoint: http://127.0.0.1:8765
 */

export interface AnkiConnectResponse<T = unknown> {
  result: T;
  error: string | null;
}

export interface AnkiConnectionResult {
  connected: boolean;
  decks: string[];
  error?: string;
  latencyMs?: number;
}

export class AnkiConnectClient {
  static readonly DEFAULT_URL = 'http://127.0.0.1:8765';
  static readonly DEFAULT_TIMEOUT_MS = 3500;

  /**
   * Pings AnkiConnect on local host with `deckNames` action
   */
  static async checkConnection(
    endpoint: string = this.DEFAULT_URL,
    timeoutMs: number = this.DEFAULT_TIMEOUT_MS
  ): Promise<AnkiConnectionResult> {
    const startTime = Date.now();
    const controller = new AbortController();
    const timeoutId = setTimeout(() => controller.abort(), timeoutMs);

    try {
      const response = await fetch(endpoint, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          action: 'deckNames',
          version: 6,
        }),
        signal: controller.signal,
      });

      clearTimeout(timeoutId);
      const latencyMs = Date.now() - startTime;

      if (!response.ok) {
        return {
          connected: false,
          decks: [],
          error: `HTTP ${response.status}: ${response.statusText}`,
          latencyMs,
        };
      }

      const data: AnkiConnectResponse<string[]> = await response.json();

      if (data.error) {
        return {
          connected: false,
          decks: [],
          error: String(data.error),
          latencyMs,
        };
      }

      const decks = Array.isArray(data.result) ? data.result : [];
      return {
        connected: true,
        decks,
        latencyMs,
      };
    } catch (err: any) {
      clearTimeout(timeoutId);
      const latencyMs = Date.now() - startTime;
      const isAbort = err?.name === 'AbortError';

      return {
        connected: false,
        decks: [],
        error: isAbort ? 'Connection timed out (3.5s)' : (err?.message || 'Failed to connect to Anki Desktop'),
        latencyMs,
      };
    }
  }
}
</file>

<file path="src/data/backup/anki-exporter.ts">
import { db } from '../db/dexie-db';
import { SRSCard } from '../../domain/models/types';
import { getOrDecomposeKanji } from '../../domain/dictionary/kanji-catalog';

export type AnkiExportScope = 'all' | 'mined' | 'leeches';

export interface AnkiExportOptions {
  scope: AnkiExportScope;
}

export interface AnkiExportResult {
  content: string;
  filename: string;
  count: number;
}

/**
 * Anki Deck Export Engine
 * Generates UTF-8 tab-separated values (.tsv) with standard Anki configuration directives.
 *
 * Supported Fields:
 * 1. Front (Expression / Kanji / Grammar Pattern)
 * 2. Reading (Kana / Furigana / Onyomi & Kunyomi)
 * 3. Meaning EN (English Definition)
 * 4. Meaning Myanmar (Burmese Definition)
 * 5. POS/Formation (Part of Speech / Grammatical Connection / Facet)
 * 6. Example Sentence (Japanese context passage)
 * 7. Sentence Translation (English / Burmese translation of example sentence)
 * 8. Tags (Space-separated Anki tags)
 */
export class AnkiExporter {
  /**
   * Sanitizes a string for TSV export by replacing unescaped tabs and formatting newlines into <br>
   */
  static sanitizeField(text?: string | null): string {
    if (!text) return '';
    return text
      .replace(/\t/g, ' ')
      .replace(/\r?\n/g, '<br>')
      .trim();
  }

  /**
   * Queries cards matching the specified scope
   */
  static async getCardsByScope(scope: AnkiExportScope): Promise<SRSCard[]> {
    const allCards = await db.srs_cards.toArray();

    switch (scope) {
      case 'mined':
        return allCards.filter(
          (c) =>
            c.id.startsWith('quick_') ||
            c.lessonId.includes('quick') ||
            c.lessonId.includes('mined') ||
            c.itemId.startsWith('item_mined') ||
            c.lessonId === 'n2.quick_search'
        );
      case 'leeches':
        return allCards.filter((c) => c.isLeech || (c.lapses && c.lapses >= 3));
      case 'all':
      default:
        return allCards;
    }
  }

  /**
   * Formats a card into the 8-column TSV row matching Anki specifications
   */
  static formatCardRow(card: SRSCard): string {
    const front = this.sanitizeField(card.prompt);
    let reading = this.sanitizeField(card.reading || '');
    const meaningEn = this.sanitizeField(card.meaning);
    let meaningMyanmar = '';
    let posFormation = this.sanitizeField(card.facet || card.itemType);
    let exampleSentence = '';
    let sentenceTranslation = '';

    // Decompose or enrich Kanji information
    if (card.itemType === 'kanji') {
      const kanjiDetail = getOrDecomposeKanji(card.prompt);
      if (kanjiDetail) {
        if (!reading && kanjiDetail.onyomi?.length) {
          reading = this.sanitizeField(
            `音: ${kanjiDetail.onyomi.join('、')} / 訓: ${kanjiDetail.kunyomi.join('、')}`
          );
        }
        if (kanjiDetail.meaningMy) {
          meaningMyanmar = this.sanitizeField(kanjiDetail.meaningMy);
        }
        if (kanjiDetail.radical) {
          posFormation = this.sanitizeField(
            `部首: ${kanjiDetail.radical} (${kanjiDetail.radicalMeaning || ''}) · Strokes: ${kanjiDetail.strokes || '—'}`
          );
        }
      }
    } else if (card.itemType === 'grammar') {
      posFormation = this.sanitizeField(`N2 Grammar · ${card.facet || 'Pattern'}`);
    } else if (card.itemType === 'vocab') {
      posFormation = this.sanitizeField(`Vocabulary · ${card.facet || 'Lexeme'}`);
    }

    // Process example sentence and translation
    if (card.exampleSentence) {
      const raw = card.exampleSentence;
      // If the example sentence contains a translation separated by newline or parenthesis
      if (raw.includes('\n')) {
        const parts = raw.split(/\r?\n/);
        exampleSentence = this.sanitizeField(parts[0]);
        sentenceTranslation = this.sanitizeField(parts.slice(1).join(' '));
      } else {
        exampleSentence = this.sanitizeField(raw);
      }
    }

    // Build Anki tag list (space-separated)
    const tagList: string[] = [
      'JLPT_N2',
      'NihongoN2Master',
      `type_${card.itemType}`,
    ];

    if (card.lessonId) {
      tagList.push(`lesson_${card.lessonId.replace(/[^a-zA-Z0-9_-]/g, '_')}`);
    }
    if (card.isLeech || (card.lapses && card.lapses >= 3)) {
      tagList.push('leech_quarantined');
    }
    if (card.intervalDays && card.intervalDays >= 21) {
      tagList.push('mature_interval');
    }
    if (
      card.id.startsWith('quick_') ||
      card.lessonId.includes('quick') ||
      card.lessonId.includes('mined')
    ) {
      tagList.push('user_mined');
    }

    const tags = tagList.join(' ');

    return [
      front,
      reading,
      meaningEn,
      meaningMyanmar,
      posFormation,
      exampleSentence,
      sentenceTranslation,
      tags,
    ].join('\t');
  }

  /**
   * Generates formatted TSV content with standard Anki header directives
   */
  static generateTsvContent(cards: SRSCard[]): string {
    const headers = [
      '#separator:tab',
      '#html:true',
      '#tags column:8',
      '#columns:Front\tReading\tMeaning EN\tMeaning Myanmar\tPOS/Formation\tExample Sentence\tSentence Translation\tTags',
    ];

    const rows = cards.map((c) => this.formatCardRow(c));
    return [...headers, ...rows].join('\n');
  }

  /**
   * Exports cards to an Anki-compatible TSV string with metadata
   */
  static async exportToAnki(options: AnkiExportOptions = { scope: 'all' }): Promise<AnkiExportResult> {
    const cards = await this.getCardsByScope(options.scope);
    const content = this.generateTsvContent(cards);
    const dateStr = new Date().toISOString().substring(0, 10);
    const filename = `nihongo-n2-anki-${options.scope}-${dateStr}.tsv`;

    return {
      content,
      filename,
      count: cards.length,
    };
  }

  /**
   * Triggers browser download of exported Anki TSV file
   */
  static async downloadAnkiExport(options: AnkiExportOptions = { scope: 'all' }): Promise<AnkiExportResult> {
    const result = await this.exportToAnki(options);

    if (typeof document !== 'undefined') {
      const blob = new Blob([result.content], { type: 'text/tab-separated-values;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = result.filename;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    }

    return result;
  }
}
</file>

<file path="src/data/backup/backup-manager.ts">
import { db } from '../db/dexie-db';
import type { GhostCardRecord, CramDrillRecord } from '../../domain/models/types';

export interface BackupData {
  version: number;
  exportedAt: string;
  profile: any;
  srsCards: any[];
  reviewLogs: any[];
  masteryRecords: any[];
  studySessions: any[];
  studyEvents: any[];
  lessonPacks?: any[];
  kanaRecords?: any[];
  assessments?: any[];
  remediations?: any[];
  aiNotes?: any[];
  ghost_cards?: GhostCardRecord[] | any[];
  ghostCards?: GhostCardRecord[] | any[];
  cram_drills?: CramDrillRecord[] | any[];
  cramDrills?: CramDrillRecord[] | any[];
}

export class BackupManager {
  private static SNAPSHOT_KEY = 'nihongo_n2_local_snapshot';
  private static QUARANTINE_KEY = 'nihongo_n2_quarantined_corrupt';

  static async exportToJson(): Promise<string> {
    const profile = await db.profile.get('current_user');
    const srsCards = await db.srs_cards.toArray();
    const reviewLogs = await db.review_logs.toArray();
    const masteryRecords = await db.mastery_records.toArray();
    const studySessions = await db.study_sessions.toArray();
    const studyEvents = await db.study_events.toArray();
    const lessonPacks = await db.lesson_packs.toArray();
    const kanaRecords = await db.kana_records.toArray();
    const assessments = await db.assessments.toArray();
    const remediations = await db.remediations.toArray();
    const aiNotes = await db.ai_notes.toArray();
    const ghostCards = await db.ghost_cards.toArray();
    const cramDrills = await db.cram_drills.toArray();

    const backup: BackupData = {
      version: 2,
      exportedAt: new Date().toISOString(),
      profile,
      srsCards,
      reviewLogs,
      masteryRecords,
      studySessions,
      studyEvents,
      lessonPacks,
      kanaRecords,
      assessments,
      remediations,
      aiNotes,
      ghost_cards: ghostCards,
      ghostCards: ghostCards,
      cram_drills: cramDrills,
      cramDrills: cramDrills,
    };

    return JSON.stringify(backup, null, 2);
  }

  static async saveLocalSnapshot(): Promise<void> {
    try {
      const json = await this.exportToJson();
      localStorage.setItem(this.SNAPSHOT_KEY, json);
    } catch (e) {
      console.warn('Failed to save rolling local snapshot:', e);
    }
  }

  static async restoreFromJson(jsonString: string): Promise<{ success: boolean; message: string; stats?: Record<string, number> }> {
    try {
      const backup: BackupData = JSON.parse(jsonString);
      if (!backup.version || !backup.exportedAt) {
        throw new Error('Invalid backup file structure: missing version or timestamp.');
      }

      const ghostCardsList = backup.ghost_cards || backup.ghostCards || [];
      const cramDrillsList = backup.cram_drills || backup.cramDrills || [];

      const stats: Record<string, number> = {
        srsCards: backup.srsCards?.length || 0,
        masteryRecords: backup.masteryRecords?.length || 0,
        reviewLogs: backup.reviewLogs?.length || 0,
        studySessions: backup.studySessions?.length || 0,
        kanaRecords: backup.kanaRecords?.length || 0,
        assessments: backup.assessments?.length || 0,
        ghostCards: ghostCardsList.length,
        cramDrills: cramDrillsList.length,
      };

      await db.transaction(
        'rw',
        [
          db.profile,
          db.srs_cards,
          db.review_logs,
          db.mastery_records,
          db.study_sessions,
          db.study_events,
          db.lesson_packs,
          db.kana_records,
          db.assessments,
          db.remediations,
          db.ai_notes,
          db.ghost_cards,
          db.cram_drills,
        ],
        async () => {
          if (backup.profile) {
            await db.profile.put({ ...backup.profile, id: 'current_user' });
          }
          if (backup.srsCards?.length) {
            await db.srs_cards.clear();
            await db.srs_cards.bulkAdd(backup.srsCards);
          }
          if (backup.reviewLogs?.length) {
            await db.review_logs.clear();
            await db.review_logs.bulkAdd(backup.reviewLogs);
          }
          if (backup.masteryRecords?.length) {
            await db.mastery_records.clear();
            await db.mastery_records.bulkAdd(backup.masteryRecords);
          }
          if (backup.studySessions?.length) {
            await db.study_sessions.clear();
            await db.study_sessions.bulkAdd(backup.studySessions);
          }
          if (backup.studyEvents?.length) {
            await db.study_events.clear();
            await db.study_events.bulkAdd(backup.studyEvents);
          }
          if (backup.lessonPacks?.length) {
            await db.lesson_packs.clear();
            await db.lesson_packs.bulkAdd(backup.lessonPacks);
          }
          if (backup.kanaRecords?.length) {
            await db.kana_records.clear();
            await db.kana_records.bulkAdd(backup.kanaRecords);
          }
          if (backup.assessments?.length) {
            await db.assessments.clear();
            await db.assessments.bulkAdd(backup.assessments);
          }
          if (backup.remediations?.length) {
            await db.remediations.clear();
            await db.remediations.bulkAdd(backup.remediations);
          }
          if (backup.aiNotes?.length) {
            await db.ai_notes.clear();
            await db.ai_notes.bulkAdd(backup.aiNotes);
          }
          if (ghostCardsList.length) {
            await db.ghost_cards.clear();
            await db.ghost_cards.bulkAdd(ghostCardsList);
          }
          if (cramDrillsList.length) {
            await db.cram_drills.clear();
            await db.cram_drills.bulkAdd(cramDrillsList);
          }
        }
      );

      return {
        success: true,
        message: `Restored ${stats.srsCards} SRS cards, ${stats.masteryRecords} mastery records, and ${stats.kanaRecords} kana items.`,
        stats,
      };
    } catch (err: any) {
      return { success: false, message: `Restore failed: ${err.message}` };
    }
  }

  static async checkIntegrityAndAutoRecover(): Promise<{ corrupted: boolean; restored: boolean }> {
    try {
      // Basic read check
      await db.profile.toArray();
      await db.mastery_records.toArray();
      await db.srs_cards.toArray();
      // Periodically take snapshot
      await this.saveLocalSnapshot();
      return { corrupted: false, restored: false };
    } catch (err) {
      console.error('Database integrity check failed! Attempting recovery from snapshot...', err);
      // Quarantine
      const snapshot = localStorage.getItem(this.SNAPSHOT_KEY);
      if (snapshot) {
        localStorage.setItem(this.QUARANTINE_KEY, `corrupted_at_${new Date().toISOString()}`);
        await this.restoreFromJson(snapshot);
        return { corrupted: true, restored: true };
      }
      return { corrupted: true, restored: false };
    }
  }
}
