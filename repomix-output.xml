                  </div>
                  {item.exampleSentence && (
                    <div className="text-[11px] text-stone-400 font-japanese italic truncate">
                      {item.exampleSentence}
                    </div>
                  )}
                </div>

                {/* Card Item Action Buttons */}
                <div className="flex items-center justify-between pt-1 text-xs">
                  <button
                    onClick={() => onLaunchDrill && onLaunchDrill('mixed_leeches')}
                    className="text-amber-400 hover:text-amber-300 font-medium flex items-center space-x-1 transition cursor-pointer"
                  >
                    <span>Practice in Isolation</span>
                    <ChevronRight className="w-3.5 h-3.5" />
                  </button>

                  <button
                    onClick={() => handleRehabilitate(item.cardId)}
                    disabled={rehabilitatingId === item.cardId}
                    className="px-2.5 py-1 rounded bg-stone-900 hover:bg-stone-800 border border-stone-800 hover:border-emerald-800 text-stone-400 hover:text-emerald-300 text-[11px] font-medium transition flex items-center space-x-1 disabled:opacity-50 cursor-pointer"
                  >
                    {rehabilitatingId === item.cardId ? (
                      <RotateCcw className="w-3 h-3 animate-spin" />
                    ) : (
                      <Check className="w-3 h-3" />
                    )}
                    <span>Rehabilitate</span>
                  </button>
                </div>
              </div>
            ))}
          </div>
        ) : (
          <div className="text-center py-10 space-y-3 bg-stone-950/40 rounded-xl border border-dashed border-stone-800">
            <ShieldCheck className="w-10 h-10 text-emerald-500/80 mx-auto" />
            <div className="space-y-1">
              <h4 className="text-sm font-semibold text-stone-200">Quarantine Zone Clear!</h4>
              <p className="text-xs text-stone-400 max-w-sm mx-auto">
                No stubborn leech items currently detected with excessive failure lapses. As you review SRS cards, persistent errors will automatically isolate here.
              </p>
            </div>
            <button
              onClick={handleSeedLeeches}
              className="px-3.5 py-1.5 rounded-lg bg-stone-850 hover:bg-stone-800 border border-stone-700 text-stone-300 text-xs font-medium transition cursor-pointer"
            >
              Populate Diagnostic Leeches for Testing
            </button>
          </div>
        )}
      </div>

      {/* Conjunctive Scoring Explainer Banner */}
      <div className="bg-stone-950 border border-stone-800/80 rounded-2xl p-4 flex items-start space-x-3 text-xs text-stone-300">
        <Shield className="w-5 h-5 text-indigo-400 shrink-0 mt-0.5" />
        <div className="space-y-1">
          <strong className="block text-stone-200">Conjunctive Scoring Rule:</strong>
          <span className="text-stone-400">
            In JLPT assessments, high performance in one skill (e.g., Vocabulary at 98%) does not compensate for a failing sub-score in another (e.g., Listening below 80%). The radar polygon highlights where balance is achieved across all 5 areas.
          </span>
        </div>
      </div>
    </div>
  );
};
</file>

<file path="src/index.css">
@import "tailwindcss";

@layer utilities {
  .font-japanese {
    font-family: "Noto Sans JP", "Hiragino Kaku Gothic ProN", "Yu Gothic", "Meiryo", sans-serif;
  }
  .font-myanmar,
  .font-burmese {
    font-family: "Noto Sans Myanmar", "Padauk", "Pyidaungsu", "Myanmar Text", sans-serif;
    line-height: 1.6;
  }

  /* Deep Obsidian Glass Surfaces */
  .bg-obsidian-surface {
    background-color: rgba(15, 15, 18, 0.72);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .bg-obsidian-card {
    background-color: rgba(22, 22, 27, 0.65);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(255, 255, 255, 0.07);
  }

  .bg-obsidian-pill {
    background-color: rgba(24, 24, 30, 0.88);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  /* Vivid Semantic Neon Glow Utilities */
  .glow-rose {
    box-shadow: 0 0 24px -4px rgba(244, 63, 94, 0.35);
  }
  .glow-rose-lg {
    box-shadow: 0 0 32px -2px rgba(244, 63, 94, 0.55);
  }

  .glow-emerald {
    box-shadow: 0 0 24px -4px rgba(16, 185, 129, 0.35);
  }
  .glow-emerald-lg {
    box-shadow: 0 0 32px -2px rgba(16, 185, 129, 0.55);
  }

  .glow-indigo {
    box-shadow: 0 0 24px -4px rgba(99, 102, 241, 0.35);
  }
  .glow-indigo-lg {
    box-shadow: 0 0 32px -2px rgba(99, 102, 241, 0.55);
  }

  .glow-amber {
    box-shadow: 0 0 24px -4px rgba(245, 158, 11, 0.35);
  }
  .glow-amber-lg {
    box-shadow: 0 0 32px -2px rgba(245, 158, 11, 0.55);
  }

  /* 3D Tactile Card Flip Utilities */
  .perspective-1000 {
    perspective: 1000px;
  }
  .transform-style-3d {
    transform-style: preserve-3d;
  }
  .backface-hidden {
    backface-visibility: hidden;
  }
  .rotate-y-180 {
    transform: rotateY(180deg);
  }

  /* Japanese Traditional Motif Backgrounds (Adapted to Deep Obsidian #09090b) */
  .bg-pattern-asanoha {
    background-color: #09090b;
    background-image: 
      linear-gradient(30deg, #141419 12%, transparent 12.5%, transparent 87%, #141419 87.5%, #141419),
      linear-gradient(150deg, #141419 12%, transparent 12.5%, transparent 87%, #141419 87.5%, #141419),
      linear-gradient(30deg, #141419 12%, transparent 12.5%, transparent 87%, #141419 87.5%, #141419),
      linear-gradient(150deg, #141419 12%, transparent 12.5%, transparent 87%, #141419 87.5%, #141419),
      linear-gradient(60deg, #1a1a22 25%, transparent 25.5%, transparent 75%, #1a1a22 75%, #1a1a22),
      linear-gradient(60deg, #1a1a22 25%, transparent 25.5%, transparent 75%, #1a1a22 75%, #1a1a22);
    background-size: 32px 56px;
    background-position: 0 0, 0 0, 16px 28px, 16px 28px, 0 0, 16px 28px;
  }

  .bg-pattern-seigaiha {
    background-color: #09090b;
    background-image: radial-gradient(circle at 100% 150%, #09090b 24%, #18181f 25%, #18181f 28%, #09090b 29%, #09090b 36%, #18181f 37%, #18181f 40%, #09090b 41%, #09090b 48%, #18181f 49%, #18181f 52%, #09090b 53%);
    background-size: 28px 14px;
  }

  .bg-pattern-clover-mon {
    background-color: #09090b;
    background-image: radial-gradient(rgba(244, 63, 94, 0.08) 1px, transparent 1px),
      radial-gradient(rgba(99, 102, 241, 0.06) 1px, transparent 1px);
    background-size: 24px 24px;
    background-position: 0 0, 12px 12px;
  }
}

/* Ruby Furigana Safeguards */
ruby {
  ruby-align: center;
  line-height: 1.85;
}

rt {
  user-select: none;
  font-size: 0.62em;
  line-height: 1;
  color: rgba(228, 228, 231, 0.7);
}

/* Safe area padding for mobile notches & floating docks */
.safe-area-pb {
  padding-bottom: max(1.25rem, env(safe-area-inset-bottom));
}
