<file path="src/presentation/components/SkillRadarChart.tsx">
import React, { useMemo } from 'react';

export interface SkillScoreData {
  skill: 'vocab' | 'kanji' | 'grammar' | 'reading' | 'listening';
  label: string;
  scorePct: number; // 0 - 100
  thresholdPct: number; // e.g. 90, 85, 85, 80, 80
  testedCount: number;
  correctCount: number;
}

interface SkillRadarChartProps {
  skills: SkillScoreData[];
  size?: number;
  showComparisonTarget?: boolean;
}

export const SkillRadarChart: React.FC<SkillRadarChartProps> = ({
  skills,
  size = 280,
  showComparisonTarget = true,
}) => {
  const center = size / 2;
  const radius = size * 0.38;
  const levels = [0.25, 0.5, 0.75, 1.0]; // Concentric grid rings (25%, 50%, 75%, 100%)

  // 5 vertices for a regular pentagon, top vertex at -90 degrees (-PI/2)
  const angleStep = (2 * Math.PI) / skills.length;
  const startAngle = -Math.PI / 2;

  const getCoordinates = (valueNormalized: number, index: number) => {
    const angle = startAngle + index * angleStep;
    const r = radius * Math.max(0, Math.min(1, valueNormalized));
    const x = center + r * Math.cos(angle);
    const y = center + r * Math.sin(angle);
    return { x, y };
  };

  // Generate background grid polygons
  const gridPolygons = levels.map((lvl) => {
    const points = skills
      .map((_, i) => {
        const { x, y } = getCoordinates(lvl, i);
        return `${x.toFixed(1)},${y.toFixed(1)}`;
      })
      .join(' ');
    return { level: lvl, points };
  });

  // User actual performance polygon
  const userPoints = useMemo(() => {
    return skills
      .map((s, i) => {
        const { x, y } = getCoordinates(s.scorePct / 100, i);
        return `${x.toFixed(1)},${y.toFixed(1)}`;
      })
      .join(' ');
  }, [skills, radius, center]);

  // Target threshold polygon
  const targetPoints = useMemo(() => {
    return skills
      .map((s, i) => {
        const { x, y } = getCoordinates(s.thresholdPct / 100, i);
        return `${x.toFixed(1)},${y.toFixed(1)}`;
      })
      .join(' ');
  }, [skills, radius, center]);

  // Axis spokes and label positions
  const spokesAndLabels = skills.map((skill, i) => {
    const outer = getCoordinates(1.0, i);
    const angle = startAngle + i * angleStep;
    const labelDistance = radius + 28;
    const lx = center + labelDistance * Math.cos(angle);
    const ly = center + labelDistance * Math.sin(angle);

    // Subtle alignment adjustment depending on angle quadrant
    let textAnchor: 'middle' | 'start' | 'end' = 'middle';
    if (Math.cos(angle) > 0.3) textAnchor = 'start';
    else if (Math.cos(angle) < -0.3) textAnchor = 'end';

    return {
      skill,
      axisX: outer.x,
      axisY: outer.y,
      lx,
      ly,
      textAnchor,
      userCoord: getCoordinates(skill.scorePct / 100, i),
      targetCoord: getCoordinates(skill.thresholdPct / 100, i),
    };
  });

  return (
    <div className="relative flex flex-col items-center justify-center">
      <svg
        width={size}
        height={size}
        viewBox={`0 0 ${size} ${size}`}
        className="overflow-visible select-none"
      >
        <defs>
          {/* Glowing rose gradient for user polygon */}
          <radialGradient id="radarUserFill" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stopColor="#f43f5e" stopOpacity="0.45" />
            <stop offset="85%" stopColor="#e11d48" stopOpacity="0.22" />
            <stop offset="100%" stopColor="#9f1239" stopOpacity="0.08" />
          </radialGradient>
          <filter id="radarGlow" x="-20%" y="-20%" width="140%" height="140%">
            <feGaussianBlur stdDeviation="3" result="blur" />
            <feComposite in="SourceGraphic" in2="blur" operator="over" />
          </filter>
        </defs>

        {/* Concentric grid pentagons */}
        {gridPolygons.map(({ level, points }) => (
          <polygon
            key={level}
            points={points}
            fill="none"
            stroke="#292524" // stone-800
            strokeWidth={level === 1 ? '1.5' : '1'}
            strokeDasharray={level < 1 ? '3 3' : undefined}
          />
        ))}

        {/* Spokes from center to perimeter */}
        {spokesAndLabels.map((spoke, i) => (
          <line
            key={i}
            x1={center}
            y1={center}
            x2={spoke.axisX}
            y2={spoke.axisY}
            stroke="#44403c" // stone-700
            strokeWidth="1"
          />
        ))}

        {/* Level Percentage Markers along Top Spoke */}
        {levels.map((lvl) => {
          const y = center - radius * lvl;
          return (
            <text
              key={lvl}
              x={center + 4}
              y={y + 3}
              fill="#78716c" // stone-500
              fontSize="8"
              fontFamily="monospace"
            >
              {Math.round(lvl * 100)}%
            </text>
          );
        })}

        {/* JLPT Target Benchmark Polygon (Indigo dotted outline) */}
        {showComparisonTarget && (
          <polygon
            points={targetPoints}
            fill="rgba(99, 102, 241, 0.06)"
            stroke="#6366f1"
            strokeWidth="1.5"
            strokeDasharray="4 3"
            className="transition-all duration-300"
          />
        )}

        {/* User Actual Performance Polygon */}
        <polygon
          points={userPoints}
          fill="url(#radarUserFill)"
          stroke="#f43f5e"
          strokeWidth="2"
          filter="url(#radarGlow)"
          className="transition-all duration-500"
        />

        {/* User Data Points Dots */}
        {spokesAndLabels.map((item, i) => (
          <g key={i}>
            {/* Target vertex tick */}
            {showComparisonTarget && (
              <circle
                cx={item.targetCoord.x}
                cy={item.targetCoord.y}
                r="3"
                fill="#312e81"
                stroke="#818cf8"
                strokeWidth="1.5"
              />
            )}
            {/* User vertex marker */}
            <circle
              cx={item.userCoord.x}
              cy={item.userCoord.y}
              r="4.5"
              fill="#fb7185"
              stroke="#881337"
              strokeWidth="1.5"
            />
          </g>
        ))}

        {/* Outer Labels */}
        {spokesAndLabels.map((item, i) => {
          const isPassing = item.skill.scorePct >= item.skill.thresholdPct;
          return (
            <g key={i} className="pointer-events-none">
              <text
                x={item.lx}
                y={item.ly - 6}
                textAnchor={item.textAnchor}
                fill={isPassing ? '#f43f5e' : '#e7e5e4'}
                fontSize="11"
                fontWeight="600"
                className="tracking-tight"
              >
                {item.skill.label}
              </text>
              <text
                x={item.lx}
                y={item.ly + 7}
                textAnchor={item.textAnchor}
                fill={isPassing ? '#34d399' : '#a8a29e'}
                fontSize="10"
                fontFamily="monospace"
                fontWeight="500"
              >
                {item.skill.scorePct}%
                <tspan fill="#78716c" fontSize="9">
                  {' '}/ {item.skill.thresholdPct}%
                </tspan>
              </text>
            </g>
          );
        })}
      </svg>

      {/* Legend below chart */}
      <div className="flex items-center space-x-5 mt-4 text-[11px] font-medium">
        <div className="flex items-center space-x-1.5">
          <span className="w-3 h-3 rounded-full bg-rose-500/30 border border-rose-500 inline-block" />
          <span className="text-stone-300">Your Current Mastery</span>
        </div>
        {showComparisonTarget && (
          <div className="flex items-center space-x-1.5">
            <span className="w-3 h-0.5 border-t border-dashed border-indigo-400 inline-block" />
            <span className="text-stone-400">Target JLPT Threshold</span>
          </div>
        )}
      </div>
    </div>
  );
};
</file>

<file path="src/presentation/components/StarScrambleTrainer.tsx">
import React, { useState, useEffect, useCallback } from 'react';
import { motion, AnimatePresence } from 'framer-motion';
import {
  Sparkles,
  Star,
  RotateCcw,
  CheckCircle2,
  XCircle,
  ArrowRight,
  ArrowLeft,
  HelpCircle,
  Award,
  ChevronRight,
  BookOpen,
  Volume2,
  Layers,
  Check,
} from 'lucide-react';
import {
  STAR_SCRAMBLE_CATALOG,
  StarScramblePuzzle,
  StarScrambleEngine,
  ScrambleEvaluation,
  ScrambleToken,
} from '../../domain/assessment/star-scramble-engine';
import { db } from '../../data/db/dexie-db';
import { useScopedShortcuts } from '../context/GlobalShortcutContext';

interface StarScrambleTrainerProps {
  onExit?: () => void;
  onComplete?: (summary: { score: number; accuracy: number; totalPuzzles: number }) => void;
}

export const StarScrambleTrainer: React.FC<StarScrambleTrainerProps> = ({
  onExit,
  onComplete,
}) => {
  const [currentIndex, setCurrentIndex] = useState(0);
  // Current slot allocations: array of 4 (option numbers 1-4, or null)
  const [slots, setSlots] = useState<(number | null)[]>([null, null, null, null]);
  const [evaluation, setEvaluation] = useState<ScrambleEvaluation | null>(null);
  const [historyScores, setHistoryScores] = useState<number[]>([]);
  const [showExplanation, setShowExplanation] = useState(false);

  const currentPuzzle: StarScramblePuzzle =
    STAR_SCRAMBLE_CATALOG[currentIndex] || STAR_SCRAMBLE_CATALOG[0];

  // Placed option numbers set
  const placedOptions = new Set(slots.filter((n): n is number => n !== null));

  // Reset when puzzle advances
  const resetPuzzleState = useCallback(() => {
    setSlots([null, null, null, null]);
    setEvaluation(null);
    setShowExplanation(false);
  }, []);

  useEffect(() => {
    resetPuzzleState();
  }, [currentIndex, resetPuzzleState]);

  // Handle assigning an option to the first available slot
  const handleAssignOption = useCallback(
    (optionNumber: number) => {
      if (evaluation) return; // Locked after submission
      if (placedOptions.has(optionNumber)) return;

      const firstEmptyIndex = slots.findIndex((s) => s === null);
      if (firstEmptyIndex === -1) return;

      const newSlots = [...slots];
      newSlots[firstEmptyIndex] = optionNumber;
      setSlots(newSlots);
    },
    [slots, placedOptions, evaluation]
  );

  // Handle clearing a slot
  const handleClearSlot = useCallback(
    (slotIdx: number) => {
      if (evaluation) return;
      if (slots[slotIdx] === null) return;
      const newSlots = [...slots];
      newSlots[slotIdx] = null;
      setSlots(newSlots);
    },
    [slots, evaluation]
  );

  // Handle submitting
  const handleSubmit = useCallback(async () => {
    if (slots.some((s) => s === null)) return;
    const res = StarScrambleEngine.evaluate(currentPuzzle, slots);
    setEvaluation(res);
    setHistoryScores((prev) => [...prev, res.score]);

    // Save study event
    try {
      await db.study_events.add({
        id: `evt_scramble_${Date.now()}`,
        timestamp: new Date().toISOString(),
        type: 'exercise_attempted',
        lessonId: 'grammar.star_scramble',
        data: {
          puzzleId: currentPuzzle.id,
          score: res.score,
          isStarCorrect: res.isStarCorrect,
          isFullyCorrect: res.isFullyCorrect,
        },
      });
    } catch {
      // Ignore Dexie background write errors
    }
  }, [slots, currentPuzzle]);

  // Centralized scoped keyboard shortcuts (1-4 to assign, Enter to submit/proceed)
  useScopedShortcuts({
    scopeId: 'star_scramble_trainer',
    priority: 20,
    handlers: {
      SELECT_CHOICE_1: () => handleAssignOption(1),
      SELECT_CHOICE_2: () => handleAssignOption(2),
      SELECT_CHOICE_3: () => handleAssignOption(3),
      SELECT_CHOICE_4: () => handleAssignOption(4),
      SUBMIT_ANSWER: () => {
        if (evaluation) {
          handleNextPuzzle();
        } else if (slots.every((s) => s !== null)) {
          handleSubmit();
        }
      },
      NEXT_ITEM: () => {
        if (evaluation) {
          handleNextPuzzle();
        }
      },
      PREV_ITEM: () => {
        for (let i = slots.length - 1; i >= 0; i--) {
          if (slots[i] !== null) {
            handleClearSlot(i);
            break;
          }
        }
      },
    },
  });

  const handleNextPuzzle = () => {
    if (currentIndex < STAR_SCRAMBLE_CATALOG.length - 1) {
      setCurrentIndex((prev) => prev + 1);
    } else {
      // Completed all puzzles
      const totalScore = historyScores.reduce((a, b) => a + b, 0);
      const avg = Math.round(totalScore / STAR_SCRAMBLE_CATALOG.length);
      if (onComplete) {
        onComplete({
          score: avg,
          accuracy: avg,
          totalPuzzles: STAR_SCRAMBLE_CATALOG.length,
        });
      }
    }
  };

  // Helper to get token object by optionNumber
  const getToken = (optNum: number | null): ScrambleToken | undefined => {
    if (optNum === null) return undefined;
    return currentPuzzle.tokens.find((t) => t.optionNumber === optNum);
  };

  const isAllFilled = slots.every((s) => s !== null);

  // Native Speech
  const handleSpeak = (text: string) => {
    if (typeof window === 'undefined' || !('speechSynthesis' in window)) return;
    window.speechSynthesis.cancel();
    const utterance = new SpeechSynthesisUtterance(text);
    utterance.lang = 'ja-JP';
    utterance.rate = 0.9;
    window.speechSynthesis.speak(utterance);
  };

  return (
    <div className="max-w-3xl mx-auto space-y-6 pb-20 select-none">
      {/* Top Header */}
      <div className="flex items-center justify-between text-xs text-zinc-400">
        <div className="flex items-center space-x-2">
          {onExit && (
            <button
              onClick={onExit}
              className="flex items-center space-x-1 py-1 px-2.5 rounded-lg bg-zinc-900 border border-zinc-800 text-zinc-300 hover:text-white hover:bg-zinc-800 transition cursor-pointer"
            >
              <ArrowLeft className="w-3.5 h-3.5" />
              <span>Back</span>
            </button>
          )}
          <span className="font-mono text-amber-400 font-bold uppercase tracking-wider flex items-center gap-1.5">
            <Star className="w-4 h-4 fill-amber-400 text-amber-400" />
            <span>★ 文法・並べ替え (Sentence Scramble)</span>
          </span>
        </div>

        <div className="flex items-center space-x-2 font-mono text-xs font-myanmar">
          <span className="text-zinc-200">
            မေးခွန်း {currentIndex + 1} / {STAR_SCRAMBLE_CATALOG.length}
          </span>
          <span className="px-2 py-0.5 rounded-full bg-indigo-950/80 border border-indigo-500/40 text-indigo-300 text-[10px]">
            JLPT {currentPuzzle.level}
          </span>
        </div>
      </div>

      {/* Main Puzzle Card */}
      <div className="bg-zinc-900/80 backdrop-blur-xl border border-zinc-800/80 rounded-3xl p-6 sm:p-8 space-y-8 shadow-2xl relative overflow-hidden font-myanmar">
        {/* Question Header & Title */}
        <div className="space-y-1.5 border-b border-zinc-800/80 pb-4">
          <div className="flex items-center justify-between">
            <span className="text-xs font-mono text-zinc-400">
              မေးခွန်း: အောက်ပါဝါကျရှိ ★ နေရာတွင် ဝင်ရမည့် အသင့်တော်ဆုံးကို ရွေးချယ်ပါ။
            </span>
            <span className="text-xs font-mono text-amber-400/90 font-semibold">
              အမှတ်ပေးမည့်နေရာ: ★ အကွက်
            </span>
          </div>
          <h3 className="text-base font-bold text-zinc-200 font-japanese">
            {currentPuzzle.title}
          </h3>
        </div>

        {/* The Sentence with 4 Blank Slots */}
        <div className="bg-zinc-950/80 border border-zinc-800/90 rounded-2xl p-5 sm:p-6 shadow-inner space-y-4">
          <div className="text-lg sm:text-xl md:text-2xl font-japanese leading-loose text-zinc-100 flex flex-wrap items-center gap-x-2 gap-y-3">
            {/* Sentence Prefix */}
            <span className="text-zinc-300 font-medium">{currentPuzzle.prefix}</span>

            {/* 4 Interactive Blank Slots */}
            {slots.map((optNum, slotIdx) => {
              const isStar = slotIdx === currentPuzzle.starSlotIndex;
              const token = getToken(optNum);

              let slotBorder = 'border-dashed border-zinc-700 bg-zinc-900/60 text-zinc-500';
              if (token) {
                slotBorder = 'border-solid border-indigo-500/60 bg-indigo-950/40 text-indigo-200 shadow-md';
              }
              if (isStar) {
                slotBorder = token
                  ? 'border-solid border-amber-400 bg-amber-950/50 text-amber-200 shadow-[0_0_20px_rgba(245,158,11,0.35)] ring-2 ring-amber-400/50'
                  : 'border-dashed border-amber-500/70 bg-amber-950/20 text-amber-400 shadow-[0_0_12px_rgba(245,158,11,0.2)]';
              }

              // After evaluation
              if (evaluation) {
                const correctOptionForThisSlot = currentPuzzle.correctTokenOrder[slotIdx];
                const isThisSlotCorrect = optNum === correctOptionForThisSlot;
                if (isStar) {
                  slotBorder = evaluation.isStarCorrect
                    ? 'border-emerald-500 bg-emerald-950/60 text-emerald-200 shadow-[0_0_24px_rgba(16,185,129,0.4)]'
                    : 'border-rose-500 bg-rose-950/60 text-rose-200 shadow-[0_0_24px_rgba(244,63,94,0.4)]';
                } else if (isThisSlotCorrect) {
                  slotBorder = 'border-emerald-500/50 bg-emerald-950/30 text-emerald-300';
                } else {
                  slotBorder = 'border-rose-500/50 bg-rose-950/30 text-rose-300';
                }
              }

              return (
                <button
                  key={slotIdx}
                  onClick={() => handleClearSlot(slotIdx)}
                  disabled={Boolean(evaluation)}
                  className={`min-w-[90px] sm:min-w-[120px] h-12 sm:h-14 px-3 rounded-xl border-2 flex items-center justify-center font-bold text-sm sm:text-base transition cursor-pointer relative group ${slotBorder}`}
                  title={
                    token
                      ? `နှိပ်၍ ဖယ်ရှားရန် (ရွေးချယ်မှု ${token.optionNumber})`
                      : `အကွက် ${slotIdx + 1}${isStar ? ' ★ ပစ်မှတ်' : ''}`
                  }
                >
                  {isStar && (
                    <span className="absolute -top-3 -right-2 w-6 h-6 rounded-full bg-amber-500 text-zinc-950 flex items-center justify-center shadow-md font-bold text-xs select-none">
                      ★
                    </span>
                  )}

                  {token ? (
                    <span className="flex items-center gap-1 font-japanese">
                      <span className="text-[10px] font-mono opacity-60">({token.optionNumber})</span>
                      <span>{token.text}</span>
                    </span>
                  ) : (
                    <span className="font-mono text-xs opacity-50">
                      [ {slotIdx + 1} ]
                    </span>
                  )}
                </button>
              );
            })}

            {/* Sentence Suffix */}
            <span className="text-zinc-300 font-medium">{currentPuzzle.suffix}</span>
          </div>
        </div>

        {/* Available Phrase Tokens Tray */}
        <div className="space-y-3 font-myanmar">
          <div className="flex items-center justify-between text-xs text-zinc-400 font-mono">
            <span>ရွေးချယ်ရန် စကားစုများ (Options):</span>
            <span className="text-[11px] text-zinc-500">
              ကီးဘုတ် <kbd className="text-zinc-300 font-bold">[1]</kbd> <kbd className="text-zinc-300 font-bold">[2]</kbd> <kbd className="text-zinc-300 font-bold">[3]</kbd> <kbd className="text-zinc-300 font-bold">[4]</kbd> သို့မဟုတ် ကလစ်နှိပ်၍ ရွေးချယ်နိုင်သည်
            </span>
          </div>

          <div className="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
            {currentPuzzle.tokens.map((token) => {
              const isUsed = placedOptions.has(token.optionNumber);
              return (
                <button
                  key={token.id}
                  onClick={() => handleAssignOption(token.optionNumber)}
                  disabled={isUsed || Boolean(evaluation)}
                  className={`p-3.5 rounded-2xl border text-center transition cursor-pointer flex flex-col items-center justify-center space-y-1 relative ${
                    isUsed
                      ? 'opacity-30 bg-zinc-950 border-zinc-800 text-zinc-600 cursor-not-allowed'
                      : 'bg-zinc-950/90 border-zinc-800/90 hover:border-indigo-500/60 hover:bg-zinc-900/90 text-zinc-100 shadow-sm hover:shadow-[0_0_16px_rgba(99,102,241,0.25)] active:scale-95'
                  }`}
                >
                  <span className="w-5 h-5 rounded-full bg-zinc-900 border border-zinc-700 text-[10px] font-mono text-zinc-400 flex items-center justify-center">
                    {token.optionNumber}
                  </span>
                  <span className="text-sm sm:text-base font-bold font-japanese">
                    {token.text}
                  </span>
                </button>
              );
            })}
          </div>
        </div>

        {/* Action Button: Submit or Next */}
        <div className="flex items-center justify-between pt-2 font-myanmar">
          <button
            onClick={() => setSlots([null, null, null, null])}
            disabled={slots.every((s) => s === null) || Boolean(evaluation)}
            className="flex items-center space-x-1.5 px-3 py-2 rounded-xl text-xs font-mono text-zinc-400 hover:text-zinc-200 disabled:opacity-30 transition cursor-pointer"
          >
            <RotateCcw className="w-3.5 h-3.5" />
            <span>ပြန်စမည် (Reset)</span>
          </button>

          {!evaluation ? (
            <button
              onClick={handleSubmit}
              disabled={!isAllFilled}
              className={`px-6 py-3 rounded-2xl font-bold text-xs flex items-center space-x-2 transition cursor-pointer shadow-lg ${
                isAllFilled
                  ? 'bg-gradient-to-r from-amber-500 via-amber-500 to-amber-600 text-zinc-950 shadow-[0_0_24px_rgba(245,158,11,0.35)] hover:shadow-[0_0_32px_rgba(245,158,11,0.55)] active:scale-95'
                  : 'bg-zinc-800 text-zinc-500 border border-zinc-700/60 cursor-not-allowed'
              }`}
            >
              <span>အဖြေစစ်ဆေးမည် (Submit)</span>
              <ArrowRight className="w-4 h-4" />
            </button>
          ) : (
            <button
              onClick={handleNextPuzzle}
              className="px-6 py-3 rounded-2xl bg-gradient-to-r from-emerald-500 to-emerald-600 text-zinc-950 font-bold text-xs flex items-center space-x-2 shadow-[0_0_24px_rgba(16,185,129,0.4)] hover:shadow-[0_0_36px_rgba(16,185,129,0.6)] transition cursor-pointer active:scale-95"
            >
              <span>
                {currentIndex < STAR_SCRAMBLE_CATALOG.length - 1 ? 'နောက်မေးခွန်းသို့ (Next)' : 'ရလဒ်ကို ကြည့်မည် (View Results)'}
              </span>
              <ChevronRight className="w-4 h-4" />
            </button>
          )}
        </div>

        {/* ------------------------------------------------------------- */}
        {/* POST-SUBMISSION RESULTS & GRAMMATICAL CHAIN LINKAGE DIAGRAM    */}
        {/* ------------------------------------------------------------- */}
        <AnimatePresence>
          {evaluation && (
            <motion.div
              initial={{ opacity: 0, y: 16 }}
              animate={{ opacity: 1, y: 0 }}
              exit={{ opacity: 0 }}
              className="space-y-6 pt-6 border-t border-zinc-800/80 font-myanmar"
            >
              {/* Outcome Status Banner */}
              <div
                className={`p-5 rounded-2xl border flex items-start justify-between gap-4 shadow-xl ${
                  evaluation.isStarCorrect
                    ? 'bg-emerald-950/70 border-emerald-500/60 shadow-[0_0_24px_rgba(16,185,129,0.25)]'
                    : 'bg-rose-950/70 border-rose-500/60 shadow-[0_0_24px_rgba(244,63,94,0.25)]'
                }`}
              >
                <div className="flex items-start gap-3.5">
                  <div
                    className={`w-10 h-10 rounded-xl flex items-center justify-center shrink-0 shadow-md ${
                      evaluation.isStarCorrect
                        ? 'bg-emerald-500/20 text-emerald-400 border border-emerald-500/40'
                        : 'bg-rose-500/20 text-rose-400 border border-rose-500/40'
                    }`}
                  >
                    {evaluation.isStarCorrect ? (
                      <CheckCircle2 className="w-5 h-5" />
                    ) : (
                      <XCircle className="w-5 h-5" />
                    )}
                  </div>

                  <div className="space-y-1">
                    <div className="flex items-center gap-2">
                      <span
                        className={`text-sm font-bold ${
                          evaluation.isStarCorrect ? 'text-emerald-200' : 'text-rose-200'
                        }`}
                      >
                        {evaluation.isStarCorrect ? '★ အဖြေမှန် (Correct) !' : '★ အဖြေမှား (Incorrect)'}
                      </span>
                      <span className="text-[10px] font-mono px-2 py-0.5 rounded-full bg-zinc-950 border border-zinc-800 text-zinc-300">
                        ရမှတ်: {evaluation.score} မှတ်
                      </span>
                    </div>

                    <p className="text-xs text-zinc-300 leading-relaxed">
                      {evaluation.feedbackMessage}
                    </p>

                    <div className="text-xs font-mono pt-1 text-zinc-400">
                      အဖြေမှန် စီစဉ်မှု (Correct Order):{' '}
                      <strong className="text-zinc-100">
                        {currentPuzzle.correctTokenOrder.join(' → ')}
                      </strong>{' '}
                      (★ = {currentPuzzle.starOptionNumber})
                    </div>
                  </div>
                </div>

                <button
                  onClick={() => handleSpeak(currentPuzzle.fullSentenceJa)}
                  className="p-2.5 rounded-xl bg-zinc-900 border border-zinc-800 text-zinc-300 hover:text-white hover:bg-zinc-800 transition cursor-pointer"
                  title="Speak complete sentence"
                >
                  <Volume2 className="w-4 h-4 text-indigo-400" />
                </button>
              </div>

              {/* Complete Correct Sentence Card */}
              <div className="bg-zinc-950/90 border border-zinc-800 rounded-2xl p-5 space-y-2.5 shadow-md">
                <span className="text-[10px] font-mono uppercase tracking-wider text-indigo-400 block">
                  အဖြေမှန် ဝါကျ အပြည့်အစုံ
                </span>
                <p className="text-base sm:text-lg font-bold font-japanese text-zinc-100 leading-relaxed">
                  {currentPuzzle.fullSentenceJa}
                </p>
                {currentPuzzle.fullSentenceMy ? (
                  <>
                    <p className="text-xs text-amber-300/90 font-myanmar leading-relaxed">
                      {currentPuzzle.fullSentenceMy}
                    </p>
                    {currentPuzzle.fullSentenceEn && (
                      <p className="text-xs text-zinc-400 font-sans">
                        {currentPuzzle.fullSentenceEn}
                      </p>
                    )}
                  </>
                ) : (
                  <p className="text-xs text-zinc-300 font-medium">
                    {currentPuzzle.fullSentenceEn}
                  </p>
                )}
              </div>

              {/* Grammatical Chain Linkage Diagram (接続チェーン解説) */}
              <div className="space-y-3">
                <div className="flex items-center space-x-2 text-xs font-semibold text-zinc-300 font-mono">
                  <Layers className="w-4 h-4 text-amber-400" />
                  <span>သဒ္ဒါစကားဆက် ဆက်စပ်မှု ရှင်းလင်းချက် (Chain Logic)</span>
                </div>

                <div className="grid grid-cols-1 gap-2.5">
                  {currentPuzzle.chainReasoning.map((link, idx) => (
                    <div
                      key={idx}
                      className="p-3.5 rounded-xl bg-zinc-900/60 border border-zinc-800/80 space-y-1.5 hover:border-zinc-700 transition"
                    >
                      <div className="flex items-center space-x-2 text-xs font-bold font-japanese text-zinc-200">
                        <span className="px-1.5 py-0.5 rounded bg-zinc-800 font-mono text-[10px] text-zinc-400">
                          အဆင့် {idx + 1}
                        </span>
                        <span className="text-indigo-300">{link.fromText}</span>
                        <ArrowRight className="w-3.5 h-3.5 text-zinc-500 shrink-0" />
                        <span className="text-amber-300">{link.toText}</span>
                      </div>

                      <p className="text-xs text-zinc-300 font-japanese leading-relaxed">
                        {link.ruleJa}
                      </p>
                      <p className="text-[11px] text-zinc-400">
                        {link.ruleEn}
                      </p>
                    </div>
                  ))}
                </div>
              </div>

              {/* Detailed Breakdown */}
              <div className="p-4 rounded-2xl bg-zinc-950/60 border border-zinc-800/80 text-xs text-zinc-400 space-y-1 leading-relaxed">
                <span className="font-bold text-zinc-200 block font-mono">
                  💡 ဖြေဆိုနည်း အဓိကအချက် (Strategy Insight):
                </span>
                <p>{currentPuzzle.detailedExplanation}</p>
              </div>
            </motion.div>
          )}
        </AnimatePresence>
      </div>
    </div>
  );
};
</file>

<file path="src/presentation/components/StorageDiagnosticsModal.tsx">
import React, { useState, useEffect, useRef } from 'react';
import {
  Database,
  HardDrive,
  RefreshCw,
  Download,
  Upload,
  CheckCircle,
  AlertCircle,
  Wifi,
  WifiOff,
  ShieldCheck,
  ShieldAlert,
  Layers,
  Sparkles,
  BookOpen,
  X,
  Activity,
  Archive,
  Clock,
  UserCheck,
  Zap,
} from 'lucide-react';
import {
  OfflineSyncManager,
  OfflineStorageDiagnostics,
} from '../../data/sync/offline-sync-manager';
import { BackupManager } from '../../data/backup/backup-manager';
import { AnkiExporter, AnkiExportScope } from '../../data/backup/anki-exporter';
import { AnkiSyncManager } from './AnkiSyncManager';

interface StorageDiagnosticsModalProps {
  isOpen: boolean;
  onClose: () => void;
  onDataRestored?: () => void;
}

export const StorageDiagnosticsModal: React.FC<StorageDiagnosticsModalProps> = ({
  isOpen,
  onClose,
  onDataRestored,
}) => {
  const [diag, setDiag] = useState<OfflineStorageDiagnostics | null>(null);
  const [loading, setLoading] = useState<boolean>(true);
  const [actionLoading, setActionLoading] = useState<string | null>(null);
  const [notification, setNotification] = useState<{
    type: 'success' | 'error' | 'info';
    message: string;
  } | null>(null);
  const [syncProgress, setSyncProgress] = useState<{ current: number; total: number; text: string } | null>(null);
  const [ankiScope, setAnkiScope] = useState<AnkiExportScope>('all');

  const fileInputRef = useRef<HTMLInputElement>(null);

  const loadDiagnostics = async () => {
    try {
      setLoading(true);
      const data = await OfflineSyncManager.getDiagnostics();
      setDiag(data);
    } catch (err: any) {
      setNotification({
        type: 'error',
        message: `Failed loading storage diagnostics: ${err.message}`,
      });
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    if (isOpen) {
      loadDiagnostics();
      setNotification(null);
      setSyncProgress(null);
    }
  }, [isOpen]);

  if (!isOpen) return null;

  // Handle Export JSON Backup
  const handleExportBackup = async () => {
    try {
      setActionLoading('export');
      const json = await BackupManager.exportToJson();
      const blob = new Blob([json], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `nihongo-master-backup-${new Date().toISOString().substring(0, 10)}.json`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
      setNotification({
        type: 'success',
        message: 'Complete local JSON backup exported and downloaded successfully.',
      });
      await loadDiagnostics();
    } catch (err: any) {
      setNotification({
        type: 'error',
        message: `Export failed: ${err.message}`,
      });
    } finally {
      setActionLoading(null);
    }
  };

  // Handle Import JSON Backup
  const handleImportBackup = async (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0];
    if (!file) return;

    try {
      setActionLoading('import');
      const text = await file.text();
      const result = await BackupManager.restoreFromJson(text);
      if (result.success) {
        setNotification({
          type: 'success',
          message: result.message || 'Data successfully restored from backup snapshot.',
        });
        await loadDiagnostics();
        if (onDataRestored) {
          onDataRestored();
        }
      } else {
        setNotification({
          type: 'error',
          message: result.message,
        });
      }
    } catch (err: any) {
      setNotification({
        type: 'error',
        message: `Failed to restore file: ${err.message}`,
      });
    } finally {
      setActionLoading(null);
      if (fileInputRef.current) fileInputRef.current.value = '';
    }
  };

  // Handle Export to Anki
  const handleExportAnki = async () => {
    try {
      setActionLoading('anki');
      const result = await AnkiExporter.downloadAnkiExport({ scope: ankiScope });
      setNotification({
        type: 'success',
        message: `Exported ${result.count} cards to Anki TSV (${result.filename}).`,
      });
      await loadDiagnostics();
    } catch (err: any) {
      setNotification({
        type: 'error',
        message: `Anki export failed: ${err.message}`,
      });
    } finally {
      setActionLoading(null);
    }
  };

  // Handle Clear Cache & Re-sync
  const handleClearCacheAndResync = async () => {
    if (!window.confirm('Clear temporary lesson cache and re-sync all local IndexedDB indices? Your study records, SRS cards, and profile will be safely preserved and verified.')) {
      return;
    }

    try {
      setActionLoading('resync');
      setNotification(null);
      const res = await OfflineSyncManager.clearCacheAndResync((step) => {
        setSyncProgress({ current: 0, total: 100, text: step });
      });

      if (res.success) {
        setNotification({
          type: 'success',
          message: res.message,
        });
        await loadDiagnostics();
        if (onDataRestored) {
          onDataRestored();
        }
      } else {
        setNotification({
          type: 'error',
          message: res.message,
        });
      }
    } catch (err: any) {
      setNotification({
        type: 'error',
        message: `Re-sync failed: ${err.message}`,
      });
    } finally {
      setActionLoading(null);
      setSyncProgress(null);
    }
  };

  // Pre-cache all published packs
  const handlePrecacheAllPacks = async () => {
    try {
      setActionLoading('precache');
      setNotification(null);
      await OfflineSyncManager.warmAllPublishedPacks((loaded, total, currentId) => {
        setSyncProgress({
          current: loaded,
          total,
          text: `Caching pack ${currentId} (${loaded}/${total})...`,
        });
      });
      setNotification({
        type: 'success',
        message: 'All published lesson packs are now cached offline in IndexedDB.',
      });
      await loadDiagnostics();
    } catch (err: any) {
      setNotification({
        type: 'error',
        message: `Pre-cache failed: ${err.message}`,
      });
    } finally {
      setActionLoading(null);
      setSyncProgress(null);
    }
  };

  // Request Persistent Storage
  const handleRequestPersistence = async () => {
    try {
      setActionLoading('persist');
      const granted = await OfflineSyncManager.requestPersistence();
      if (granted) {
        setNotification({
          type: 'success',
          message: 'Persistent storage granted by browser. Data will not be cleared during low disk space.',
        });
      } else {
        setNotification({
          type: 'info',
          message: 'Browser did not grant persistence or already at system policy level.',
        });
      }
      await loadDiagnostics();
    } catch (err: any) {
      setNotification({
        type: 'error',
        message: `Persistence request failed: ${err.message}`,
      });
    } finally {
      setActionLoading(null);
    }
  };

  // Flush pending offline queue
  const handleFlushQueue = async () => {
    try {
      setActionLoading('queue');
      const res = await OfflineSyncManager.flushPendingQueue();
      setNotification({
        type: 'success',
        message: res.message,
      });
      await loadDiagnostics();
    } catch (err: any) {
      setNotification({
        type: 'error',
        message: `Failed to flush queue: ${err.message}`,
      });
    } finally {
      setActionLoading(null);
    }
  };

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-4 bg-stone-950/80 backdrop-blur-md overflow-y-auto">
      <div className="relative w-full max-w-2xl bg-stone-900 border border-stone-800 rounded-2xl shadow-2xl overflow-hidden my-auto animate-in fade-in zoom-in-95 duration-150">
        {/* Subtle decorative top bar */}
        <div className="h-1 bg-gradient-to-r from-emerald-500 via-rose-500 to-amber-500" />

        {/* Modal Header */}
        <div className="flex items-center justify-between p-4 sm:p-5 border-b border-stone-800 bg-stone-950/60">
          <div className="flex items-center space-x-3">
            <div className="w-10 h-10 rounded-xl bg-stone-800 border border-stone-700 flex items-center justify-center text-rose-400 shadow-inner">
              <Database className="w-5 h-5 text-emerald-400" />
            </div>
            <div>
              <div className="flex items-center space-x-2">
                <h2 className="text-base sm:text-lg font-bold text-stone-100 tracking-tight">
                  PWA Offline Storage &amp; Sync Diagnostics
                </h2>
                <span className="text-[10px] px-2 py-0.5 rounded-full bg-emerald-950/80 text-emerald-300 border border-emerald-800 font-mono font-medium">
                  IndexedDB Dexie v{diag?.dbStatus.version || 2}
                </span>
              </div>
              <p className="text-xs text-stone-400 mt-0.5">
                Real-time inspection of local storage quota, cached lesson packs, SRS database, and sync queues.
              </p>
            </div>
          </div>

          <div className="flex items-center space-x-2">
            <button
              onClick={loadDiagnostics}
              disabled={loading || !!actionLoading}
              title="Refresh Diagnostics"
              className="p-2 text-stone-400 hover:text-stone-200 hover:bg-stone-800 rounded-lg transition active:scale-95 cursor-pointer disabled:opacity-50"
            >
              <RefreshCw className={`w-4 h-4 ${loading ? 'animate-spin text-rose-400' : ''}`} />
            </button>
            <button
              onClick={onClose}
              className="p-2 text-stone-400 hover:text-stone-200 hover:bg-stone-800 rounded-lg transition active:scale-95 cursor-pointer"
            >
              <X className="w-5 h-5" />
            </button>
          </div>
        </div>

        {/* Body Content */}
        <div className="p-4 sm:p-5 space-y-4 max-h-[75vh] overflow-y-auto">
          {/* Notification banner */}
          {notification && (
            <div
              className={`p-3 rounded-xl text-xs flex items-center justify-between space-x-2 animate-in fade-in ${
                notification.type === 'success'
                  ? 'bg-emerald-950/70 border border-emerald-800 text-emerald-300'
                  : notification.type === 'error'
                  ? 'bg-rose-950/70 border border-rose-800 text-rose-300'
                  : 'bg-stone-800 border border-stone-700 text-stone-300'
              }`}
            >
              <div className="flex items-center space-x-2">
                {notification.type === 'success' ? (
                  <CheckCircle className="w-4 h-4 text-emerald-400 shrink-0" />
                ) : notification.type === 'error' ? (
                  <AlertCircle className="w-4 h-4 text-rose-400 shrink-0" />
                ) : (
                  <Activity className="w-4 h-4 text-stone-400 shrink-0" />
                )}
                <span>{notification.message}</span>
              </div>
              <button
                onClick={() => setNotification(null)}
                className="text-stone-400 hover:text-stone-200 ml-2"
              >
                &times;
              </button>
            </div>
          )}

          {/* Sync Progress Indicator */}
          {syncProgress && (
            <div className="p-3 rounded-xl bg-stone-950 border border-stone-800 space-y-2">
              <div className="flex items-center justify-between text-xs text-stone-300">
                <span className="flex items-center space-x-1.5">
                  <RefreshCw className="w-3.5 h-3.5 animate-spin text-rose-400" />
                  <span>{syncProgress.text}</span>
                </span>
                {syncProgress.total > 0 && (
                  <span className="font-mono text-stone-400">
                    {syncProgress.current} / {syncProgress.total}
                  </span>
                )}
              </div>
              {syncProgress.total > 0 && (
                <div className="w-full bg-stone-800 h-1.5 rounded-full overflow-hidden">
                  <div
                    className="h-full bg-rose-500 transition-all duration-200"
                    style={{
                      width: `${Math.round((syncProgress.current / syncProgress.total) * 100)}%`,
                    }}
                  />
                </div>
              )}
            </div>
          )}

          {/* Key Health Indicators Grid */}
          <div className="grid grid-cols-1 sm:grid-cols-3 gap-3">
            {/* 1. Storage Usage & Quota */}
            <div className="p-3.5 rounded-xl bg-stone-950 border border-stone-800/80 space-y-2">
              <div className="flex items-center justify-between">
                <span className="text-[11px] font-semibold text-stone-400 flex items-center">
                  <HardDrive className="w-3.5 h-3.5 mr-1.5 text-emerald-400" /> Storage Quota
                </span>
                <span
                  className={`text-[10px] px-2 py-0.5 rounded font-mono font-medium ${
                    diag?.storage.isPersisted
                      ? 'bg-emerald-950 text-emerald-300 border border-emerald-800'
                      : 'bg-stone-800 text-stone-400'
                  }`}
                >
                  {diag?.storage.isPersisted ? 'Persisted' : 'Best-effort'}
                </span>
              </div>
