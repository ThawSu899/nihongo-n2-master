  "grammars": [
    {
      "id": "n3.l19.g001",
      "lessonId": "n3.l19",
      "pattern": "〜に限らず",
      "meaning": "not limited to... but also; not only... but widely",
      "formation": "[Noun] + に限らず",
      "explanation": {
        "en": "Used to state that a certain characteristic, trend, or condition is not restricted solely to the specified noun category, but extends broadly to a much wider scope, other generations, or global communities.",
        "my": "ဖော်ပြထားသော အရာ (သို့) အုပ်စုတစ်ခုတည်းတွင်သာ ကန့်သတ်မနေဘဲ အခြားသော နယ်ပယ်၊ မျိုးဆက် သို့မဟုတ် ကမ္ဘာအနှံ့ ကျယ်ပြန့်စွာ သက်ရောက်မှုရှိကြောင်း ဖော်ပြသည်။ \"၎င်းတွင်သာမက ... အထိပါ\" ဟု အဓိပ္ပာယ်ရသည်။"
      },
      "examples": [
        {
          "sentenceId": "n3.l19.s002",
          "note": "Aging society issues concern not only the youth generation, but the whole society."
        },
        {
          "sentenceId": "n3.l19.s006",
          "note": "This volunteer organization involves diverse nationalities, not limited to Japanese people."
        }
      ],
      "similarGrammarIds": [],
      "commonMistakes": [
        "Do not confuse with 〜に限る (which expresses that X is the supreme best choice). 〜に限らず explicitly denies the limitation."
      ],
      "level": "N3",
