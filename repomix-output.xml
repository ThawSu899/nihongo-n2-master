                <span className="inline-block mx-2.5 px-3 py-1 rounded-xl bg-zinc-950 border-2 border-indigo-500/70 text-indigo-200 font-mono shadow-inner min-w-[140px] align-middle ring-2 ring-indigo-500/20">
