                  </span>
                  <ChevronRight className="w-4 h-4" />
                </button>
              </>
            )}
          </div>
        </motion.div>
      </div>
    );
  }

  // ==========================================
  // VIEW 3: SUMMARY & CRAM DEBRIEF SCREEN
  // ==========================================
  const totalQuestions = sessionQuestions.length;
  const correctCount = sessionAnswers.filter((a) => a.isCorrect).length;
