  Settings,
  Sparkles,
  Clock,
  Database,
  Search,
  Menu,
  X,
  ChevronRight,
  Zap,
  Mic,
  Flame,
  Library,
  Award,
} from 'lucide-react';
import { UserProfile } from '../../domain/models/types';

interface NavigationProps {
  currentView: string;
  onNavigate: (view: string) => void;
  dueSrsCount: number;
  hasActiveSession?: boolean;
  isTestActive?: boolean;
  todayMinutes?: number;
  goalMinutes?: number;
  profile?: UserProfile | null;
  onOpenDiagnostics?: () => void;
  onOpenSearch?: () => void;
