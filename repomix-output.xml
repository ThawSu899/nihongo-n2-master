  params?: T;
}

export interface AnkiConnectResponse<T = any> {
  result: T;
  error: string | null;
}

export interface AnkiNoteFields {
  Front: string;
  Back: string;
  [key: string]: string;
}

export interface AnkiNotePayload {
  deckName: string;
  modelName: string;
  fields: AnkiNoteFields;
  tags: string[];
