                        >
                          <span>နောက်မေးခွန်းသို့ (Next) →</span>
                          <kbd className="text-[10px] px-1.5 py-0.5 rounded bg-stone-900 border border-stone-600 font-mono text-stone-300">
                            {getDisplayBadge('NEXT_ITEM')}
