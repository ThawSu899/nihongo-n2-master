  "grammars": [
    {
      "id": "n5.l23.g001",
      "lessonId": "n5.l23",
      "pattern": "[Plain Form] と 思います",
      "meaning": "I think that...",
      "formation": "Verb/Adj/Noun Plain Form + と + 思います / 思っています",
      "explanation": {
        "en": "Used to express personal opinions, guesses, or impressions: 日本の物価は高いと思います (I think Japan's prices are expensive). For nouns and な-adjectives in present affirmative, insert だ: 明日は暇だと思います.",
        "my": "မိမိ၏ သဘောထား၊ ယူဆချက်နှင့် ခန့်မှန်းချက်များကို ဖော်ပြရာတွင် 「ရိုးရိုးပုံစံ (Plain form) + と思います」 (...ဟု ထင်သည်/ယူဆသည်) ဟု သုံးသည်။ နာမ်နှင့် な-adjective တွင် 「だ」 ထည့်ရသည် (e.g. 暇だと思います)."
      },
      "examples": [
        {
          "sentenceId": "n5.l23.s001",
          "note": "Expressing opinion on Japanese"
        },
        {
          "sentenceId": "n5.l23.s003",
          "note": "Cost of living"
        }
      ],
      "similarGrammarIds": [],
      "commonMistakes": [
        "Do not use polite form before と思います (*高いですと思います is wrong; say 高いと思います). For nouns/な-adj do not forget だ (*便利と思います is wrong; say 便利だと思います)."
      ],
      "difficulty": 1,
      "level": "N5",
      "prov": {
        "source": "Nihongo N2 Master Editorial Team (Native Review)",
        "license": "CC-BY-4.0",
        "status": "reviewed",
        "updatedAt": "2026-10-01T00:00:00Z",
        "rev": 2
      },
