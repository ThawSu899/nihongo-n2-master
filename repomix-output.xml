<file path="src/presentation/hooks/useAudioPlayer.ts">
import { useState, useEffect, useCallback, useRef } from 'react';
import { AudioRef } from '../../domain/models/types';
import {
  sanitizePhoneticText,
  selectOptimalJapaneseVoice,
  getPhoneticUtteranceText,
  VocabularyAudioItem,
} from '../../domain/audio/tts-engine';

export interface SpeakerAcoustics {
  pitch: number;
  rateMultiplier: number;
  genderPreference: 'male' | 'female' | 'neutral';
}

export interface DialogueTurn {
  speaker?: string;
  text: string;
}

/**
 * Extracts pure Japanese text from question prompts, quotes, or conversational brackets.
 * If input contains Japanese in brackets 「...」 or 『...』, extracts the inner content.
 * If input has a speaker prefix like "ケン：...", extracts the spoken utterance.
 * Strips leading/trailing English prefixes if quotation marks surround Japanese content.
 */
export function cleanJapanesePrompt(text: string): string {
  if (!text) return '';
  const trimmed = text.trim();

  // 1. Japanese quotation brackets 「...」 or 『...』
  const bracketMatch = trimmed.match(/[「『]([^」』]+)[」』]/);
  if (bracketMatch) {
    return bracketMatch[1].trim();
  }

  // 2. Dialogue speaker prefix: "ケン：..." or "Ken: ..."
  const colonMatch = trimmed.match(/^[^：:\n]{1,25}[：:]\s*(.+)$/s);
  if (colonMatch && /[\u3040-\u30ff\u3400-\u4dbf\u4e00-\u9fff]/.test(colonMatch[1])) {
    return colonMatch[1].trim();
  }

  // 3. Western quotation marks enclosing Japanese text: "..." or “...”
  const quoteMatch = trimmed.match(/["“]([^"”]+)["”]/);
  if (quoteMatch && /[\u3040-\u30ff\u3400-\u4dbf\u4e00-\u9fff]/.test(quoteMatch[1])) {
    return quoteMatch[1].trim();
  }

  return trimmed;
}

/**
 * Parses full dialogue transcripts into speaker turns for turn-by-turn playback.
 */
export function parseDialogueTranscript(transcript: string): DialogueTurn[] {
  if (!transcript) return [];
  const lines = transcript.split('\n').map((l) => l.trim()).filter(Boolean);
  const turns: DialogueTurn[] = [];

  for (const line of lines) {
    const sepIdx = line.indexOf('：') !== -1 ? line.indexOf('：') : line.indexOf(':');
    if (sepIdx !== -1) {
      const spk = line.slice(0, sepIdx).trim();
      const txt = line.slice(sepIdx + 1).trim();
      if (txt) {
        turns.push({ speaker: spk, text: txt });
        continue;
      }
    }
    turns.push({ speaker: undefined, text: line });
  }

  return turns;
}

/**
 * Resolves acoustic parameters (pitch, rate multiplier, gender preference)
 * based on speaker name, character role, or honorific tags.
 * e.g., Tanaka-sensei (authoritative, deeper pitch, male), Ken (youthful learner, higher pitch, male),
 * female characters (higher pitch, female voice preference).
 */
export function resolveSpeakerAcoustics(speaker?: string): SpeakerAcoustics {
  if (!speaker) {
    return { pitch: 1.0, rateMultiplier: 1.0, genderPreference: 'neutral' };
  }

  const s = speaker.trim().toLowerCase();

  // Sensei / Professor / Senior Teachers (e.g. Tanaka-sensei, Kawaguchi-sensei, Mori-kyouju)
  if (
    s.includes('先生') ||
    s.includes('sensei') ||
    s.includes('教授') ||
    s.includes('tanaka') ||
    s.includes('たなか') ||
    s.includes('田中') ||
    s.includes('川口') ||
    s.includes('部長') ||
    s.includes('課長')
  ) {
    return { pitch: 0.88, rateMultiplier: 0.96, genderPreference: 'male' };
  }

  // Female characters / roles (e.g., Kyoko, Karina, Lisa, Yumi, Maya, Emi, Anna, female clerks)
  if (
    s.includes('kyoko') ||
    s.includes('きょうこ') ||
    s.includes('京子') ||
    s.includes('女性') ||
    s.includes('女') ||
    s.includes('カリナ') ||
    s.includes('リサ') ||
    s.includes('ユミ') ||
    s.includes('マヤ') ||
    s.includes('エミ') ||
    s.includes('アンナ') ||
    s.includes('ユキ') ||
    s.includes('エミリー') ||
    s.includes('マナ') ||
    s.includes('母') ||
    s.includes('姉') ||
    s.includes('妹')
  ) {
    return { pitch: 1.18, rateMultiplier: 1.0, genderPreference: 'female' };
  }

  // Young learners / students / energetic speakers (e.g., Ken, Takeshi, Mike, Carlos)
  if (
    s.includes('ケン') ||
    s.includes('ken') ||
    s.includes('マイク') ||
    s.includes('タケシ') ||
    s.includes('カルロス') ||
    s.includes('生徒') ||
    s.includes('後輩')
  ) {
    return { pitch: 1.12, rateMultiplier: 1.02, genderPreference: 'male' };
  }

  // Dialogue Turn A vs B default separation if only generic letters are provided
  if (speaker === 'A' || speaker === 'Person A') {
    return { pitch: 1.08, rateMultiplier: 1.0, genderPreference: 'female' };
  }
  if (speaker === 'B' || speaker === 'Person B') {
    return { pitch: 0.92, rateMultiplier: 0.98, genderPreference: 'male' };
  }

  return { pitch: 1.0, rateMultiplier: 1.0, genderPreference: 'neutral' };
}

export function useAudioPlayer() {
  const [isPlaying, setIsPlaying] = useState(false);
  const [currentPlayingText, setCurrentPlayingText] = useState<string | null>(null);
  const [activeSpeaker, setActiveSpeaker] = useState<string | null>(null);
  const [playbackRate, setPlaybackRate] = useState(1.0);
  const [hasJaVoice, setHasJaVoice] = useState(false);
  const [voiceName, setVoiceName] = useState<string>('');
  const [replayCount, setReplayCount] = useState<Record<string, number>>({});
  const [isShadowingLoop, setIsShadowingLoop] = useState<boolean>(false);
  const [shadowingTurnDelay, setShadowingTurnDelayState] = useState<number>(2000); // 1s - 3s (1000 - 3000ms)
  const [activeTurnIndex, setActiveTurnIndex] = useState<number>(-1);

  const audioElemRef = useRef<HTMLAudioElement | null>(null);
  const voicesRef = useRef<SpeechSynthesisVoice[]>([]);
  const isPlayingRef = useRef(false);
  const isShadowingLoopRef = useRef(false);
  const loopTimeoutRef = useRef<any>(null);

  // Sync ref with state for event callbacks
  useEffect(() => {
    isPlayingRef.current = isPlaying;
  }, [isPlaying]);

  useEffect(() => {
    isShadowingLoopRef.current = isShadowingLoop;
  }, [isShadowingLoop]);

  // Load and cache voices reliably across browser engines (Chrome, Safari, Firefox, Edge)
  useEffect(() => {
    if (typeof window === 'undefined' || !('speechSynthesis' in window)) return;

    const checkVoices = () => {
      try {
        const voices = window.speechSynthesis.getVoices();
        voicesRef.current = voices;

        // Find primary Japanese voice
        const jaVoice = voices.find(
          (v) =>
            v.lang.toLowerCase().startsWith('ja') ||
            v.lang.toLowerCase().replace('_', '-').startsWith('ja-jp')
        );

        if (jaVoice) {
          setHasJaVoice(true);
          setVoiceName(jaVoice.name);
        } else {
          // If no explicitly tagged ja voice, check if any voice has Japanese in its name
          const namedJaVoice = voices.find((v) => /japanese|nihongo/i.test(v.name));
          if (namedJaVoice) {
            setHasJaVoice(true);
            setVoiceName(namedJaVoice.name);
          } else {
            setHasJaVoice(false);
            setVoiceName('');
          }
        }
      } catch {
        setHasJaVoice(false);
      }
    };

    checkVoices();

    if ('speechSynthesis' in window) {
      window.speechSynthesis.onvoiceschanged = checkVoices;
    }

    return () => {
      if (typeof window !== 'undefined' && 'speechSynthesis' in window) {
        window.speechSynthesis.onvoiceschanged = null;
      }
    };
  }, []);

  const selectBestVoice = useCallback(
    (genderPreference: 'male' | 'female' | 'neutral'): SpeechSynthesisVoice | undefined => {
      const allVoices = voicesRef.current.length > 0
        ? voicesRef.current
        : (typeof window !== 'undefined' && 'speechSynthesis' in window ? window.speechSynthesis.getVoices() : []);
      return selectOptimalJapaneseVoice(allVoices, genderPreference);
    },
    []
  );

  const speakTts = useCallback(
    (text: string, speaker?: string, phoneticReading?: string) => {
      if (typeof window === 'undefined' || !('speechSynthesis' in window)) {
        setIsPlaying(false);
        setCurrentPlayingText(null);
        setActiveSpeaker(null);
        return;
      }

      try {
        // Cancel prior speech cleanly
        window.speechSynthesis.cancel();

        // Resume in case speech synthesis was paused by the browser engine
        if (window.speechSynthesis.paused) {
          window.speechSynthesis.resume();
        }

        const utteranceText = phoneticReading
          ? sanitizePhoneticText(phoneticReading)
          : sanitizePhoneticText(text);

        const utterance = new SpeechSynthesisUtterance(utteranceText || text);
        utterance.lang = 'ja-JP';

        const acoustics = resolveSpeakerAcoustics(speaker);
        utterance.pitch = acoustics.pitch;
        utterance.rate = Math.max(0.5, Math.min(2.0, playbackRate * acoustics.rateMultiplier));

        const matchedVoice = selectBestVoice(acoustics.genderPreference);
        if (matchedVoice) {
          utterance.voice = matchedVoice;
        }

        utterance.onstart = () => {
          setIsPlaying(true);
          setCurrentPlayingText(text);
          setActiveSpeaker(speaker || null);
        };

        utterance.onend = () => {
          setIsPlaying(false);
          setCurrentPlayingText(null);
          setActiveSpeaker(null);
        };

        utterance.onerror = (e) => {
          // 'canceled' or 'interrupted' is expected when stopping or starting a new sound
          if (e.error !== 'canceled' && e.error !== 'interrupted') {
            console.warn('SpeechSynthesis error:', e.error);
          }
          setIsPlaying(false);
          setCurrentPlayingText(null);
          setActiveSpeaker(null);
        };

        window.speechSynthesis.speak(utterance);
      } catch (err) {
        console.warn('SpeechSynthesis invocation failed:', err);
        setIsPlaying(false);
        setCurrentPlayingText(null);
        setActiveSpeaker(null);
      }
    },
    [playbackRate, selectBestVoice]
  );

  const playDialogue = useCallback(
    (transcript: string, onComplete?: () => void) => {
      if (typeof window === 'undefined') return;

      const turns = parseDialogueTranscript(transcript);
      if (turns.length === 0) {
        setIsPlaying(false);
        setCurrentPlayingText(null);
        setActiveSpeaker(null);
        return;
      }

      // Cancel any prior speech
      if ('speechSynthesis' in window) {
        window.speechSynthesis.cancel();
      }
      if (audioElemRef.current) {
        audioElemRef.current.pause();
        audioElemRef.current.currentTime = 0;
      }

      let currentTurnIdx = 0;

      const playNextTurn = () => {
        if (currentTurnIdx >= turns.length) {
          setIsPlaying(false);
          setCurrentPlayingText(null);
          setActiveSpeaker(null);
          if (onComplete) onComplete();
          return;
        }

        const turn = turns[currentTurnIdx];
        currentTurnIdx++;

        if (!('speechSynthesis' in window)) {
          setIsPlaying(false);
          return;
        }

        try {
          if (window.speechSynthesis.paused) {
            window.speechSynthesis.resume();
          }

          const utterance = new SpeechSynthesisUtterance(turn.text);
          utterance.lang = 'ja-JP';

          const acoustics = resolveSpeakerAcoustics(turn.speaker);
          utterance.pitch = acoustics.pitch;
          utterance.rate = Math.max(0.5, Math.min(2.0, playbackRate * acoustics.rateMultiplier));

          const matchedVoice = selectBestVoice(acoustics.genderPreference);
          if (matchedVoice) {
            utterance.voice = matchedVoice;
          }

          utterance.onstart = () => {
            setIsPlaying(true);
            setCurrentPlayingText(turn.text);
            setActiveSpeaker(turn.speaker || null);
          };

          utterance.onend = () => {
            // Small pause between speakers
            setTimeout(() => {
              playNextTurn();
            }, 350);
          };

          utterance.onerror = (e) => {
            if (e.error !== 'canceled' && e.error !== 'interrupted') {
              console.warn('SpeechSynthesis turn error:', e.error);
            }
            setIsPlaying(false);
            setCurrentPlayingText(null);
            setActiveSpeaker(null);
          };

          window.speechSynthesis.speak(utterance);
        } catch {
          setIsPlaying(false);
        }
      };

      playNextTurn();
    },
    [playbackRate, selectBestVoice]
  );

  const play = useCallback(
    (text: string, audioRef?: AudioRef, speaker?: string, phoneticReading?: string) => {
      if (typeof window === 'undefined') return;

      // Extract spoken Japanese text accurately if embedded in prompts or quotes
      const spokenText = cleanJapanesePrompt(text);
      if (!spokenText && !phoneticReading) return;

      // Update replay count for the requested item
      setReplayCount((prev) => ({
        ...prev,
        [text]: (prev[text] || 0) + 1,
      }));

      // Cancel any ongoing speech or audio
      if ('speechSynthesis' in window) {
        window.speechSynthesis.cancel();
      }
      if (audioElemRef.current) {
        audioElemRef.current.pause();
        audioElemRef.current.currentTime = 0;
      }

      // If audio file is provided and valid, try playing HTML5 Audio
      if (audioRef?.kind === 'file' && audioRef.fileId) {
        try {
          if (!audioElemRef.current) {
            audioElemRef.current = new Audio();
          }

          const elem = audioElemRef.current;
          elem.src = audioRef.fileId;
          elem.playbackRate = playbackRate;

          elem.onended = () => {
            setIsPlaying(false);
            setCurrentPlayingText(null);
            setActiveSpeaker(null);
          };

          elem.onerror = () => {
            // Smoothly degrade to Japanese TTS on file missing / 404 / format error
            speakTts(spokenText, speaker || audioRef.speaker, phoneticReading);
          };

          setIsPlaying(true);
          setCurrentPlayingText(text);
          setActiveSpeaker(speaker || audioRef.speaker || null);

          elem.play().catch(() => {
            // Audio element play failed (e.g. autoplay policy or unreachable URL) -> degrade to TTS
            speakTts(spokenText, speaker || audioRef.speaker, phoneticReading);
          });
          return;
        } catch {
          // Degradation path
          speakTts(spokenText, speaker || audioRef.speaker, phoneticReading);
          return;
        }
      }

      // If text looks like a multi-speaker dialogue transcript and has no specific audio file,
      // use multi-speaker dialogue playback with correct pitch switches!
      if (text.includes('\n') && (text.includes('：') || text.includes(':'))) {
        playDialogue(text);
        return;
      }

      // Default or TTS kind - pass verified phonetic reading if provided
      speakTts(spokenText, speaker || audioRef?.speaker, phoneticReading);
    },
    [playbackRate, speakTts, playDialogue]
  );

  const playVocabulary = useCallback(
    (
      vocab: { ja?: string; word?: string; kana?: string; reading?: string; audio?: AudioRef },
      speaker?: string
    ) => {
      const promptText = vocab.ja || vocab.word || '';
      const readingText = vocab.kana || vocab.reading || '';
      play(promptText || readingText, vocab.audio, speaker, readingText);
    },
    [play]
  );

  const setShadowingTurnDelay = useCallback((delayMs: number) => {
    const clamped = Math.max(1000, Math.min(3000, delayMs));
    setShadowingTurnDelayState(clamped);
  }, []);

  const stopShadowingLoop = useCallback(() => {
    isShadowingLoopRef.current = false;
    setIsShadowingLoop(false);
    setActiveTurnIndex(-1);
    if (loopTimeoutRef.current) {
      clearTimeout(loopTimeoutRef.current);
      loopTimeoutRef.current = null;
    }
  }, []);

  const stop = useCallback(() => {
    stopShadowingLoop();
    if (typeof window !== 'undefined' && 'speechSynthesis' in window) {
      window.speechSynthesis.cancel();
    }
    if (audioElemRef.current) {
      audioElemRef.current.pause();
      audioElemRef.current.currentTime = 0;
    }
    setIsPlaying(false);
    setCurrentPlayingText(null);
    setActiveSpeaker(null);
  }, [stopShadowingLoop]);

  const startShadowingLoop = useCallback(
    (
      turnsInput: DialogueTurn[] | string,
      customDelayMs?: number,
      startIdx: number = 0
    ) => {
      if (typeof window === 'undefined') return;

      const delay =
        customDelayMs !== undefined
          ? Math.max(1000, Math.min(3000, customDelayMs))
          : shadowingTurnDelay;

      const parsedTurns: DialogueTurn[] = Array.isArray(turnsInput)
        ? turnsInput
        : parseDialogueTranscript(turnsInput);

      if (parsedTurns.length === 0) return;

      stop();
      isShadowingLoopRef.current = true;
      setIsShadowingLoop(true);

      let currentIdx = Math.max(0, Math.min(startIdx, parsedTurns.length - 1));

      const playCurrentTurn = () => {
        if (!isShadowingLoopRef.current) return;

        setActiveTurnIndex(currentIdx);
        const turn = parsedTurns[currentIdx];

        if (!('speechSynthesis' in window)) {
          setIsPlaying(false);
          setIsShadowingLoop(false);
          return;
        }

        try {
          if (window.speechSynthesis.paused) {
            window.speechSynthesis.resume();
          }

          const utterance = new SpeechSynthesisUtterance(cleanJapanesePrompt(turn.text));
          utterance.lang = 'ja-JP';

          const acoustics = resolveSpeakerAcoustics(turn.speaker);
          utterance.pitch = acoustics.pitch;
          utterance.rate = Math.max(0.5, Math.min(2.0, playbackRate * acoustics.rateMultiplier));

          const matchedVoice = selectBestVoice(acoustics.genderPreference);
          if (matchedVoice) {
            utterance.voice = matchedVoice;
          }

          utterance.onstart = () => {
            setIsPlaying(true);
            setCurrentPlayingText(turn.text);
            setActiveSpeaker(turn.speaker || null);
          };

          utterance.onend = () => {
            setIsPlaying(false);
            if (!isShadowingLoopRef.current) return;

            // Wait for the configured speaker turn delay (1s-3s) for the learner to shadow
            loopTimeoutRef.current = setTimeout(() => {
              if (!isShadowingLoopRef.current) return;
              currentIdx = (currentIdx + 1) % parsedTurns.length;
              playCurrentTurn();
            }, delay);
          };

          utterance.onerror = (e) => {
            if (e.error !== 'canceled' && e.error !== 'interrupted') {
              console.warn('SpeechSynthesis turn error in shadowing loop:', e.error);
            }
            if (isShadowingLoopRef.current) {
              loopTimeoutRef.current = setTimeout(() => {
                if (!isShadowingLoopRef.current) return;
                currentIdx = (currentIdx + 1) % parsedTurns.length;
                playCurrentTurn();
              }, delay);
            } else {
              setIsPlaying(false);
              setActiveTurnIndex(-1);
            }
          };

          window.speechSynthesis.speak(utterance);
        } catch {
          setIsPlaying(false);
          setIsShadowingLoop(false);
        }
      };

      playCurrentTurn();
    },
    [playbackRate, selectBestVoice, shadowingTurnDelay, stop]
  );

  return {
    play,
    playVocabulary,
    playDialogue,
    stop,
    isPlaying,
    currentPlayingText,
    activeSpeaker,
    playbackRate,
    setPlaybackRate,
    hasJaVoice,
    voiceName,
    replayCount,
    isShadowingLoop,
    shadowingTurnDelay,
    setShadowingTurnDelay,
    activeTurnIndex,
    startShadowingLoop,
    stopShadowingLoop,
  };
}
</file>

<file path="src/presentation/screens/LevelBulkStudyScreen.tsx">
import React, { useState, useEffect, useMemo, useCallback } from 'react';
import { motion, AnimatePresence } from 'framer-motion';
import {
  ArrowLeft,
  Search,
  X,
  Volume2,
  BookOpen,
  Sparkles,
  Layers,
  ChevronDown,
  ChevronLeft,
  ChevronRight,
  Shuffle,
  Eye,
  EyeOff,
  RotateCcw,
  CheckCircle2,
  XCircle,
  Trophy,
  ArrowRight,
  HelpCircle,
  Zap,
  AlertTriangle,
} from 'lucide-react';
import { Vocabulary } from '../../domain/models/types';
import { ContentLoader } from '../../data/content/content-loader';
import { quarantineCard } from '../../domain/fsrs/quarantine-engine';
import { PitchAccentVisualizer } from '../components/PitchAccentVisualizer';
import { useAudioPlayer } from '../hooks/useAudioPlayer';
import { KanjiCardItem, extractKanjiForLevel } from '../../domain/curriculum/kanji-extractor';
import { KanjiDetailModal } from '../components/KanjiDetailModal';

export type JLPTLevel = 'N5' | 'N4' | 'N3' | 'N2';
export type StudyMode = 'list' | 'drill' | 'quiz';
export type BulkTab = 'vocab' | 'kanji';

export interface QuizQuestion {
  vocab: Vocabulary;
  correctAnswer: string;
  options: string[];
}

interface LevelBulkStudyScreenProps {
  onBack: () => void;
  className?: string;
  initialLevel?: JLPTLevel;
}

const JLPT_LEVELS: JLPTLevel[] = ['N5', 'N4', 'N3', 'N2'];
const PAGE_SIZE = 60;

function shuffleArray<T>(array: T[]): T[] {
  const arr = [...array];
  for (let i = arr.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [arr[i], arr[j]] = [arr[j], arr[i]];
  }
  return arr;
}

export function getBurmeseMeaning(v: Vocabulary): string {
  return (
    v.meaningMyanmar ||
    v.meaningMy ||
    v.my ||
    (v as any).meaningBurmese ||
    v.myanmar ||
    v.en ||
    ''
  );
}

export function generateQuizSession(vocabPool: Vocabulary[], questionCount = 10): QuizQuestion[] {
  if (!Array.isArray(vocabPool) || vocabPool.length === 0) return [];

  const validPool = vocabPool.filter((v) => getBurmeseMeaning(v).trim().length > 0);
  if (validPool.length === 0) return [];

  const shuffledPool = shuffleArray(validPool);
  const selectedVocab = shuffledPool.slice(0, Math.min(questionCount, shuffledPool.length));
  const allMeanings = Array.from(new Set(validPool.map((v) => getBurmeseMeaning(v))));

  return selectedVocab.map((vocab) => {
    const correctAnswer = getBurmeseMeaning(vocab);
    const distractors = shuffleArray(allMeanings.filter((m) => m !== correctAnswer)).slice(0, 3);
    const options = shuffleArray([correctAnswer, ...distractors]);

    return {
      vocab,
      correctAnswer,
      options,
    };
  });
}

export const LevelBulkStudyScreen: React.FC<LevelBulkStudyScreenProps> = ({
  onBack,
  className = '',
  initialLevel = 'N5',
}) => {
  const [selectedLevel, setSelectedLevel] = useState<JLPTLevel>(initialLevel);
  const [studyMode, setStudyMode] = useState<StudyMode>('list');
  const [searchQuery, setSearchQuery] = useState<string>('');
  const [words, setWords] = useState<Vocabulary[]>([]);
  const [loading, setLoading] = useState<boolean>(true);
  const [displayCount, setDisplayCount] = useState<number>(PAGE_SIZE);

  // Flashcard Drill State
  const [drillIndex, setDrillIndex] = useState<number>(0);
  const [isRevealed, setIsRevealed] = useState<boolean>(false);
  const [isShuffled, setIsShuffled] = useState<boolean>(false);
  const [drillDeck, setDrillDeck] = useState<Vocabulary[]>([]);

  // Quick Quiz State
  const [quizQuestions, setQuizQuestions] = useState<QuizQuestion[]>([]);
  const [quizCurrentIndex, setQuizCurrentIndex] = useState<number>(0);
  const [quizScore, setQuizScore] = useState<number>(0);
  const [quizSelectedOption, setQuizSelectedOption] = useState<string | null>(null);
  const [isQuizSubmitted, setIsQuizSubmitted] = useState<boolean>(false);
  const [isQuizCompleted, setIsQuizCompleted] = useState<boolean>(false);

  // Kanji Deck State
  const [bulkTab, setBulkTab] = useState<BulkTab>('vocab');
  const [kanjiList, setKanjiList] = useState<KanjiCardItem[]>([]);
  const [kanjiLoading, setKanjiLoading] = useState<boolean>(true);
  const [selectedKanji, setSelectedKanji] = useState<KanjiCardItem | null>(null);
  const [kanjiSearchQuery, setKanjiSearchQuery] = useState<string>('');

  // Quarantine Feedback Toast
  const [toastMessage, setToastMessage] = useState<{ id: number; text: string } | null>(null);

  useEffect(() => {
    if (!toastMessage) return;
    const timer = setTimeout(() => {
      setToastMessage(null);
    }, 3000);
    return () => clearTimeout(timer);
  }, [toastMessage]);

  const { play, stop, isPlaying, currentPlayingText } = useAudioPlayer();

  // Load and aggregate vocabulary across all lesson packs for selectedLevel
  useEffect(() => {
    let isCancelled = false;
    setLoading(true);
    setDisplayCount(PAGE_SIZE);

    ContentLoader.getVocabularyForLevel(selectedLevel)
      .then((loadedWords) => {
        if (!isCancelled) {
          setWords(loadedWords);
          setLoading(false);
        }
      })
      .catch((err) => {
        console.error(`[LevelBulkStudyScreen] Failed to load words for ${selectedLevel}:`, err);
        if (!isCancelled) {
          setWords([]);
          setLoading(false);
        }
      });

    return () => {
      isCancelled = true;
    };
  }, [selectedLevel]);

  // Search filtering by Kanji, Kana, English, or Burmese
  const filteredWords = useMemo(() => {
    const q = searchQuery.trim().toLowerCase();
    if (!q) return words;

    return words.filter((v) => {
      const ja = (v.ja || '').toLowerCase();
      const kana = (v.kana || '').toLowerCase();
      const en = (v.en || '').toLowerCase();
      const burmese = getBurmeseMeaning(v).toLowerCase();

      return ja.includes(q) || kana.includes(q) || en.includes(q) || burmese.includes(q);
    });
  }, [words, searchQuery]);

  // Load and aggregate Kanji across all lesson packs for selectedLevel
  useEffect(() => {
    let isCancelled = false;
    setKanjiLoading(true);

    extractKanjiForLevel(selectedLevel)
      .then((loaded) => {
        if (!isCancelled) {
          setKanjiList(loaded);
          setKanjiLoading(false);
        }
      })
      .catch((err) => {
        console.error(`[LevelBulkStudyScreen] Failed to load kanji for ${selectedLevel}:`, err);
        if (!isCancelled) {
          setKanjiList([]);
          setKanjiLoading(false);
        }
      });

    return () => {
      isCancelled = true;
    };
  }, [selectedLevel]);

  // Search filtering for Kanji
  const filteredKanji = useMemo(() => {
    const q = kanjiSearchQuery.trim().toLowerCase();
    if (!q) return kanjiList;

    return kanjiList.filter((k) => {
      const literal = (k.literal || '').toLowerCase();
      const onyomi = (k.onyomi || []).join(' ').toLowerCase();
      const kunyomi = (k.kunyomi || []).join(' ').toLowerCase();
      const burmese = (k.meaningBurmese || '').toLowerCase();
      const en = (k.meaningEn || '').toLowerCase();

      return (
        literal.includes(q) ||
        onyomi.includes(q) ||
        kunyomi.includes(q) ||
        burmese.includes(q) ||
        en.includes(q)
      );
    });
  }, [kanjiList, kanjiSearchQuery]);

  // Synchronize drill deck with filtered words
  useEffect(() => {
    if (isShuffled) {
      setDrillDeck(shuffleArray(filteredWords));
    } else {
      setDrillDeck(filteredWords);
    }
    setDrillIndex(0);
    setIsRevealed(false);
  }, [filteredWords, isShuffled]);

  // Start new quiz session helper
  const startNewQuiz = useCallback((pool: Vocabulary[]) => {
    const qs = generateQuizSession(pool, 10);
    setQuizQuestions(qs);
    setQuizCurrentIndex(0);
    setQuizScore(0);
    setQuizSelectedOption(null);
    setIsQuizSubmitted(false);
    setIsQuizCompleted(false);
  }, []);

  // When switching levels or words change while in quiz mode, regenerate questions
  useEffect(() => {
    if (studyMode === 'quiz' && words.length > 0) {
      startNewQuiz(filteredWords.length > 0 ? filteredWords : words);
    }
  }, [selectedLevel, studyMode, words, filteredWords, startNewQuiz]);

  // Sliced view for snappy rendering performance in list view
  const displayedWords = useMemo(() => {
    return filteredWords.slice(0, displayCount);
  }, [filteredWords, displayCount]);

  const handleTogglePlay = useCallback(
    (vocab: Vocabulary) => {
      if (isPlaying && (currentPlayingText === vocab.ja || currentPlayingText === vocab.kana)) {
        stop();
      } else {
        play(vocab.ja, vocab.audio, undefined, vocab.kana);
      }
    },
    [isPlaying, currentPlayingText, play, stop]
  );

  const handleLoadMore = () => {
    setDisplayCount((prev) => prev + PAGE_SIZE);
  };

  const handleNextDrill = useCallback(() => {
    if (drillIndex < drillDeck.length - 1) {
      setDrillIndex((prev) => prev + 1);
      setIsRevealed(false);
    }
  }, [drillIndex, drillDeck.length]);

  const handlePrevDrill = useCallback(() => {
    if (drillIndex > 0) {
      setDrillIndex((prev) => prev - 1);
      setIsRevealed(false);
    }
  }, [drillIndex]);

  const handleHardLapseDrill = useCallback(() => {
    const currentWord = drillDeck[drillIndex];
    if (!currentWord) return;

    // 1. Optimistic & Non-blocking Quarantine write
    quarantineCard({
      id: currentWord.id,
      itemType: 'vocabulary',
      wordOrPattern: currentWord.ja,
      reading: currentWord.kana,
      meaningBurmese: getBurmeseMeaning(currentWord),
      meaningEn: currentWord.en,
      jlptLevel: selectedLevel,
      quarantineReason: 'HIGH_LAPSE_COUNT',
      pitchPattern: currentWord.pitchPattern,
      dropIndex: currentWord.dropIndex,
    }).catch((err) => {
      console.warn('[LevelBulkStudyScreen] Failed to quarantine lapsed card:', err);
    });

    // 2. Push back into session queue for immediate reinforcement
    setDrillDeck((prev) => [...prev, currentWord]);

    // 3. Show subtle notification
    setToastMessage({
      id: Date.now(),
      text: `👻 "${currentWord.ja}" ကို Ghost Card ထဲသို့ ထည့်သွင်းပြီး`,
    });

    // 4. Advance to the next card and reset reveal state
    setDrillIndex((prev) => prev + 1);
    setIsRevealed(false);
  }, [drillDeck, drillIndex, selectedLevel]);

  const handleToggleShuffle = () => {
    if (isShuffled) {
      setIsShuffled(false);
      setDrillDeck(filteredWords);
    } else {
      setIsShuffled(true);
      setDrillDeck(shuffleArray(filteredWords));
    }
    setDrillIndex(0);
    setIsRevealed(false);
  };

  // Automatic audio pronunciation when card is revealed in Flashcard Drill Mode
  useEffect(() => {
    if (studyMode === 'drill' && isRevealed) {
      const v = drillDeck[drillIndex];
      if (v) {
        play(v.ja, v.audio, undefined, v.kana);
      }
    }
  }, [studyMode, isRevealed, drillIndex, drillDeck, play]);

  // Global keyboard shortcuts for Flashcard Drill Mode & Quiz Mode
  useEffect(() => {
    const handleKeyDown = (e: KeyboardEvent) => {
      if (['INPUT', 'TEXTAREA'].includes((e.target as HTMLElement)?.tagName)) {
        return;
      }

      if (studyMode === 'drill' && drillDeck.length > 0) {
        if (e.code === 'Space') {
          e.preventDefault();
          setIsRevealed((prev) => !prev);
        } else if (e.key === 'ArrowRight' || e.code === 'ArrowRight') {
          e.preventDefault();
          handleNextDrill();
        } else if (e.key === 'ArrowLeft' || e.code === 'ArrowLeft') {
          e.preventDefault();
          handlePrevDrill();
        } else if (e.key.toLowerCase() === 'h' || e.code === 'KeyH') {
          e.preventDefault();
          handleHardLapseDrill();
        } else if (e.key.toLowerCase() === 'r') {
          e.preventDefault();
          const v = drillDeck[drillIndex];
          if (v) {
            play(v.ja, v.audio, undefined, v.kana);
          }
        }
      } else if (studyMode === 'quiz' && quizQuestions.length > 0 && !isQuizCompleted) {
        const currentQ = quizQuestions[quizCurrentIndex];
        if (!isQuizSubmitted && currentQ) {
          if (['1', '2', '3', '4'].includes(e.key)) {
            const optIdx = parseInt(e.key, 10) - 1;
            if (currentQ.options[optIdx]) {
              e.preventDefault();
              handleSelectQuizOption(currentQ.options[optIdx]);
            }
          }
        } else if (isQuizSubmitted) {
          if (e.code === 'Space' || e.key === 'Enter') {
            e.preventDefault();
            handleNextQuizQuestion();
          }
        }

        if (e.key.toLowerCase() === 'r' && currentQ) {
          e.preventDefault();
          play(currentQ.vocab.ja, currentQ.vocab.audio, undefined, currentQ.vocab.kana);
        }
      }
    };

    window.addEventListener('keydown', handleKeyDown);
    return () => window.removeEventListener('keydown', handleKeyDown);
  }, [
    studyMode,
    drillIndex,
    drillDeck,
    handleNextDrill,
    handlePrevDrill,
    handleHardLapseDrill,
    quizQuestions,
    quizCurrentIndex,
    isQuizSubmitted,
    isQuizCompleted,
    play,
  ]);

  // Quiz Option Click Handler
  const handleSelectQuizOption = (option: string) => {
    if (isQuizSubmitted) return;

    const currentQ = quizQuestions[quizCurrentIndex];
    if (!currentQ) return;

    setQuizSelectedOption(option);
    setIsQuizSubmitted(true);

    const isCorrect = option === currentQ.correctAnswer;
    if (isCorrect) {
      setQuizScore((prev) => prev + 1);
      // Play speech synthesis on correct answer
      play(currentQ.vocab.ja, currentQ.vocab.audio, undefined, currentQ.vocab.kana);
    } else {
      // Optimistic & non-blocking quarantine write
      quarantineCard({
        id: currentQ.vocab.id,
        itemType: 'vocabulary',
        wordOrPattern: currentQ.vocab.ja,
        reading: currentQ.vocab.kana,
        meaningBurmese: getBurmeseMeaning(currentQ.vocab),
        meaningEn: currentQ.vocab.en,
        jlptLevel: selectedLevel,
        quarantineReason: 'MOCK_TEST_REPEATED_MISS',
        pitchPattern: currentQ.vocab.pitchPattern,
        dropIndex: currentQ.vocab.dropIndex,
      }).catch((err) => {
        console.warn('[LevelBulkStudyScreen] Failed to quarantine missed quiz card:', err);
      });

      setToastMessage({
        id: Date.now(),
        text: `👻 "${currentQ.vocab.ja}" ကို Ghost Card ထဲသို့ ထည့်သွင်းပြီး`,
      });
    }
  };

  const handleNextQuizQuestion = () => {
    if (quizCurrentIndex < quizQuestions.length - 1) {
      setQuizCurrentIndex((prev) => prev + 1);
      setQuizSelectedOption(null);
      setIsQuizSubmitted(false);
    } else {
      setIsQuizCompleted(true);
    }
  };

  const currentDrillWord: Vocabulary | undefined = drillDeck[drillIndex];
  const currentQuizQ: QuizQuestion | undefined = quizQuestions[quizCurrentIndex];

  return (
    <div className={`space-y-6 max-w-7xl mx-auto pb-16 ${className}`}>
      {/* Top Header & Breadcrumb */}
      <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-zinc-800/80 pb-4">
        <div className="flex items-center space-x-3">
          <button
            onClick={onBack}
            className="p-2.5 rounded-xl bg-zinc-900 hover:bg-zinc-850 border border-zinc-800 text-zinc-400 hover:text-zinc-100 transition cursor-pointer"
            title="Back to Dashboard"
          >
            <ArrowLeft className="w-5 h-5" />
          </button>
          <div>
            <div className="flex items-center space-x-2">
              <span className="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-rose-950/80 border border-rose-500/40 text-[11px] font-bold text-rose-300">
                <BookOpen className="w-3.5 h-3.5 text-rose-400" />
                <span>Level Decks (単語帳)</span>
              </span>
              <span className="text-xs font-mono text-zinc-500">
                {`JLPT ${selectedLevel} Bulk Study`}
              </span>
            </div>
            <h1 className="text-xl sm:text-2xl font-bold text-zinc-100 tracking-tight mt-0.5">
              {bulkTab === 'vocab'
                ? `${selectedLevel} Comprehensive Vocabulary Deck`
                : `${selectedLevel} Kanji Deck & Stroke Visualizer`}
            </h1>
          </div>
        </div>

        {/* Primary Segmented Mode Selector: Vocabulary vs Kanji */}
        <div className="flex items-center p-1 bg-zinc-900/90 border border-zinc-800 rounded-2xl shadow-inner">
          <button
            type="button"
            onClick={() => setBulkTab('vocab')}
            className={`px-3.5 py-1.5 rounded-xl text-xs font-burmese font-semibold transition cursor-pointer flex items-center space-x-1.5 ${
              bulkTab === 'vocab'
                ? 'bg-rose-600 text-white shadow-md shadow-rose-950/50'
                : 'text-zinc-400 hover:text-zinc-200 hover:bg-zinc-850'
            }`}
          >
            <span>📖 ဝေါဟာရ (Vocabulary)</span>
          </button>
          <button
            type="button"
            onClick={() => setBulkTab('kanji')}
            className={`px-3.5 py-1.5 rounded-xl text-xs font-burmese font-semibold transition cursor-pointer flex items-center space-x-1.5 ${
              bulkTab === 'kanji'
                ? 'bg-rose-600 text-white shadow-md shadow-rose-950/50'
                : 'text-zinc-400 hover:text-zinc-200 hover:bg-zinc-850'
            }`}
          >
            <span>🈁 ခန်းဂျီး (Kanji Deck)</span>
          </button>
        </div>

        {/* Header Right: Total Count Badge & Segmented 3-Mode Switcher */}
        {bulkTab === 'vocab' ? (
          <div className="flex items-center flex-wrap gap-2.5">
            <span className="px-3 py-1.5 rounded-xl bg-zinc-900 border border-zinc-800 text-xs font-mono text-zinc-300 flex items-center gap-1.5 shadow-inner">
              <Layers className="w-3.5 h-3.5 text-rose-400" />
              <span>{`${selectedLevel} Deck: ${words.length} words`}</span>
            </span>

            {/* 3-Mode Segmented Switcher */}
            <div className="flex items-center space-x-1 p-1 bg-zinc-900/90 border border-zinc-800 rounded-2xl shadow-inner overflow-x-auto">
              <button
                type="button"
                onClick={() => setStudyMode('list')}
                className={`px-3 py-1.5 rounded-xl text-xs font-medium transition cursor-pointer flex items-center space-x-1.5 shrink-0 ${
                  studyMode === 'list'
                    ? 'bg-rose-600 text-white font-semibold shadow-md shadow-rose-950/50'
                    : 'text-zinc-400 hover:text-zinc-200 hover:bg-zinc-850'
                }`}
              >
                <span>📜 စာရင်းကြည့် (List View)</span>
              </button>
              <button
                type="button"
                onClick={() => {
                  setStudyMode('drill');
                  setIsRevealed(false);
                }}
                className={`px-3 py-1.5 rounded-xl text-xs font-medium transition cursor-pointer flex items-center space-x-1.5 shrink-0 ${
                  studyMode === 'drill'
                    ? 'bg-rose-600 text-white font-semibold shadow-md shadow-rose-950/50'
                    : 'text-zinc-400 hover:text-zinc-200 hover:bg-zinc-850'
                }`}
              >
                <span>🎴 Flashcard လေ့ကျင့်ရန် (Drill Mode)</span>
              </button>
              <button
                type="button"
                onClick={() => {
                  setStudyMode('quiz');
                  startNewQuiz(filteredWords.length > 0 ? filteredWords : words);
                }}
                className={`px-3 py-1.5 rounded-xl text-xs font-medium transition cursor-pointer flex items-center space-x-1.5 shrink-0 ${
                  studyMode === 'quiz'
                    ? 'bg-rose-600 text-white font-semibold shadow-md shadow-rose-950/50'
                    : 'text-zinc-400 hover:text-zinc-200 hover:bg-zinc-850'
                }`}
              >
                <span>⚡ အမြန်စစ်ဆေးမေးခွန်း (Quiz Mode)</span>
              </button>
            </div>
          </div>
        ) : (
          <div className="flex items-center gap-2.5">
            <span className="px-3.5 py-1.5 rounded-xl bg-zinc-900 border border-zinc-800 text-xs font-mono text-zinc-300 flex items-center gap-1.5 shadow-inner">
              <Sparkles className="w-3.5 h-3.5 text-amber-400" />
              <span>{`${selectedLevel} Kanji: ${kanjiList.length} 字`}</span>
            </span>
          </div>
        )}
      </div>

      {/* Header Controls: Level Selector & Sticky Search Bar (Visible across all tabs) */}
      <div className="sticky top-0 z-30 bg-zinc-950/90 backdrop-blur-2xl border-y border-zinc-800/90 py-3.5 px-1 space-y-3 shadow-xl">
        <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          {/* Level Selector Pills */}
          <div className="flex items-center space-x-2 overflow-x-auto pb-1 sm:pb-0">
            {JLPT_LEVELS.map((lvl) => {
              const active = selectedLevel === lvl;
              return (
                <button
                  key={lvl}
                  type="button"
                  onClick={() => {
                    setSelectedLevel(lvl);
                    setSearchQuery('');
                    setKanjiSearchQuery('');
                  }}
                  className={`px-4 py-2 rounded-xl text-xs font-mono font-bold transition-all cursor-pointer flex items-center space-x-1.5 ${
                    active
                      ? 'bg-gradient-to-r from-rose-600 to-rose-700 text-white shadow-[0_0_16px_rgba(244,63,94,0.5)] border border-rose-500/50 scale-105'
                      : 'bg-zinc-900/90 hover:bg-zinc-850 text-zinc-400 hover:text-zinc-200 border border-zinc-800'
                  }`}
                >
                  <span>{`JLPT ${lvl}`}</span>
                  {active && <span className="w-1.5 h-1.5 rounded-full bg-white shadow-xs" />}
                </button>
              );
            })}
          </div>

          {/* Results Summary Counter */}
          <div className="text-xs font-mono text-zinc-400 shrink-0">
            {bulkTab === 'vocab' ? (
              studyMode === 'quiz' ? (
                <span>
                  Active Quiz: <strong className="text-zinc-200">{quizQuestions.length}</strong> questions sampled from {words.length} words
                </span>
              ) : searchQuery.trim() ? (
                <span>
                  Matching: <strong className="text-zinc-200">{filteredWords.length}</strong> / {words.length} words
                </span>
              ) : (
                <span>
                  Showing: <strong className="text-zinc-200">{Math.min(displayCount, words.length)}</strong> of {words.length} words
                </span>
              )
            ) : kanjiSearchQuery.trim() ? (
              <span>
                Matching: <strong className="text-zinc-200">{filteredKanji.length}</strong> / {kanjiList.length} kanji
              </span>
            ) : (
              <span>
                Total: <strong className="text-zinc-200">{kanjiList.length}</strong> kanji characters
              </span>
            )}
          </div>
        </div>

        {/* Search Bar with Instant Clear */}
        <div className="relative">
          <Search className="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-zinc-500" />
          <input
            type="text"
            value={bulkTab === 'vocab' ? searchQuery : kanjiSearchQuery}
            onChange={(e) => {
              if (bulkTab === 'vocab') {
                setSearchQuery(e.target.value);
              } else {
                setKanjiSearchQuery(e.target.value);
              }
            }}
            placeholder={
              bulkTab === 'vocab'
                ? `Search ${selectedLevel} words by Kanji (例: 行く), Kana (例: いく), English, or Burmese...`
                : `Search ${selectedLevel} kanji by Character (例: 学), Onyomi (例: ガク), Kunyomi, or Burmese...`
            }
            className="w-full bg-zinc-900/90 border border-zinc-800 focus:border-rose-500/60 rounded-xl pl-10 pr-10 py-2.5 text-xs text-zinc-100 placeholder-zinc-500 focus:outline-none focus:ring-1 focus:ring-rose-500/40 transition font-sans shadow-inner"
          />
          {(bulkTab === 'vocab' ? searchQuery : kanjiSearchQuery) && (
            <button
              onClick={() => {
                if (bulkTab === 'vocab') {
                  setSearchQuery('');
                } else {
                  setKanjiSearchQuery('');
                }
              }}
              className="absolute right-3 top-1/2 -translate-y-1/2 p-1 text-zinc-400 hover:text-zinc-200 transition cursor-pointer"
