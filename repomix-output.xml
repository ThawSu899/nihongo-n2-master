  "listening": {
    "id": "n3.l35.lis001",
    "lessonId": "n3.l35",
    "title": "新しい居酒屋の感想",
    "level": "N3",
    "audio": {
      "kind": "tts",
      "lang": "ja-JP"
    },
    "speakers": [
      "高橋",
      "森田"
    ],
