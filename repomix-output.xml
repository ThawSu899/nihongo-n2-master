      for (let i = 0; i < card.lapses; i++) {
        await db.review_logs.put({
          id: `log_seed_${card.id}_${i}`,
          cardId: card.id,
          rating: 'again',
          elapsedMs: 2500,
          reviewedAt: new Date(Date.now() - (card.lapses - i) * 86400000).toISOString(),
          priorIntervalDays: 1,
