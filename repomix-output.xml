  "grammars": [
    {
      "id": "n3.l21.g001",
      "lessonId": "n3.l21",
      "pattern": "〜つつ（も）",
      "meaning": "while doing ... / although, despite ...",
      "formation": "Verb [Stem Form] + つつ（も）",
      "explanation": {
        "en": "Expresses two ongoing actions proceeding in parallel (formal equivalent of 〜ながら in written or formal spoken Japanese), or expresses a psychological concession (\"although I realize/know... yet I do the opposite\"). When used for parallel action, both clauses occur simultaneously. When followed by も (〜つつも), it emphasizes internal contradiction between awareness and action.",
        "my": "လုပ်ဆောင်ချက်နှစ်ခု တစ်ပြိုင်နက်တည်း ယှဉ်တွဲဖြစ်ပေါ်နေခြင်း (〜ながら ၏ စာသုံး/စကားသုံးပုံစံ) သို့မဟုတ် သိလျက်နှင့် ဆန့်ကျင်ဘက်ဖြစ်နေသော စိတ်ပိုင်းဆိုင်ရာ ပဋိပက္ခ (\"...သိနေသော်လည်း/...သတိပြုမိလျက်နှင့်\") ကို ဖော်ပြသည်။"
      },
      "examples": [
        {
          "sentenceId": "n3.l21.s001",
          "note": "Simultaneous progression of planning and execution"
        },
        {
          "sentenceId": "n3.l21.s002",
          "note": "Psychological contrast: aware of flaws while striving forward"
        }
      ],
      "similarGrammarIds": [],
      "commonMistakes": [
        "Do not attach 〜つつ to past tense (❌ 行ったつつ → ⭕️ 行きつつ).",
        "For momentary non-continuous single actions, use 〜た上で or 〜てから rather than 〜つつ."
      ],
      "level": "N3",
      "difficulty": 2,
      "prov": {
        "source": "Nihongo N2 Master Editorial Team (AI-Assisted Editorial Authoring)",
        "license": "CC-BY-4.0",
        "status": "reviewed",
        "updatedAt": "2026-10-02T00:00:00Z",
        "rev": 1
      },
      "explanationMy": "လုပ်ဆောင်ချက်နှစ်ခု တစ်ပြိုင်နက်တည်း ယှဉ်တွဲဖြစ်ပေါ်နေခြင်း (〜ながら ၏ စာသုံး/စကားသုံးပုံစံ) သို့မဟုတ် သိလျက်နှင့် ဆန့်ကျင်ဘက်ဖြစ်နေသော စိတ်ပိုင်းဆိုင်ရာ ပဋိပက္ခ (\"...သိနေသော်လည်း/...သတိပြုမိလျက်နှင့်\") ကို ဖော်ပြသည်။",
