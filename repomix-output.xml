    "id": "n3.l46.lis001",
    "lessonId": "n3.l46",
    "title": "取引先での商談と挨拶",
    "level": "N3",
    "audio": {
      "kind": "tts",
      "lang": "ja-JP"
    },
    "speakers": [
      "A",
      "B"
    ],
