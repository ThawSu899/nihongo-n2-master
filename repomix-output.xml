  "grammars": [
    {
      "id": "n3.l17.g001",
      "lessonId": "n3.l17",
      "pattern": "〜せいで / 〜せいか / 〜せいだ",
      "meaning": "because of; due to (negative outcome / blame); perhaps because of",
      "formation": "[Verb Plain / い-Adj] + せいで\n[な-Adj な] + せいで\n[Noun の] + せいで\n文末: 〜のせいだ\n不確実な原因: 〜せいか (perhaps on account of)",
      "explanation": {
        "en": "Used when attributing an undesirable, frustrating, or unfortunate result to a specific person, factor, or circumstance. It assigns blame or dissatisfaction. When followed by か (〜せいか), it indicates a tentative suspicion about the cause.",
        "my": "မကောင်းသောရလဒ်၊ ထိခိုက်နစ်နာမှု (သို့) စိတ်ပျက်ဖွယ်ကိစ္စတစ်ခုသည် မည်သည့်အကြောင်းရင်း (သို့) မည်သူ့ကြောင့် ဖြစ်ရသည်ကို အပြစ်တင်ဖော်ပြရာတွင် သုံးသည်။「〜せいか」သည် အကြောင်းရင်းကို မသေချာဘဲ ရိပ်မိရုံဖော်ပြခြင်း ဖြစ်သည်။"
      },
      "examples": [
        {
          "sentenceId": "n3.l17.s001",
          "note": "The soccer match was postponed because of sudden bad weather."
        },
        {
          "sentenceId": "n3.l17.s004",
          "note": "Perhaps because of working late last night, I have a headache today."
        }
      ],
      "similarGrammarIds": [],
      "commonMistakes": [
        "Do not use 〜せいで for positive or successful outcomes; use 〜おかげで instead (e.g. ❌ 教えてくれたせいで合格した → ⭕️ 教えてくれたおかげで合格した)."
      ],
      "level": "N3",
