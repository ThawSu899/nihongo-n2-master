<file path="src/presentation/hooks/useChoukaiAudio.ts">
import { useState, useEffect, useRef, useCallback } from 'react';
import {
  ChoukaiAudioEngine,
  ChoukaiSpeed,
} from '../../domain/audio/choukai-audio-engine';
import { ChoukaiScenario, ChoukaiLine } from '../../domain/assessment/choukai-catalog';

export function useChoukaiAudio(initialScenario?: ChoukaiScenario) {
  const engineRef = useRef<ChoukaiAudioEngine | null>(null);

  const [isPlaying, setIsPlaying] = useState<boolean>(false);
  const [isPaused, setIsPaused] = useState<boolean>(false);
  const [currentLineIndex, setCurrentLineIndex] = useState<number>(0);
  const [currentLine, setCurrentLine] = useState<ChoukaiLine | null>(
    initialScenario?.dialogue[0] || null
  );
  const [playbackRate, setPlaybackRateState] = useState<ChoukaiSpeed>(1.0);
  const [isShadowingLoop, setIsShadowingLoopState] = useState<boolean>(false);
  const [shadowingTurnDelay, setShadowingTurnDelayState] = useState<number>(2000);
  const [waveformAmplitude, setWaveformAmplitude] = useState<number>(0.05);
  const [isComplete, setIsComplete] = useState<boolean>(false);

  // Initialize engine once
  if (!engineRef.current) {
    engineRef.current = new ChoukaiAudioEngine();
  }

  // Subscribe to callbacks
  useEffect(() => {
    const engine = engineRef.current;
    if (!engine) return;

    engine.setCallbacks({
      onLineChange: (index, line) => {
        setCurrentLineIndex(index);
        setCurrentLine(line);
      },
      onStateChange: (playing, paused) => {
        setIsPlaying(playing);
        setIsPaused(paused);
      },
      onComplete: () => {
        setIsComplete(true);
      },
      onWaveformTick: (amp) => {
        setWaveformAmplitude(amp);
      },
    });

    if (initialScenario) {
      engine.loadScenario(initialScenario);
      setCurrentLine(initialScenario.dialogue[0] || null);
    }

    return () => {
      engine.stop();
    };
  }, []);

  // Update scenario when prop changes
  const loadScenario = useCallback((scenario: ChoukaiScenario) => {
    if (!engineRef.current) return;
    engineRef.current.loadScenario(scenario);
    setCurrentLineIndex(0);
    setCurrentLine(scenario.dialogue[0] || null);
    setIsComplete(false);
  }, []);

  const play = useCallback((startLineIndex?: number) => {
    if (!engineRef.current) return;
    setIsComplete(false);
    engineRef.current.play(startLineIndex ?? currentLineIndex);
  }, [currentLineIndex]);

  const playSingleLine = useCallback((lineIndex: number) => {
    if (!engineRef.current) return;
    setIsComplete(false);
    engineRef.current.playLine(lineIndex);
  }, []);

  const pause = useCallback(() => {
    if (!engineRef.current) return;
    engineRef.current.pause();
  }, []);

  const resume = useCallback(() => {
    if (!engineRef.current) return;
    engineRef.current.resume();
  }, []);

  const stop = useCallback(() => {
    if (!engineRef.current) return;
    engineRef.current.stop();
  }, []);

  const setSpeed = useCallback((speed: ChoukaiSpeed) => {
    if (!engineRef.current) return;
    engineRef.current.setSpeed(speed);
    setPlaybackRateState(speed);
  }, []);

  const toggleShadowingLoop = useCallback(() => {
    if (!engineRef.current) return;
    const nextState = !isShadowingLoop;
    engineRef.current.setShadowingLoop(nextState);
    setIsShadowingLoopState(nextState);
  }, [isShadowingLoop]);

  const setShadowingTurnDelay = useCallback((delayMs: number) => {
    if (!engineRef.current) return;
    engineRef.current.setShadowingTurnDelay(delayMs);
    setShadowingTurnDelayState(delayMs);
  }, []);

  return {
    isPlaying,
    isPaused,
    currentLineIndex,
    currentLine,
    playbackRate,
    isShadowingLoop,
    shadowingTurnDelay,
    waveformAmplitude,
    isComplete,
    play,
    playSingleLine,
    pause,
    resume,
    stop,
    setSpeed,
    toggleShadowingLoop,
    setShadowingTurnDelay,
    loadScenario,
  };
}
</file>

<file path="src/presentation/hooks/useTimer.ts">
import { useState, useEffect, useCallback, useRef } from 'react';
import { StudyTimerState } from '../../domain/models/types';
import { TimerEngine } from '../../domain/timer/timer-engine';
import { SystemClock } from '../../domain/common/clock';
import { db } from '../../data/db/dexie-db';
import { EventRepository } from '../../data/repositories/event-repository';
import { syncUserStudyStreak } from '../../domain/analytics/streak-calculator';

const clock = new SystemClock();
const timerEngine = new TimerEngine(clock);
const TIMER_STORAGE_KEY = 'nihongo_n2_active_timer';

export function useTimer(onBlockCompleted?: (blockId: string, durationSec: number) => void) {
  const [timerState, setTimerState] = useState<StudyTimerState>(() => {
    try {
      const stored = localStorage.getItem(TIMER_STORAGE_KEY);
      if (stored) {
        return JSON.parse(stored);
      }
    } catch {
      // Fallback
    }
    return timerEngine.createInitialState(60, null);
  });

  const [elapsedSec, setElapsedSec] = useState<number>(0);
  const [remainingSec, setRemainingSec] = useState<number>(60 * 60);
  const [isIdlePaused, setIsIdlePaused] = useState(false);
  const onBlockCompletedRef = useRef(onBlockCompleted);
  onBlockCompletedRef.current = onBlockCompleted;

  // Persist state to localStorage on every change
  useEffect(() => {
    try {
      localStorage.setItem(TIMER_STORAGE_KEY, JSON.stringify(timerState));
    } catch {
      // Ignore
    }
  }, [timerState]);

  // Main 1-second interval to update display & check idle
  useEffect(() => {
    const updateDisplay = () => {
      setElapsedSec(timerEngine.getElapsedSeconds(timerState));
      setRemainingSec(timerEngine.getRemainingSeconds(timerState));

      // Idle check
      if (timerState.state === 'running') {
        const { isIdle, newState } = timerEngine.checkIdleTimeout(timerState, 2);
        if (isIdle) {
          setIsIdlePaused(true);
          setTimerState(newState);
        }
      }
    };

    updateDisplay();
    const interval = setInterval(updateDisplay, 1000);
    return () => clearInterval(interval);
  }, [timerState]);

  // User activity tracker
  const recordUserActivity = useCallback(() => {
    setTimerState((prev) => timerEngine.recordInteraction(prev));
    if (isIdlePaused) {
      setIsIdlePaused(false);
    }
  }, [isIdlePaused]);

  useEffect(() => {
    const handler = () => recordUserActivity();
    window.addEventListener('keydown', handler);
    window.addEventListener('mousedown', handler);
    window.addEventListener('touchstart', handler);
    return () => {
      window.removeEventListener('keydown', handler);
      window.removeEventListener('mousedown', handler);
      window.removeEventListener('touchstart', handler);
    };
  }, [recordUserActivity]);

  const startBlock = useCallback((blockId: string, targetMinutes = 60) => {
    setIsIdlePaused(false);
    setTimerState((prev) => timerEngine.start(prev, blockId, targetMinutes));
    EventRepository.record('block_completed', { action: 'started', blockId, targetMinutes });
  }, []);

  const pauseTimer = useCallback(() => {
    setTimerState((prev) => timerEngine.pause(prev));
  }, []);

  const resumeTimer = useCallback(() => {
    setIsIdlePaused(false);
    setTimerState((prev) => timerEngine.resume(prev));
  }, []);

  const finishBlock = useCallback(async () => {
    const { updatedState, totalElapsedSeconds } = timerEngine.finish(timerState);
    setTimerState(updatedState);

    if (timerState.blockId) {
      await db.study_sessions.add({
        id: `sess_${Date.now()}`,
        blockId: timerState.blockId,
        startedAt: new Date(Date.now() - totalElapsedSeconds * 1000).toISOString(),
        completedAt: new Date().toISOString(),
        durationSeconds: totalElapsedSeconds,
        exercisesCompleted: 0,
      });

      await syncUserStudyStreak(db);

      await EventRepository.record('block_completed', {
        blockId: timerState.blockId,
        durationSeconds: totalElapsedSeconds,
      });

      if (onBlockCompletedRef.current) {
        onBlockCompletedRef.current(timerState.blockId, totalElapsedSeconds);
      }
    }
  }, [timerState]);

  const skipBlock = useCallback(() => {
    setTimerState(timerEngine.createInitialState(60, null));
  }, []);

  return {
    timerState,
    elapsedSec,
    remainingSec,
    isIdlePaused,
    startBlock,
    pauseTimer,
    resumeTimer,
    finishBlock,
    skipBlock,
    recordUserActivity,
  };
}
</file>

<file path="src/presentation/screens/CurriculumScreen.tsx">
import React, { useState, useEffect, useMemo } from 'react';
import { motion } from 'framer-motion';
import {
  BookOpen,
  Lock,
  Play,
  CheckCircle,
  Search,
  Sparkles,
  RotateCcw,
  Layers,
} from 'lucide-react';
import { ContentLoader } from '../../data/content/content-loader';
import { db } from '../../data/db/dexie-db';
import { CurriculumMapItem, MasteryRecord, SRSCard } from '../../domain/models/types';

interface CurriculumScreenProps {
  onSelectLesson: (lessonId: string) => void;
  masteryRecords: Record<string, MasteryRecord>;
  currentLessonId?: string;
  initialLevel?: 'N5' | 'N4' | 'N3' | 'N2';
  srsCards?: SRSCard[];
}

export const CurriculumScreen: React.FC<CurriculumScreenProps> = ({
  onSelectLesson,
  masteryRecords,
  currentLessonId,
  initialLevel = 'N5',
  srsCards,
}) => {
  const [selectedLevel, setSelectedLevel] = useState<'N5' | 'N4' | 'N3' | 'N2'>(initialLevel);
  const [searchQuery, setSearchQuery] = useState('');
  const [loadedCards, setLoadedCards] = useState<SRSCard[]>(srsCards || []);

  // Fetch SRS cards from indexedDB if not provided or to stay up-to-date
  useEffect(() => {
    if (srsCards && srsCards.length > 0) {
      setLoadedCards(srsCards);
      return;
    }
    let isMounted = true;
    db.srs_cards
      .toArray()
      .then((cards) => {
        if (isMounted) {
          setLoadedCards(cards);
        }
      })
      .catch((err) => {
        console.warn('Failed to load srs_cards for curriculum:', err);
      });
    return () => {
      isMounted = false;
    };
  }, [srsCards, masteryRecords]);

  // Group SRS cards by lessonId for fast lookup
  const cardsByLesson = useMemo(() => {
    const map: Record<string, SRSCard[]> = {};
    for (const card of loadedCards) {
      if (!map[card.lessonId]) {
        map[card.lessonId] = [];
      }
      map[card.lessonId].push(card);
    }
    return map;
  }, [loadedCards]);

  const allItems = useMemo(() => {
    return ContentLoader.getCurriculumMap().map((item) => ({
      ...item,
      status: 'published' as const,
    }));
  }, []);

  const filteredItems = allItems.filter((item) => {
    const matchesLevel = item.level === selectedLevel;
    const matchesSearch =
      searchQuery.trim() === '' ||
      item.title.toLowerCase().includes(searchQuery.toLowerCase()) ||
      item.id.toLowerCase().includes(searchQuery.toLowerCase()) ||
      item.grammarTopics.some((t) => t.toLowerCase().includes(searchQuery.toLowerCase()));
    return matchesLevel && matchesSearch;
  });

  const levelCounts: Record<'N5' | 'N4' | 'N3' | 'N2', number> = {
    N5: 30,
    N4: 36,
    N3: 48,
    N2: 60,
  };

  // Level-wide completion statistics
  const levelAllItems = useMemo(
    () => allItems.filter((i) => i.level === selectedLevel),
    [allItems, selectedLevel]
  );
  const levelPublishedItems = useMemo(
    () => levelAllItems.filter((i) => i.status === 'published'),
    [levelAllItems]
  );
  const levelCompletedCount = useMemo(() => {
    return levelAllItems.filter((i) => {
      const m = masteryRecords[i.id];
      return m?.state === 'mastered' || m?.state === 'retained' || Boolean(m?.passedThresholds);
    }).length;
  }, [levelAllItems, masteryRecords]);

  const levelPercent =
    levelPublishedItems.length > 0
      ? Math.round((levelCompletedCount / levelPublishedItems.length) * 100)
      : 0;

  const levelTotalSrsMastered = useMemo(() => {
    let count = 0;
    for (const item of levelAllItems) {
      const m = masteryRecords[item.id];
      const isM = m?.state === 'mastered' || m?.state === 'retained' || Boolean(m?.passedThresholds);
      const lCards = cardsByLesson[item.id] || [];
      const packCapacity = Math.max(lCards.length, item.targetVocabCount * 2 + item.targetKanjiCount, 1);
      if (isM) {
        count += packCapacity;
      } else if (lCards.length > 0) {
        count += lCards.filter((c) => c.state === 'review' || c.repetition >= 1 || c.intervalDays >= 1).length;
      }
    }
    return count;
  }, [levelAllItems, masteryRecords, cardsByLesson]);

  return (
    <div className="space-y-6 max-w-6xl mx-auto pb-24">
      {/* Header */}
      <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h1 className="text-2xl font-bold text-stone-100 tracking-tight">Curriculum Map (174 Lessons)</h1>
          <p className="text-xs text-stone-400 mt-0.5">
            Complete N5 → N2 curriculum across 174 lesson packs. AI-assisted editorial authoring, not human-reviewed.
          </p>
        </div>

        {/* Level Switcher */}
        <div className="flex bg-zinc-950/80 backdrop-blur-xl border border-zinc-800/80 rounded-2xl p-1.5 shrink-0 shadow-xl relative">
          {(['N5', 'N4', 'N3', 'N2'] as const).map((lvl) => {
            const isLvlActive = selectedLevel === lvl;
            return (
              <button
                key={lvl}
                onClick={() => setSelectedLevel(lvl)}
                className={`relative px-4 py-2 rounded-xl text-xs font-semibold font-mono transition-colors duration-200 cursor-pointer ${
                  isLvlActive ? 'text-white' : 'text-zinc-400 hover:text-zinc-200'
                }`}
              >
                {isLvlActive && (
                  <motion.div
                    layoutId="activeCurriculumLevel"
                    className="absolute inset-0 bg-gradient-to-r from-rose-600 to-rose-500 rounded-xl shadow-[0_0_16px_rgba(244,63,94,0.4)]"
                    transition={{ type: 'spring', stiffness: 380, damping: 30 }}
                  />
                )}
                <span className="relative z-10">
                  {lvl} ({levelCounts[lvl]})
                </span>
              </button>
            );
          })}
        </div>
      </div>

      {/* Level Overview Progress Summary */}
      <div className="bg-zinc-900/80 backdrop-blur-xl border border-zinc-800/80 rounded-3xl p-5 sm:p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4 shadow-2xl">
        <div className="space-y-1.5">
          <div className="flex items-center gap-2">
            <span className="text-xs font-bold font-mono px-2.5 py-0.5 rounded-full bg-rose-950/80 text-rose-300 border border-rose-500/40">
              {selectedLevel} Track
            </span>
            <span className="text-sm font-semibold text-zinc-100">
              Level Mastery Overview
            </span>
          </div>
          <p className="text-xs text-zinc-400">
            {levelCompletedCount} of {levelPublishedItems.length} published lessons mastered ({levelPercent}%) • {levelTotalSrsMastered} SRS cards retained
          </p>
        </div>
        <div className="sm:w-72 space-y-2">
          <div className="flex justify-between text-xs text-zinc-400 font-mono">
            <span>Overall Level Progress</span>
            <span className="text-emerald-400 font-semibold">{levelPercent}%</span>
          </div>
          <div className="w-full h-2.5 bg-zinc-950 border border-zinc-800 rounded-full overflow-hidden p-0.5">
            <div
              className="h-full bg-gradient-to-r from-rose-600 via-amber-500 to-emerald-500 rounded-full transition-all duration-500 shadow-[0_0_8px_rgba(16,185,129,0.3)]"
              style={{ width: `${Math.max(levelPercent > 0 ? 3 : 0, levelPercent)}%` }}
            />
          </div>
        </div>
      </div>

      {/* Search Input */}
      <div className="relative">
        <Search className="w-4 h-4 text-zinc-500 absolute left-4 top-3.5" />
        <input
          type="text"
          value={searchQuery}
          onChange={(e) => setSearchQuery(e.target.value)}
          placeholder={`Search in ${selectedLevel} lessons, topics, grammar...`}
          className="w-full bg-zinc-900/80 backdrop-blur-xl border border-zinc-800/80 rounded-2xl pl-11 pr-4 py-3 text-xs text-zinc-200 placeholder:text-zinc-500 focus:outline-none focus:border-rose-500/80 shadow-inner font-japanese"
        />
      </div>

      {/* Lessons List Grid */}
      <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {filteredItems.map((item) => {
          const isPlayable = item.status === 'published';
          const mastery = masteryRecords[item.id];
          const isMastered =
            mastery?.state === 'mastered' ||
            mastery?.state === 'retained' ||
            Boolean(mastery?.passedThresholds);
          const isCurrentFocus = Boolean(currentLessonId && item.id === currentLessonId);
          const isInProgress = !isMastered && (mastery?.state === 'learning' || mastery?.state === 'familiar');

          // SRS card calculations
          const lessonCards = cardsByLesson[item.id] || [];
          const targetCardsCount = item.targetVocabCount * 2 + item.targetKanjiCount;
          const totalPackCards = Math.max(lessonCards.length, targetCardsCount > 0 ? targetCardsCount : 24);

          let masteredCardsCount = 0;
          if (lessonCards.length > 0) {
            masteredCardsCount = lessonCards.filter(
              (c) => c.state === 'review' || c.repetition >= 1 || c.intervalDays >= 1
            ).length;
          }

          let displayMastered = masteredCardsCount;
          let masteryPercentage = 0;

          if (isMastered) {
            displayMastered = totalPackCards;
            masteryPercentage = 100;
          } else if (lessonCards.length > 0) {
            displayMastered = Math.min(masteredCardsCount, totalPackCards);
            masteryPercentage = Math.min(100, Math.round((displayMastered / totalPackCards) * 100));
          } else if (mastery?.scores?.overall) {
            masteryPercentage = Math.min(100, Math.round(mastery.scores.overall * 100));
            displayMastered = Math.round((masteryPercentage / 100) * totalPackCards);
          } else if (isInProgress) {
            masteryPercentage = Math.max(12, Math.round((displayMastered / totalPackCards) * 100));
            displayMastered = Math.max(displayMastered, Math.round((masteryPercentage / 100) * totalPackCards));
          }

          // Distinct card styling
          let cardStyle = 'bg-zinc-950/40 border-zinc-900/80 text-zinc-500 opacity-60';
          if (isPlayable) {
            if (isCurrentFocus) {
              cardStyle = 'bg-zinc-900/90 backdrop-blur-xl border-rose-500/80 ring-2 ring-rose-500/30 shadow-[0_0_24px_rgba(244,63,94,0.25)]';
            } else if (isMastered) {
              cardStyle = 'bg-zinc-900/80 backdrop-blur-xl border-emerald-500/40 hover:border-emerald-400/70 shadow-[0_0_16px_rgba(16,185,129,0.15)]';
            } else if (isInProgress) {
              cardStyle = 'bg-zinc-900/80 backdrop-blur-xl border-amber-500/40 hover:border-amber-400/70 shadow-[0_0_16px_rgba(245,158,11,0.15)]';
            } else {
              cardStyle = 'bg-zinc-900/80 backdrop-blur-xl border-zinc-800/80 hover:border-zinc-700/80 shadow-lg';
            }
          }

          return (
            <div
              key={item.id}
              role="button"
              tabIndex={0}
              onClick={() => onSelectLesson(item.id)}
              onKeyDown={(e) => {
                if (e.key === 'Enter' || e.key === ' ') {
                  e.preventDefault();
                  onSelectLesson(item.id);
                }
              }}
              aria-label={`Study lesson ${item.number}: ${item.title}`}
              className={`rounded-2xl border p-5 flex flex-col justify-between transition duration-200 cursor-pointer hover:shadow-xl hover:scale-[1.01] active:scale-[0.99] select-none ${cardStyle}`}
            >
              <div className="space-y-2.5">
                <div className="flex items-center justify-between">
                  <span className="text-[10px] font-mono text-stone-400 uppercase font-semibold">
                    {item.id} • Lesson {item.number}
                  </span>
                  <div className="flex items-center gap-1.5 flex-wrap justify-end">
                    {item.reviewStatus && (
                      <span className="text-[10px] px-2 py-0.5 rounded-full bg-stone-800 text-stone-300 border border-stone-700 font-medium">
                        {item.reviewStatus === 'human-reviewed' ? 'Human-Reviewed' : 'AI-Authored'}
                      </span>
                    )}

                    <span
                      className={`text-[10px] px-2 py-0.5 rounded-full font-semibold ${
                        item.status === 'published'
                          ? 'bg-emerald-950/60 text-emerald-300 border border-emerald-800/60'
                          : 'bg-stone-800/60 text-stone-400 border border-stone-700/60'
                      }`}
                    >
                      {item.status === 'published' ? 'Published' : 'Planned'}
                    </span>

                    {/* Status Badges: Completed, Current Focus, In Progress, Ready, Locked */}
                    {!isPlayable ? (
                      <span className="text-[10px] px-2 py-0.5 rounded-full bg-stone-900 text-stone-500 border border-stone-800 flex items-center gap-1">
                        <Lock className="w-2.5 h-2.5 text-stone-600" />
                        Locked
                      </span>
                    ) : isMastered ? (
                      <span className="text-[10px] px-2 py-0.5 rounded-full bg-emerald-950/90 text-emerald-300 border border-emerald-700/80 font-semibold flex items-center gap-1">
                        <CheckCircle className="w-3 h-3 text-emerald-400" />
                        Completed
                      </span>
                    ) : isCurrentFocus ? (
                      <span className="text-[10px] px-2 py-0.5 rounded-full bg-rose-950/90 text-rose-300 border border-rose-600 font-semibold flex items-center gap-1 shadow-sm">
                        <Sparkles className="w-3 h-3 text-rose-400" />
                        Current Focus
                      </span>
                    ) : isInProgress ? (
                      <span className="text-[10px] px-2 py-0.5 rounded-full bg-amber-950/90 text-amber-300 border border-amber-700 font-semibold flex items-center gap-1">
                        In Progress
                      </span>
                    ) : (
                      <span className="text-[10px] px-2 py-0.5 rounded-full bg-stone-800 text-stone-300 border border-stone-700 font-semibold">
                        Ready
                      </span>
                    )}
                  </div>
                </div>

                <h3 className={`text-sm font-semibold leading-snug ${isPlayable ? 'text-stone-100' : 'text-stone-400'}`}>
                  {item.title}
                </h3>

                <p className="text-[11px] text-stone-400">
                  {item.grammarTopics.join(' • ')}
                </p>

                <div className="flex items-center space-x-3 text-[10px] text-stone-500 pt-0.5">
                  <span>Target Kanji: {item.targetKanjiCount}</span>
                  <span>•</span>
                  <span>Target Vocab: {item.targetVocabCount}</span>
                </div>

                {/* Visual Progress Bar & Mastery Percentage */}
                <div className="pt-2 pb-0.5 space-y-1.5 border-t border-stone-800/60">
                  <div className="flex items-center justify-between text-xs">
                    <div className="flex items-center gap-1.5 text-stone-400 font-medium">
                      <Layers className="w-3 h-3 text-stone-500" />
                      <span>SRS Mastery</span>
                    </div>
                    <div className="flex items-center gap-2 font-mono text-[11px]">
                      <span
                        className={
                          isMastered
                            ? 'text-emerald-400 font-bold'
                            : isCurrentFocus
                            ? 'text-rose-400 font-medium'
                            : isInProgress
                            ? 'text-amber-400 font-medium'
                            : 'text-stone-500'
                        }
                      >
                        {isPlayable ? `${displayMastered} / ${totalPackCards} cards` : `${totalPackCards} cards planned`}
                      </span>
                      <span
                        className={`px-1.5 py-0.5 rounded text-[10px] font-bold ${
                          isMastered
                            ? 'bg-emerald-950 text-emerald-300 border border-emerald-800/80'
                            : isCurrentFocus
                            ? 'bg-rose-950 text-rose-300 border border-rose-800/80'
                            : isInProgress
                            ? 'bg-amber-950 text-amber-300 border border-amber-800/80'
                            : 'bg-stone-800/80 text-stone-500 border border-stone-700/60'
                        }`}
                      >
                        {masteryPercentage}%
                      </span>
                    </div>
                  </div>

                  {/* Progress Bar Track */}
                  <div
                    role="progressbar"
                    aria-valuenow={masteryPercentage}
                    aria-valuemin={0}
                    aria-valuemax={100}
                    aria-label={`${item.title} SRS mastery: ${masteryPercentage}%`}
                    className="w-full h-2 bg-stone-950/80 border border-stone-800/90 rounded-full overflow-hidden p-0.5"
                  >
                    <div
                      className={`h-full rounded-full transition-all duration-500 ${
                        isMastered
                          ? 'bg-gradient-to-r from-emerald-500 to-teal-400 shadow-sm shadow-emerald-500/40'
                          : isCurrentFocus
                          ? 'bg-gradient-to-r from-rose-600 to-rose-400 shadow-sm shadow-rose-500/40'
                          : isInProgress
                          ? 'bg-gradient-to-r from-amber-500 to-yellow-400 shadow-sm shadow-amber-500/40'
                          : masteryPercentage > 0
                          ? 'bg-stone-500'
                          : 'bg-stone-800/30'
                      }`}
                      style={{ width: `${Math.max(masteryPercentage > 0 ? 3 : 0, masteryPercentage)}%` }}
                    />
                  </div>
                </div>
              </div>

              <div className="mt-3.5 pt-3 border-t border-stone-800/80 flex items-center justify-between">
                {isPlayable ? (
                  <>
                    <div className="text-xs font-medium">
                      {isMastered ? (
                        <span className="text-emerald-400 flex items-center gap-1.5 text-[11px] font-semibold">
                          <CheckCircle className="w-3.5 h-3.5 text-emerald-400" />
                          <span>Mastered (100%)</span>
                        </span>
                      ) : isCurrentFocus ? (
                        <span className="text-rose-400 flex items-center gap-1.5 text-[11px] font-semibold">
                          <Sparkles className="w-3.5 h-3.5 text-rose-400" />
                          <span>Current Focus • {masteryPercentage}%</span>
                        </span>
                      ) : isInProgress ? (
                        <span className="text-amber-400 text-[11px] font-medium">
                          In Progress • {masteryPercentage}%
                        </span>
                      ) : (
                        <span className="text-stone-400 text-[11px]">Ready to start • 0%</span>
                      )}
                    </div>
                    <button
                      type="button"
                      onClick={(e) => {
                        e.stopPropagation();
                        onSelectLesson(item.id);
                      }}
                      className={`px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center space-x-1 transition shadow cursor-pointer ${
                        isCurrentFocus
                          ? 'bg-rose-600 hover:bg-rose-500 text-white shadow-rose-950/50'
                          : isMastered
                          ? 'bg-stone-800 hover:bg-stone-700 text-stone-200 border border-stone-700'
                          : 'bg-rose-600 hover:bg-rose-500 text-white'
                      }`}
                    >
                      {isMastered ? (
                        <>
                          <RotateCcw className="w-3.5 h-3.5" />
                          <span>Review</span>
                        </>
                      ) : (
                        <>
                          <Play className="w-3.5 h-3.5 fill-white" />
                          <span>{isCurrentFocus ? 'Study Now' : 'Study'}</span>
                        </>
                      )}
                    </button>
                  </>
                ) : (
                  <div className="w-full flex items-center justify-between text-[11px] text-stone-500">
                    <span className="italic">Outline only — content not yet available</span>
                    <Lock className="w-3.5 h-3.5 text-stone-600 shrink-0" />
                  </div>
                )}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  );
};
</file>

<file path="src/presentation/screens/KanaTrainerScreen.tsx">
import React, { useState, useEffect, useRef } from 'react';
import { Volume2, Award, Check, X, RotateCcw, Clock, Layers, Sparkles, Filter, Zap } from 'lucide-react';
import { KANA_DATASET, KanaEngine, RawKanaDef } from '../../domain/kana/kana-engine';
import { KanaRecord, SRSCard } from '../../domain/models/types';
import { db } from '../../data/db/dexie-db';
import { SystemClock } from '../../domain/common/clock';
import { useAudioPlayer } from '../hooks/useAudioPlayer';
import { fisherYatesShuffle } from '../../domain/assessment/shuffler';
import { useScopedShortcuts } from '../context/GlobalShortcutContext';

interface KanaTrainerScreenProps {
  onBack: () => void;
}

export const KanaTrainerScreen: React.FC<KanaTrainerScreenProps> = ({ onBack }) => {
  const [selectedScript, setSelectedScript] = useState<'hiragana' | 'katakana'>('hiragana');
  const [selectedCategory, setSelectedCategory] = useState<'all' | 'basic' | 'dakuten' | 'combo'>('basic');
  const [mode, setMode] = useState<'practice' | 'chart'>('practice');

  const [records, setRecords] = useState<Record<string, KanaRecord>>({});
  const [currentIndex, setCurrentIndex] = useState(0);
  const [userTyped, setUserTyped] = useState('');
  const [selectedOption, setSelectedOption] = useState<string | null>(null);
  const [feedback, setFeedback] = useState<{ isCorrect: boolean; answer: string } | null>(null);
  const [questionStartMs, setQuestionStartMs] = useState<number>(Date.now());
  const [autoAdvance, setAutoAdvance] = useState(true);
  const [stats, setStats] = useState({ mastered: 0, learning: 0, total: 0 });

  const autoAdvanceTimerRef = useRef<NodeJS.Timeout | null>(null);

  const clock = new SystemClock();
  const engine = new KanaEngine(clock);
  const { play, stop, isPlaying, currentPlayingText } = useAudioPlayer();

  const loadKanaRecords = async () => {
    const existing = await db.kana_records.toArray();
    const map: Record<string, KanaRecord> = {};
    existing.forEach((r) => {
      map[r.character] = r;
    });

    if (existing.length === 0) {
      const initial = engine.createInitialRecords();
      await db.kana_records.bulkAdd(initial);
      initial.forEach((r) => {
        map[r.character] = r;
      });
    }

    setRecords(map);

    const values = Object.values(map);
    const mastered = values.filter((v) => v.masteryState === 'mastered').length;
    const learning = values.filter((v) => v.masteryState === 'learning').length;
    setStats({ mastered, learning, total: values.length });
  };

  useEffect(() => {
    loadKanaRecords();
  }, []);

  // Cleanup auto-advance timer on unmount
  useEffect(() => {
    return () => {
      if (autoAdvanceTimerRef.current) {
        clearTimeout(autoAdvanceTimerRef.current);
      }
    };
  }, []);

  const filteredKana = KANA_DATASET.filter((k) => {
    const scriptMatch = k.script === selectedScript;
    const categoryMatch =
      selectedCategory === 'all'
        ? true
        : selectedCategory === 'dakuten'
        ? k.category === 'dakuten' || k.category === 'handakuten'
        : k.category === selectedCategory;
    return scriptMatch && categoryMatch;
  });

  const totalKana = Math.max(1, filteredKana.length);
  const currentKana: RawKanaDef | undefined = filteredKana[currentIndex % totalKana];

  // Options for multiple choice
  const options = React.useMemo(() => {
    if (!currentKana) return [];
    const correct = currentKana.romaji[0];
    const pool = filteredKana
      .filter((k) => k.char !== currentKana.char)
      .map((k) => k.romaji[0]);
    const shuffledPool = fisherYatesShuffle([...new Set(pool)]).slice(0, 3);
    return fisherYatesShuffle([correct, ...shuffledPool]);
  }, [currentKana, filteredKana]);

  const handleNext = () => {
    if (autoAdvanceTimerRef.current) {
      clearTimeout(autoAdvanceTimerRef.current);
      autoAdvanceTimerRef.current = null;
    }
    setFeedback(null);
    setSelectedOption(null);
    setUserTyped('');
    setQuestionStartMs(Date.now());
    setCurrentIndex((prev) => (prev + 1) % totalKana);
  };

  const handleCheck = async (answerToCheck: string) => {
    if (!currentKana || feedback) return;

    if (autoAdvanceTimerRef.current) {
      clearTimeout(autoAdvanceTimerRef.current);
      autoAdvanceTimerRef.current = null;
    }

    const isCorrect = engine.checkKanaAnswer(answerToCheck, currentKana);
    const elapsed = Date.now() - questionStartMs;

    setFeedback({
      isCorrect,
      answer: currentKana.romaji[0],
    });

    const existingRec = records[currentKana.char] || {
      character: currentKana.char,
      romaji: currentKana.romaji,
      script: currentKana.script,
      category: currentKana.category,
      recognitionAccuracy: 0,
      productionAccuracy: 0,
      responseTime: 0,
      attempts: 0,
      masteryState: 'new',
    };

    const updated = engine.updateRecord(existingRec, isCorrect, false, elapsed);
    await db.kana_records.put(updated);
    setRecords((prev) => ({ ...prev, [updated.character]: updated }));

    // Auto-advance if enabled: quick 750ms transition on correct, 1400ms on incorrect so user can see correct answer
    if (autoAdvance) {
      const delay = isCorrect ? 750 : 1400;
      autoAdvanceTimerRef.current = setTimeout(() => {
        handleNext();
      }, delay);
    }
  };

  // Centralized scoped keyboard shortcuts (1-4 for choices, Enter for next)
  useScopedShortcuts({
    scopeId: 'kana_trainer',
    enabled: Boolean(currentKana) && mode === 'practice',
    priority: 15,
    handlers: {
      SELECT_CHOICE_1: () => {
        if (!feedback && options[0]) {
          setSelectedOption(options[0]);
          handleCheck(options[0]);
        }
      },
      SELECT_CHOICE_2: () => {
        if (!feedback && options[1]) {
          setSelectedOption(options[1]);
          handleCheck(options[1]);
        }
      },
      SELECT_CHOICE_3: () => {
        if (!feedback && options[2]) {
          setSelectedOption(options[2]);
          handleCheck(options[2]);
        }
      },
      SELECT_CHOICE_4: () => {
        if (!feedback && options[3]) {
          setSelectedOption(options[3]);
          handleCheck(options[3]);
        }
      },
      SUBMIT_ANSWER: () => {
        if (feedback) {
          handleNext();
        }
      },
      NEXT_ITEM: () => {
        if (feedback) {
          handleNext();
        }
      },
      PLAY_AUDIO: () => {
        if (currentKana) {
          play(currentKana.char);
        }
      },
    },
  });

  const handleAddAllToSRS = async () => {
    for (const k of filteredKana) {
      const rec = records[k.char];
      if (rec) {
        const card = engine.createSRSCard(rec);
        await db.srs_cards.put(card);
      }
    }
    alert(`Added ${filteredKana.length} ${selectedScript} cards to your SRS review queue!`);
  };

  const handleSwitchScript = (script: 'hiragana' | 'katakana') => {
    if (autoAdvanceTimerRef.current) {
      clearTimeout(autoAdvanceTimerRef.current);
      autoAdvanceTimerRef.current = null;
    }
    setSelectedScript(script);
    setCurrentIndex(0);
    setFeedback(null);
    setSelectedOption(null);
    setUserTyped('');
  };

  const handleSwitchCategory = (cat: 'all' | 'basic' | 'dakuten' | 'combo') => {
    if (autoAdvanceTimerRef.current) {
      clearTimeout(autoAdvanceTimerRef.current);
      autoAdvanceTimerRef.current = null;
    }
    setSelectedCategory(cat);
    setCurrentIndex(0);
    setFeedback(null);
    setSelectedOption(null);
    setUserTyped('');
  };

  return (
    <div className="space-y-6 max-w-4xl mx-auto pb-24">
      {/* Header */}
      <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <button onClick={onBack} className="text-xs text-stone-400 hover:text-stone-200 transition mb-1 block">
            ← Back to Dashboard
          </button>
          <h1 className="text-2xl font-bold text-stone-100 tracking-tight">Kana Mastery Trainer</h1>
          <p className="text-xs text-stone-400 mt-0.5">
            Gojūon, Dakuten, Handakuten, and Yōon combinations for Hiragana and Katakana.
          </p>
        </div>

        {/* Script & Mode Switchers */}
        <div className="flex items-center space-x-2">
          <div className="bg-stone-900 border border-stone-800 rounded-xl p-1 flex">
            <button
              onClick={() => handleSwitchScript('hiragana')}
              className={`px-3 py-1.5 rounded-lg text-xs font-semibold transition ${
                selectedScript === 'hiragana' ? 'bg-rose-600 text-white shadow' : 'text-stone-400 hover:text-stone-200'
              }`}
            >
              Hiragana (ひらがな)
            </button>
            <button
              onClick={() => handleSwitchScript('katakana')}
              className={`px-3 py-1.5 rounded-lg text-xs font-semibold transition ${
                selectedScript === 'katakana' ? 'bg-rose-600 text-white shadow' : 'text-stone-400 hover:text-stone-200'
              }`}
            >
              Katakana (カタカナ)
            </button>
          </div>
        </div>
      </div>

      {/* Progress & Category Filter */}
      <div className="bg-stone-900 border border-stone-800 rounded-2xl p-4 flex flex-wrap items-center justify-between gap-3">
        <div className="flex flex-wrap gap-1.5">
          {(['basic', 'dakuten', 'combo', 'all'] as const).map((cat) => (
            <button
              key={cat}
              onClick={() => handleSwitchCategory(cat)}
              className={`px-3 py-1.5 rounded-lg text-xs font-medium transition capitalize ${
                selectedCategory === cat
                  ? 'bg-stone-800 text-stone-100 border border-stone-700'
                  : 'text-stone-400 hover:text-stone-300'
              }`}
            >
              {cat === 'basic' ? 'Basic Gojūon (46)' : cat === 'dakuten' ? 'Dakuten / Handakuten' : cat === 'combo' ? 'Combos (Yōon)' : 'All Characters'}
            </button>
          ))}
        </div>

        <div className="flex items-center space-x-3">
          {/* Auto advance toggle */}
          <button
            onClick={() => setAutoAdvance(!autoAdvance)}
            className={`px-2.5 py-1.5 rounded-lg text-xs font-medium border flex items-center space-x-1.5 transition ${
              autoAdvance
                ? 'bg-rose-950/60 border-rose-800 text-rose-300'
                : 'bg-stone-950 border-stone-800 text-stone-400 hover:text-stone-300'
            }`}
            title="Auto-advance immediately to the next character after answering"
          >
            <Zap className={`w-3.5 h-3.5 ${autoAdvance ? 'text-rose-400' : 'text-stone-500'}`} />
            <span>Auto Advance {autoAdvance ? 'ON' : 'OFF'}</span>
          </button>

          <button
            onClick={() => setMode(mode === 'practice' ? 'chart' : 'practice')}
            className="text-xs text-rose-400 hover:text-rose-300 font-semibold"
          >
            {mode === 'practice' ? 'View Kana Chart' : 'Switch to Practice'}
          </button>
          <button
            onClick={handleAddAllToSRS}
            className="px-3 py-1.5 rounded-lg bg-indigo-950/80 hover:bg-indigo-900 border border-indigo-800 text-indigo-300 text-xs font-medium flex items-center space-x-1"
          >
            <Layers className="w-3.5 h-3.5" />
            <span>Send to SRS</span>
          </button>
        </div>
      </div>

      {/* Mode 1: Interactive Practice Card */}
      {mode === 'practice' && currentKana && (
        <div className="bg-stone-900 border border-stone-800 rounded-2xl p-8 max-w-xl mx-auto text-center space-y-6 shadow-2xl relative">
          <div className="flex justify-between items-center text-xs text-stone-500 font-mono">
            <span>Character {currentIndex + 1} of {filteredKana.length}</span>
            <div className="flex items-center space-x-2">
              <span className="capitalize">{currentKana.category}</span>
              <button
                onClick={handleNext}
                className="text-rose-400 hover:text-rose-300 font-sans font-medium hover:underline text-[11px]"
              >
                Skip →
              </button>
            </div>
          </div>

          <div className="py-6 space-y-3">
            <div className="text-7xl font-bold font-japanese text-stone-100">{currentKana.char}</div>

            <div className="flex justify-center">
              <button
                onClick={() => {
                  if (isPlaying && currentPlayingText === currentKana.char) {
                    stop();
                  } else {
                    play(currentKana.char);
                  }
                }}
                className={`p-2.5 rounded-full transition ${
                  isPlaying && currentPlayingText === currentKana.char
                    ? 'bg-rose-600 text-white ring-4 ring-rose-500/30 animate-pulse'
                    : 'bg-stone-800 hover:bg-stone-700 text-stone-300'
                }`}
                title={isPlaying && currentPlayingText === currentKana.char ? 'Stop audio' : 'Play pronunciation'}
              >
                <Volume2 className="w-5 h-5" />
              </button>
            </div>
          </div>

          {/* Multiple choice selections */}
          <div className="grid grid-cols-2 gap-3">
            {options.map((opt, i) => {
              const isSelected = selectedOption === opt;
              const isCorrectAnswer = currentKana.romaji.includes(opt);

              let buttonStyle = 'bg-stone-950 border-stone-800 text-stone-300 hover:border-stone-700';
              if (feedback) {
                if (isSelected && feedback.isCorrect) {
                  buttonStyle = 'bg-emerald-950/90 border-emerald-500 text-emerald-200 ring-2 ring-emerald-500/30';
                } else if (isSelected && !feedback.isCorrect) {
                  buttonStyle = 'bg-rose-950/90 border-rose-500 text-rose-200 ring-2 ring-rose-500/30';
                } else if (!isSelected && isCorrectAnswer && !feedback.isCorrect) {
                  // Show which choice was correct when learner got it wrong
                  buttonStyle = 'bg-emerald-950/40 border-emerald-700/60 text-emerald-300';
                } else {
                  buttonStyle = 'bg-stone-950/60 border-stone-900 text-stone-500 opacity-60';
                }
              }

              return (
                <button
                  key={`${currentKana.char}_${opt}_${i}`}
                  onClick={() => {
                    if (!feedback) {
                      setSelectedOption(opt);
                      handleCheck(opt);
                    }
                  }}
                  disabled={Boolean(feedback)}
                  className={`py-3.5 px-4 rounded-xl border text-sm font-semibold transition flex items-center justify-between cursor-pointer active:scale-98 ${buttonStyle}`}
                >
                  <span className="flex items-center">
                    <span className="w-5 h-5 rounded-full bg-stone-800 text-stone-400 text-[10px] flex items-center justify-center mr-2 font-mono">
                      {i + 1}
                    </span>
                    <span>{opt}</span>
                  </span>
                  {feedback && isSelected && (
                    <span>
                      {feedback.isCorrect ? (
                        <Check className="w-4 h-4 text-emerald-400" />
                      ) : (
                        <X className="w-4 h-4 text-rose-400" />
                      )}
                    </span>
                  )}
                </button>
              );
            })}
          </div>

          {/* Direct typing alternative */}
          <div className="pt-2">
            <input
              type="text"
              value={userTyped}
              onChange={(e) => setUserTyped(e.target.value)}
              onKeyDown={(e) => {
                if (e.key === 'Enter') {
                  if (feedback) {
                    handleNext();
                  } else if (userTyped.trim()) {
                    setSelectedOption(userTyped.trim());
                    handleCheck(userTyped.trim());
                  }
                }
              }}
              placeholder="Or type romaji / character and press Enter..."
              disabled={Boolean(feedback)}
              className="w-full bg-stone-950 border border-stone-800 rounded-xl px-4 py-2.5 text-xs text-stone-100 text-center focus:outline-none focus:border-rose-500 placeholder:text-stone-600"
            />
          </div>

          {/* Feedback & manual Next button */}
          {feedback && (
            <div
              className={`p-3.5 rounded-xl border text-xs flex items-center justify-between transition-all duration-300 ${
                feedback.isCorrect
                  ? 'bg-emerald-950/50 border-emerald-800 text-emerald-200'
                  : 'bg-rose-950/50 border-rose-800 text-rose-200'
              }`}
            >
              <div className="flex items-center space-x-2">
                {feedback.isCorrect ? <Check className="w-4 h-4 text-emerald-400" /> : <X className="w-4 h-4 text-rose-400" />}
                <span className="font-medium">
                  {feedback.isCorrect ? 'အဖြေမှန် (Correct!)' : `အဖြေမှန်: ${feedback.answer}`}
                </span>
                {autoAdvance && (
                  <span className="text-[10px] text-stone-400 font-mono">
                    (advancing...)
                  </span>
                )}
              </div>
              <button
                onClick={handleNext}
                className="px-3 py-1.5 rounded-lg bg-stone-800 hover:bg-stone-700 text-stone-100 text-xs font-semibold cursor-pointer shadow-sm transition active:scale-95"
              >
                နောက်မေးခွန်းသို့ (Next) →
              </button>
            </div>
          )}
        </div>
      )}

      {/* Mode 2: Full Kana Grid Chart */}
      {mode === 'chart' && (
        <div className="bg-stone-900 border border-stone-800 rounded-2xl p-6 shadow-xl">
          <h2 className="text-base font-semibold text-stone-200 mb-4 capitalize">
            {selectedScript} Grid Table ({filteredKana.length} characters)
          </h2>
          <div className="grid grid-cols-5 sm:grid-cols-8 md:grid-cols-10 gap-2.5">
            {filteredKana.map((k) => {
              const rec = records[k.char];
              const isMastered = rec?.masteryState === 'mastered';
              return (
                <div
                  key={k.char}
                  onClick={() => {
                    if (isPlaying && currentPlayingText === k.char) {
                      stop();
                    } else {
                      play(k.char);
                    }
                  }}
                  className={`p-2.5 rounded-xl border text-center cursor-pointer transition hover:scale-105 ${
                    isPlaying && currentPlayingText === k.char
                      ? 'bg-rose-600 border-rose-500 text-white ring-2 ring-rose-400/50 scale-105'
                      : isMastered
                      ? 'bg-emerald-950/40 border-emerald-700/60 text-emerald-200'
                      : 'bg-stone-950 border-stone-800 text-stone-200 hover:border-stone-700'
                  }`}
                >
                  <div className="text-xl font-bold font-japanese">{k.char}</div>
                  <div className="text-[10px] text-stone-400 font-mono">{k.romaji[0]}</div>
                </div>
              );
            })}
          </div>
        </div>
      )}
    </div>
  );
};
</file>

<file path="src/presentation/screens/OfficialMockExamScreen.tsx">
import React, { useState, useEffect, useRef, useMemo, useCallback } from 'react';
import {
  Award,
  Clock,
  ArrowRight,
  ArrowLeft,
  Check,
  X,
  AlertCircle,
  Flag,
  BookOpen,
  Headphones,
  Play,
  Pause,
  RotateCcw,
  Sparkles,
  ChevronRight,
  ChevronLeft,
  CheckCircle2,
  XCircle,
  AlertTriangle,
  FileText,
  Volume2,
  VolumeX,
  ExternalLink,
  ShieldCheck,
  Zap,
} from 'lucide-react';
import {
  buildOfficialN2MockExam,
  MockExamEngine,
  MockExamQuestionMeta,
  MockExamScoreReport,
  OFFICIAL_N2_SECTIONS,
  MockExamSection,
} from '../../domain/assessment/mock-exam-engine';
import { DokkaiPassageModel } from '../../domain/assessment/dokkai-catalog';
import { ChoukaiScenario } from '../../domain/assessment/choukai-catalog';
import { ChoukaiAudioEngine, ChoukaiSpeed } from '../../domain/audio/choukai-audio-engine';
import { QuestionSkill } from '../../domain/models/types';
import { useScopedShortcuts } from '../context/GlobalShortcutContext';

interface OfficialMockExamScreenProps {
  onExit: () => void;
  onLaunchRemediationDrill?: (missedQuestionIds: string[]) => void;
  onExamCompleted?: (report: MockExamScoreReport) => void;
}

export const OfficialMockExamScreen: React.FC<OfficialMockExamScreenProps> = ({
  onExit,
  onLaunchRemediationDrill,
  onExamCompleted,
}) => {
  // 1. Build canonical exam structure
  const examData = useMemo(() => buildOfficialN2MockExam(), []);

  // Exam state
  const [activeSection, setActiveSection] = useState<MockExamSection>('section_1');
  const [currentQuestionIndex, setCurrentQuestionIndex] = useState<number>(0);
  const [answers, setAnswers] = useState<
    Record<string, { choice: string | null; timeSpent: number; isFlagged: boolean }>
  >({});
  const [questionStartTime, setQuestionStartTime] = useState<number>(Date.now());

  // Timers: Section countdown & Total elapsed
  const [sectionTimeRemaining, setSectionTimeRemaining] = useState<number>(
    OFFICIAL_N2_SECTIONS.section_1.allocatedSeconds
  );
  const [totalElapsedSeconds, setTotalElapsedSeconds] = useState<number>(0);
  const [section1TimeSpent, setSection1TimeSpent] = useState<number>(0);
  const [section2TimeSpent, setSection2TimeSpent] = useState<number>(0);
  const [isTimerPaused, setIsTimerPaused] = useState<boolean>(false);

  // Modals & Drawers
  const [isNavigatorOpen, setIsNavigatorOpen] = useState<boolean>(false);
  const [showSubmitConfirmModal, setShowSubmitConfirmModal] = useState<boolean>(false);
  const [showExitConfirmModal, setShowExitConfirmModal] = useState<boolean>(false);
  const [scoreReport, setScoreReport] = useState<MockExamScoreReport | null>(null);
  const [reviewFilter, setReviewFilter] = useState<'all' | 'missed' | 'flagged'>('all');

  // Dokkai Reading Pane preferences
  const [dokkaiFuriganaMode, setDokkaiFuriganaMode] = useState<'off' | 'adaptive' | 'full'>('adaptive');
  const [dokkaiHighlightClaims, setDokkaiHighlightClaims] = useState<boolean>(true);

  // Choukai Audio Engine for Section 2
  const [isAudioPlaying, setIsAudioPlaying] = useState<boolean>(false);
  const [audioSpeed, setAudioSpeed] = useState<ChoukaiSpeed>(1.0);
  const [audioWaveform, setAudioWaveform] = useState<number>(0);
  const audioEngineRef = useRef<ChoukaiAudioEngine | null>(null);

  // Initialize and clean up Audio Engine
  useEffect(() => {
    const engine = new ChoukaiAudioEngine({
      onStateChange: (playing) => setIsAudioPlaying(playing),
      onWaveformTick: (amp) => setAudioWaveform(amp),
      onComplete: () => setIsAudioPlaying(false),
    });
    audioEngineRef.current = engine;

    return () => {
      engine.stop();
    };
  }, []);

  // Questions for active section
  const currentSectionQuestions = useMemo(() => {
    return activeSection === 'section_1'
      ? examData.section1Questions
      : examData.section2Questions;
  }, [activeSection, examData]);

  const activeQuestionMeta: MockExamQuestionMeta | undefined =
    currentSectionQuestions[currentQuestionIndex];

  // Map passages and scenarios for quick lookup
  const passageMap = useMemo(() => {
    const map = new Map<string, DokkaiPassageModel>();
    examData.dokkaiPassages.forEach((p) => map.set(p.id, p));
    return map;
  }, [examData.dokkaiPassages]);

  const scenarioMap = useMemo(() => {
    const map = new Map<string, ChoukaiScenario>();
    examData.choukaiScenarios.forEach((s) => map.set(s.id, s));
    return map;
  }, [examData.choukaiScenarios]);

  // Dual Timer Interval
  useEffect(() => {
    if (scoreReport || isTimerPaused) return;

    const interval = setInterval(() => {
      setTotalElapsedSeconds((prev) => prev + 1);

      if (activeSection === 'section_1') {
        setSection1TimeSpent((prev) => prev + 1);
      } else {
        setSection2TimeSpent((prev) => prev + 1);
      }

      setSectionTimeRemaining((prev) => {
        if (prev <= 1) {
          // Time expired for this section
          if (activeSection === 'section_1') {
            handleSectionTransition();
            return OFFICIAL_N2_SECTIONS.section_2.allocatedSeconds;
          } else {
            handleFinalSubmit();
            return 0;
          }
        }
        return prev - 1;
      });
    }, 1000);

    return () => clearInterval(interval);
  }, [scoreReport, isTimerPaused, activeSection]);

  // Audio scenario sync for Choukai question changes
  useEffect(() => {
    if (activeSection === 'section_2' && activeQuestionMeta?.choukaiScenarioId) {
      const sc = scenarioMap.get(activeQuestionMeta.choukaiScenarioId);
      if (sc && audioEngineRef.current) {
        audioEngineRef.current.loadScenario(sc);
      }
    } else {
      if (audioEngineRef.current) {
        audioEngineRef.current.stop();
      }
    }
  }, [activeSection, activeQuestionMeta?.choukaiScenarioId, scenarioMap]);

  // Play audio toggle
  const handleToggleAudio = () => {
    if (!audioEngineRef.current) return;
    if (isAudioPlaying) {
      audioEngineRef.current.pause();
    } else {
      audioEngineRef.current.play();
    }
  };

  const handleChangeAudioSpeed = (speed: ChoukaiSpeed) => {
    setAudioSpeed(speed);
    if (audioEngineRef.current) {
      audioEngineRef.current.setSpeed(speed);
    }
  };

  // Record Answer & update question start time
  const handleSelectChoice = (choice: string) => {
    if (!activeQuestionMeta) return;
    const qId = activeQuestionMeta.question.id;
    const now = Date.now();
    const timeSpent = Math.max(1, Math.round((now - questionStartTime) / 1000));

    setAnswers((prev) => {
      const existing = prev[qId];
      return {
        ...prev,
        [qId]: {
          choice,
          timeSpent: (existing?.timeSpent || 0) + timeSpent,
          isFlagged: existing?.isFlagged || false,
        },
      };
    });
    setQuestionStartTime(now);
  };

  // Toggle Flag for Review (後で見直す)
  const handleToggleFlag = () => {
    if (!activeQuestionMeta) return;
    const qId = activeQuestionMeta.question.id;
    setAnswers((prev) => {
      const existing = prev[qId];
      return {
        ...prev,
        [qId]: {
          choice: existing?.choice || null,
          timeSpent: existing?.timeSpent || 0,
          isFlagged: !existing?.isFlagged,
        },
      };
    });
  };

  // Centralized scoped keyboard navigation (1-4 to answer, arrow keys to navigate)
  useScopedShortcuts({
    scopeId: 'official_mock_exam',
    enabled: !scoreReport && !showSubmitConfirmModal && !showExitConfirmModal && Boolean(activeQuestionMeta),
    priority: 15,
    handlers: {
      SELECT_CHOICE_1: () => {
        const choices = activeQuestionMeta?.question.choices || [];
        if (choices[0]) handleSelectChoice(choices[0]);
      },
      SELECT_CHOICE_2: () => {
        const choices = activeQuestionMeta?.question.choices || [];
        if (choices[1]) handleSelectChoice(choices[1]);
      },
      SELECT_CHOICE_3: () => {
        const choices = activeQuestionMeta?.question.choices || [];
        if (choices[2]) handleSelectChoice(choices[2]);
      },
      SELECT_CHOICE_4: () => {
        const choices = activeQuestionMeta?.question.choices || [];
        if (choices[3]) handleSelectChoice(choices[3]);
      },
      NEXT_ITEM: () => {
        if (currentQuestionIndex < currentSectionQuestions.length - 1) {
          goToQuestion(currentQuestionIndex + 1);
        }
      },
      PREV_ITEM: () => {
        if (currentQuestionIndex > 0) {
          goToQuestion(currentQuestionIndex - 1);
        }
      },
    },
  });

  const goToQuestion = (index: number) => {
    setQuestionStartTime(Date.now());
    setCurrentQuestionIndex(index);
  };

  // Section 1 -> Section 2 transition
  const handleSectionTransition = () => {
    if (audioEngineRef.current) {
      audioEngineRef.current.stop();
    }
    setActiveSection('section_2');
    setCurrentQuestionIndex(0);
    setSectionTimeRemaining(OFFICIAL_N2_SECTIONS.section_2.allocatedSeconds);
    setQuestionStartTime(Date.now());
  };

  // Final Exam Submission & Scoring
  const handleFinalSubmit = async () => {
    if (audioEngineRef.current) {
      audioEngineRef.current.stop();
    }
    setShowSubmitConfirmModal(false);

    const report = MockExamEngine.evaluateMockExam({
      section1Questions: examData.section1Questions,
      section2Questions: examData.section2Questions,
      answers,
      durationSeconds: totalElapsedSeconds,
      section1DurationSeconds: section1TimeSpent,
      section2DurationSeconds: section2TimeSpent,
    });

    setScoreReport(report);

    // Persist to DB
    await MockExamEngine.persistMockExamResult(report);

    if (onExamCompleted) {
      onExamCompleted(report);
    }
  };

  // Helper formats
  const formatTime = (totalSec: number) => {
    const mins = Math.floor(totalSec / 60);
    const secs = totalSec % 60;
    return `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
  };

  // Unanswered count for current section
  const sectionAnsweredCount = useMemo(() => {
    return currentSectionQuestions.filter((q) => Boolean(answers[q.question.id]?.choice)).length;
  }, [currentSectionQuestions, answers]);

  const sectionFlaggedCount = useMemo(() => {
    return currentSectionQuestions.filter((q) => Boolean(answers[q.question.id]?.isFlagged)).length;
  }, [currentSectionQuestions, answers]);

  return (
    <div className="min-h-screen bg-stone-950 text-stone-100 flex flex-col font-sans select-none">
      {/* =========================================================================
          TOP FORMAL EXAM HEADER
         ========================================================================= */}
      <header className="sticky top-0 z-40 bg-stone-900/95 backdrop-blur border-b border-stone-800 px-4 py-2.5 shadow-lg flex items-center justify-between gap-2">
        {/* Left: Exam branding & Active Section Badge */}
        <div className="flex items-center space-x-3">
          <button
            onClick={() => setShowExitConfirmModal(true)}
            className="p-1.5 rounded-lg text-stone-400 hover:text-stone-200 hover:bg-stone-800 transition cursor-pointer"
            title="Quit Mock Exam"
          >
            <ArrowLeft className="w-4 h-4" />
          </button>

          <div>
            <div className="flex items-center space-x-2">
              <span className="text-xs font-bold text-rose-400 uppercase tracking-wider font-mono">
                JLPT N2 HONBAN MOCK
              </span>
              <span className="text-[10px] px-2 py-0.5 rounded-full bg-stone-800 border border-stone-700 text-stone-300 font-japanese font-semibold">
                {OFFICIAL_N2_SECTIONS[activeSection].titleJa}
              </span>
            </div>
            <p className="text-[11px] text-stone-400 hidden sm:block">
              {activeSection === 'section_1'
                ? 'Section 1: Language Knowledge & Reading (105 min)'
                : 'Section 2: Listening Comprehension (50 min)'}
            </p>
          </div>
        </div>

        {/* Center: Live Timers */}
        <div className="flex items-center space-x-3 sm:space-x-6">
          {/* Section Countdown */}
          <div
            className={`flex items-center space-x-2 px-3 py-1.5 rounded-xl border font-mono ${
              sectionTimeRemaining <= 300
                ? 'bg-rose-950/80 border-rose-600 text-rose-300 animate-pulse'
                : sectionTimeRemaining <= 900
                ? 'bg-amber-950/60 border-amber-600 text-amber-300'
                : 'bg-stone-950 border-stone-800 text-stone-200'
            }`}
          >
            <Clock className="w-3.5 h-3.5 text-stone-400" />
            <div className="text-right">
              <div className="text-[9px] uppercase tracking-wider text-stone-400">
                Section Left
              </div>
              <div className="text-sm font-bold leading-none">
                {formatTime(sectionTimeRemaining)}
              </div>
            </div>
          </div>

          {/* Total Elapsed Timer */}
          <div className="hidden md:flex items-center space-x-1.5 text-xs text-stone-400 font-mono">
            <span>Total Elapsed:</span>
            <span className="text-stone-200 font-semibold">{formatTime(totalElapsedSeconds)}</span>
          </div>
        </div>

        {/* Right: Actions (Navigator Drawer, Flag, Submit) */}
        <div className="flex items-center space-x-2">
          {/* Question Navigator Drawer Button */}
          <button
            onClick={() => setIsNavigatorOpen(!isNavigatorOpen)}
            className={`px-3 py-1.5 rounded-xl border text-xs font-medium flex items-center space-x-1.5 transition cursor-pointer ${
              isNavigatorOpen
                ? 'bg-rose-950 border-rose-700 text-rose-300'
                : 'bg-stone-800 border-stone-700 hover:bg-stone-700 text-stone-300'
            }`}
          >
            <FileText className="w-3.5 h-3.5" />
            <span className="hidden sm:inline">Nav Grid</span>
            <span className="px-1.5 py-0.2 rounded bg-stone-900 text-[10px] font-mono text-stone-300">
              {currentQuestionIndex + 1}/{currentSectionQuestions.length}
            </span>
          </button>

          {/* Section 1 -> Section 2 or Finish Button */}
          {activeSection === 'section_1' ? (
            <button
              onClick={() => {
                if (sectionAnsweredCount < currentSectionQuestions.length) {
                  setShowSubmitConfirmModal(true);
                } else {
                  handleSectionTransition();
                }
              }}
              className="px-3.5 py-1.5 rounded-xl bg-gradient-to-r from-indigo-600 to-indigo-500 hover:from-indigo-500 hover:to-indigo-400 text-white font-semibold text-xs flex items-center space-x-1 shadow transition cursor-pointer"
            >
              <span>Next: 聴解</span>
              <ChevronRight className="w-3.5 h-3.5" />
            </button>
          ) : (
            <button
              onClick={() => setShowSubmitConfirmModal(true)}
              className="px-4 py-1.5 rounded-xl bg-gradient-to-r from-rose-600 to-rose-500 hover:from-rose-500 hover:to-rose-400 text-white font-bold text-xs flex items-center space-x-1.5 shadow-md shadow-rose-950 transition cursor-pointer"
            >
              <Check className="w-3.5 h-3.5" />
              <span>Submit Exam</span>
            </button>
          )}
        </div>
      </header>

      {/* =========================================================================
          QUESTION NAVIGATOR DRAWER (Collapsible top / side)
         ========================================================================= */}
      {isNavigatorOpen && (
        <div className="bg-stone-900 border-b border-stone-800 p-4 shadow-xl animate-in slide-in-from-top-2 duration-150">
          <div className="max-w-7xl mx-auto space-y-3">
            <div className="flex items-center justify-between text-xs text-stone-400">
              <div className="flex items-center space-x-4">
                <span className="font-semibold text-stone-200">
                  {OFFICIAL_N2_SECTIONS[activeSection].titleJa} • Questions
                </span>
                <span className="flex items-center space-x-1.5 text-emerald-400">
                  <span className="w-2 h-2 rounded-full bg-emerald-500" />
                  <span>Answered: {sectionAnsweredCount}</span>
                </span>
                <span className="flex items-center space-x-1.5 text-amber-400">
                  <Flag className="w-3 h-3 text-amber-400" />
                  <span>Flagged: {sectionFlaggedCount}</span>
                </span>
                <span className="flex items-center space-x-1.5 text-stone-400">
                  <span className="w-2 h-2 rounded-full bg-stone-700" />
                  <span>Remaining: {currentSectionQuestions.length - sectionAnsweredCount}</span>
                </span>
              </div>
              <button
                onClick={() => setIsNavigatorOpen(false)}
                className="text-stone-400 hover:text-stone-200 text-xs cursor-pointer"
              >
                Close ✕
              </button>
            </div>

            {/* Grid of Question Badges */}
            <div className="grid grid-cols-6 sm:grid-cols-10 md:grid-cols-15 lg:grid-cols-20 gap-1.5 pt-1">
              {currentSectionQuestions.map((qMeta, idx) => {
                const ans = answers[qMeta.question.id];
                const isAnswered = Boolean(ans?.choice);
                const isFlagged = Boolean(ans?.isFlagged);
                const isCurrent = idx === currentQuestionIndex;

                return (
                  <button
                    key={qMeta.question.id}
                    onClick={() => {
                      goToQuestion(idx);
                      setIsNavigatorOpen(false);
                    }}
                    className={`relative h-8 rounded-lg text-xs font-mono font-medium flex items-center justify-center transition cursor-pointer ${
                      isCurrent
                        ? 'ring-2 ring-rose-500 bg-rose-950/80 text-rose-200 font-bold'
                        : isAnswered
                        ? 'bg-emerald-950/60 border border-emerald-800/80 text-emerald-300 hover:bg-emerald-900/60'
                        : 'bg-stone-800/80 border border-stone-700/80 text-stone-400 hover:bg-stone-700'
                    }`}
                  >
                    <span>{idx + 1}</span>
                    {isFlagged && (
                      <span className="absolute -top-1 -right-1 w-2.5 h-2.5 bg-amber-500 rounded-full border border-stone-900" />
                    )}
                  </button>
                );
              })}
            </div>
          </div>
        </div>
      )}

      {/* =========================================================================
          MAIN TEST CONTENT AREA
         ========================================================================= */}
      <main className="flex-1 max-w-7xl w-full mx-auto p-4 sm:p-6 flex flex-col justify-between">
        {activeQuestionMeta ? (
          <div className="space-y-4">
            {/* Mondai Instruction Banner */}
            <div className="bg-stone-900/70 border border-stone-800/80 rounded-xl p-3.5 flex items-start justify-between gap-3 shadow">
              <div className="space-y-0.5">
                <div className="flex items-center space-x-2">
                  <span className="px-2 py-0.5 rounded bg-rose-950 text-rose-300 border border-rose-800 text-[11px] font-bold font-japanese">
                    {activeQuestionMeta.mondaiTitleJa}
                  </span>
                  <span className="text-[11px] text-stone-400 font-mono">
                    Question {currentQuestionIndex + 1} of {currentSectionQuestions.length} (Overall #
                    {activeQuestionMeta.index})
                  </span>
                </div>
                <p className="text-xs text-stone-300 font-japanese pt-0.5">
                  {activeQuestionMeta.mondaiInstructionJa}
                </p>
              </div>

              {/* Flag for Review toggle */}
              <button
                onClick={handleToggleFlag}
                className={`px-3 py-1.5 rounded-xl border text-xs font-medium flex items-center space-x-1.5 transition cursor-pointer shrink-0 ${
                  answers[activeQuestionMeta.question.id]?.isFlagged
                    ? 'bg-amber-950 border-amber-600 text-amber-300 font-semibold'
                    : 'bg-stone-800/80 border-stone-700 text-stone-400 hover:text-stone-200'
                }`}
                title="Flag question for review later (Hotkey: F)"
              >
                <Flag className="w-3.5 h-3.5" />
                <span className="hidden sm:inline">
                  {answers[activeQuestionMeta.question.id]?.isFlagged ? 'Flagged (見直す)' : 'Flag (後で見直す)'}
                </span>
              </button>
            </div>

            {/* -------------------------------------------------------------------
                BRANCH 1: DOKKAI READING SPLIT-PANE (When question has dokkaiPassageId)
               ------------------------------------------------------------------- */}
            {activeQuestionMeta.dokkaiPassageId && passageMap.get(activeQuestionMeta.dokkaiPassageId) ? (
              (() => {
                const passage = passageMap.get(activeQuestionMeta.dokkaiPassageId)!;
                return (
                  <div className="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
                    {/* Left Pane: Authentic Reading Editorial Passage */}
                    <div className="lg:col-span-7 bg-stone-900 border border-stone-800 rounded-2xl p-5 sm:p-6 space-y-4 shadow-xl">
                      {/* Passage Controls Header */}
                      <div className="flex items-center justify-between pb-3 border-b border-stone-800">
                        <div className="flex items-center space-x-2">
                          <BookOpen className="w-4 h-4 text-rose-400" />
                          <h3 className="text-sm font-bold text-stone-100 font-japanese">
                            {passage.titleJa || passage.title}
                          </h3>
                        </div>

                        {/* Furigana & Claims highlighter toggles */}
                        <div className="flex items-center space-x-2 text-[11px]">
                          <button
                            onClick={() =>
                              setDokkaiFuriganaMode((m) =>
                                m === 'off' ? 'adaptive' : m === 'adaptive' ? 'full' : 'off'
                              )
                            }
                            className="px-2 py-1 rounded bg-stone-800 text-stone-300 hover:text-stone-100 border border-stone-700 font-mono transition cursor-pointer"
                          >
                            Furigana: {dokkaiFuriganaMode.toUpperCase()}
                          </button>
                          <button
                            onClick={() => setDokkaiHighlightClaims((h) => !h)}
                            className={`px-2 py-1 rounded border font-mono transition cursor-pointer ${
                              dokkaiHighlightClaims
                                ? 'bg-amber-950/80 border-amber-700 text-amber-300'
                                : 'bg-stone-800 border-stone-700 text-stone-400'
                            }`}
                          >
                            筆者の主張
                          </button>
                        </div>
                      </div>

                      {/* Passage Text Body */}
                      <div className="space-y-4 max-h-[500px] overflow-y-auto pr-2 text-stone-200 leading-relaxed font-japanese text-sm sm:text-base">
                        {passage.paragraphs.map((p, pIdx) => {
                          const hasClaim = dokkaiHighlightClaims && p.sentences.some((s) => s.isAuthorClaim);
                          return (
                            <p
                              key={pIdx}
                              className={`p-2.5 rounded-lg transition ${
                                hasClaim
                                  ? 'bg-amber-950/20 border-l-2 border-amber-500 pl-3 text-stone-100 font-medium'
                                  : 'bg-transparent'
                              }`}
                            >
                              <span className="text-stone-400 font-mono text-xs mr-2 select-none">
                                ¶{pIdx + 1}
                              </span>
                              <span>{p.rawText}</span>
                            </p>
                          );
                        })}
                      </div>

