              )}
            </AnimatePresence>

            {/* Progressive Hint Drawer */}
            <AnimatePresence>
              {showHint && !isEvaluated && (
                <motion.div
                  initial={{ opacity: 0, height: 0 }}
                  animate={{ opacity: 1, height: 'auto' }}
